# ─────────────────────────────────────────────────────────────────────────────
#  Marketixo — Apache / LiteSpeed configuration for Namecheap shared hosting.
#  Deployed with the rest of dist/ into public_html/.
# ─────────────────────────────────────────────────────────────────────────────

Options -Indexes -MultiViews
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (enable AutoSSL in cPanel first)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www → apex (one canonical host)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Block hidden files and anything that isn't meant to be public
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(md|ts|mjs|json\.bak|log|ini|sh|sql|lock)$ - [F,L,NC]
  RewriteRule (^|/)error_log$ - [F,L,NC]

  # English lives at the root. Returning visitors who chose another language in the
  # switcher (mx_lang cookie) are sent to that language's home page.
  RewriteRule ^$ - [E=MX_ROOT:1]
  RewriteCond %{HTTP_COOKIE} (?:^|;\s*)mx_lang=(de|it|sq)(?:;|$) [NC]
  RewriteRule ^$ /%1/ [R=302,L]

  # English used to live under /en/ — keep those links working.
  RewriteRule ^en/?$ / [L,R=301]
  RewriteRule ^en/(.+)$ /$1 [L,R=301]

  # Trailing slash for page URLs (/about → /about/)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]

  # ── Legacy URLs of the previous Marketixo site (EN at root, DE under /de/) → new URLs ──
  RewriteRule ^services/web-design/$ /services/web-design-development/ [L,R=301]
  RewriteRule ^services/branding/$ /services/branding-logo-design/ [L,R=301]
  RewriteRule ^services/social-media/$ /services/social-media-marketing/ [L,R=301]
  RewriteRule ^services/software-testing/$ /services/software-testing-qa/ [L,R=301]
  RewriteRule ^blog/$ /insights/ [L,R=301]
  RewriteRule ^blog/(.+)$ /insights/ [L,R=301]
  RewriteRule ^privacy/$ /privacy-policy/ [L,R=301]
  RewriteRule ^imprint/$ /legal-notice/ [L,R=301]
  RewriteRule ^de/leistungen/webdesign/$ /de/leistungen/webdesign-entwicklung/ [L,R=301]
  RewriteRule ^de/leistungen/branding/$ /de/leistungen/branding-logodesign/ [L,R=301]
  RewriteRule ^de/leistungen/suchmaschinenoptimierung/$ /de/leistungen/seo/ [L,R=301]
  RewriteRule ^de/leistungen/cybersecurity/$ /de/leistungen/cybersicherheit/ [L,R=301]
  RewriteRule ^de/leistungen/softwaretests/$ /de/leistungen/softwaretests-qa/ [L,R=301]
  RewriteRule ^de/blog/(.*)$ /de/insights/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  # The root redirect depends on the language cookie
  Header always merge Vary "Cookie" env=MX_ROOT

  # ── Security headers ──
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Baseline CSP. Every page also carries a stricter hash-based CSP <meta> generated by
  # Astro; browsers enforce both, so inline code only runs if its hash is listed.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://www.facebook.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://www.facebook.com https://connect.facebook.net; font-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # ── Caching ──
  # Astro's JS/CSS are fingerprinted (/_astro/name.HASH.js) → cache for a year
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico|gif|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # HTML / feeds revalidate so updates show immediately
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/rss+xml application/javascript text/javascript application/json image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>

# Only the contact handler may run PHP
<FilesMatch "\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
<Files "contact.php">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</Files>
