---
import ServicePage from '~/views/ServicePage.astro';
import { services } from '~/data/services';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.copy.en.slug }, props: { service } }));
}
const { service } = Astro.props;
---

<ServicePage lang="en" service={service} />
