---
/**
 * Internal page for comparing portfolio layouts. Not linked, not in the sitemap, and noindex.
 * Pick one by setting `workLayout` in src/data/work.ts.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import WorkGallery from '~/components/WorkGallery.astro';
import { workLayout, type WorkLayout } from '~/data/work';
import { withBase } from '~/lib/paths';

const layouts: { key: WorkLayout; name: string; text: string }[] = [
  { key: 'tiles', name: 'Tiles', text: 'A colourful bento grid. Every client gets a tile in their brand colour. Bold, and looks finished even without screenshots.' },
  { key: 'showcase', name: 'Showcase', text: 'One large row per project, alternating left and right, with the services listed. Reads like a set of case studies.' },
  { key: 'index', name: 'Index', text: 'An editorial list with big client names. Each row fills with the brand colour on hover. Minimal and confident.' },
  { key: 'cards', name: 'Cards (previous)', text: 'Browser-framed website screenshots. Needs real screenshots in public/work/ to look right.' },
];
---

<BaseLayout
  lang="en"
  title="Portfolio layouts"
  description="Compare the layouts for showing Marketixo's work."
  alternates={{ en: withBase('/work-layouts/') }}
  noindex
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Internal preview</span>
      <h1>Portfolio layouts</h1>
      <p class="lead">
        Four ways to show your work. To switch, set <code>workLayout</code> in <code>src/data/work.ts</code>. The Home page
        (first three projects) and the Work page both follow it.
      </p>
      <nav class="picker" aria-label="Layouts">
        {
          layouts.map((l) => (
            <a href={`#${l.key}`}>
              {l.name}
              {l.key === workLayout && <span>live</span>}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  {
    layouts.map((l, i) => (
      <section id={l.key} class:list={['section', { 'section--white': i % 2 === 0 }]}>
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">
              {String.fromCharCode(65 + i)} · {l.name}
              {l.key === workLayout && ' · live now'}
            </span>
            <p class="lead">{l.text}</p>
            <p class="setting">
              <code>workLayout = '{l.key}'</code>
            </p>
          </div>
          <WorkGallery lang="en" layout={l.key} />
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .picker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  .picker a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    font-family: var(--font-display);
    font-weight: 500;
    text-decoration: none;
  }
  .picker a:hover {
    border-color: var(--ink);
  }
  .picker span {
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--signal);
    color: var(--white);
    font-size: 0.75rem;
  }
  .setting {
    margin: 0;
  }
  code {
    padding: 0.15em 0.4em;
    border-radius: 6px;
    background: var(--signal-tint);
    font-size: 0.9em;
  }
</style>
