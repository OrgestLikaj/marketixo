---
/**
 * The previous home page design, kept for comparison at /home-classic/ (noindex, not linked).
 * The live home page is src/views/HomePage.astro.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import ServiceExplorer from '~/components/ServiceExplorer.astro';
import Faq from '~/components/Faq.astro';
import CtaBand from '~/components/CtaBand.astro';
import LogoGrid from '~/components/LogoGrid.astro';
import { whatsappLink } from '~/config/site';
import { t, url, type Lang } from '~/i18n/ui';
import { services } from '~/data/services';
import { testimonials } from '~/data/work';
import { withBase } from '~/lib/paths';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
// Only rendered at /home-classic/, so it points at itself and stays out of search results.
const alternates = { en: withBase('/home-classic/') };
const s = t(lang);

const copy = {
  en: {
    title: 'Marketixo — Web Design, SEO & Digital Marketing Agency',
    description:
      'Marketixo builds websites, brands and marketing that bring you clients — plus cybersecurity and software testing to keep it all running. Free quote in 24h.',
    eyebrow: 'Digital agency · English & Deutsch',
    h1: ['We build, ', 'grow', ' and protect your business online.'],
    lead: 'Websites, SEO, ads, branding and social media — plus security and testing that keep everything running. One team, one plan, one point of contact.',
    trust: ['Free consultation', 'Fixed-price quotes', 'Reply within 1 business day'],
    heroCards: {
      build: { label: 'Build', title: 'New website live', meta: 'Mobile score 98' },
      grow: { label: 'Grow', title: 'Organic traffic', meta: 'Last 6 months' },
      protect: { label: 'Protect', title: 'Security check passed', meta: 'SSL · Backups · Updates' },
    },
    servicesEyebrow: 'Services',
    servicesTitle: 'Everything your business needs online, under one roof.',
    servicesText:
      'Most businesses juggle a web designer, a marketing freelancer and an IT person. We bring it together, so your website, marketing and security work as one.',
    whyEyebrow: 'Why Marketixo',
    whyTitle: 'An agency that thinks in results, not deliverables.',
    why: [
      { icon: 'users', title: 'One team for everything', text: 'Design, marketing and tech under one roof. No finger-pointing between agencies, one person who knows your project.' },
      { icon: 'tag', title: 'Clear, fixed quotes', text: 'You know what you pay before we start. No hourly surprises, no hidden extras.' },
      { icon: 'bolt', title: 'Fast & built to rank', text: 'Every website is fast, mobile-first and SEO-ready from day one, because a site nobody finds is wasted money.' },
      { icon: 'shield', title: 'Security built in', text: 'With in-house cybersecurity and QA, what we build is tested and protected, not just pretty.' },
    ],
    processEyebrow: 'How we work',
    processTitle: 'From first call to measurable results in four steps.',
    process: [
      { title: 'Free intro call', text: '20 minutes to understand your business, goals and budget.' },
      { title: 'Plan & fixed quote', text: 'A clear proposal with scope, timeline and price, usually within 48 hours.' },
      { title: 'Build & launch', text: 'We design, build and test, with check-ins at every milestone.' },
      { title: 'Measure & improve', text: 'We track what matters and keep improving after launch.' },
    ],
    workEyebrow: 'Recent work',
    workTitle: 'Brands we’ve worked with',
    clientsHint: 'Hover over a logo to see what we did.',
    testimonialsTitle: 'What clients say',
    faq: [
      { q: 'How much does a website or marketing project cost?', a: 'Every business is different, so we give you a fixed price after a short call. Small business websites typically start in the low four figures; ongoing marketing is a monthly package. You always know the price before we start.' },
      { q: 'Do you work with clients in Germany, Austria and Switzerland?', a: 'Yes. We work remotely with clients across Europe, in English and German, and we optimise for each market separately.' },
      { q: 'Can I hire you for just one service?', a: 'Absolutely. Many clients start with one thing, like a new website or an SEO audit, and add more later.' },
      { q: 'How quickly do you respond?', a: 'Within one business day. On WhatsApp usually much faster.' },
    ],
  },
  de: {
    title: 'Marketixo — Agentur für Webdesign, SEO & Online-Marketing',
    description:
      'Marketixo entwickelt Websites, Marken und Marketing, die Kunden bringen — plus Cybersecurity und Softwaretests, damit alles läuft. Angebot innerhalb von 24 h.',
    eyebrow: 'Digitalagentur · Deutsch & English',
    h1: ['Wir bauen Ihr Business online auf, lassen es ', 'wachsen', ' und schützen es.'],
    lead: 'Websites, SEO, Werbung, Branding und Social Media — plus Sicherheit und Tests, damit alles zuverlässig läuft. Ein Team, ein Plan, ein Ansprechpartner.',
    trust: ['Kostenlose Erstberatung', 'Festpreisangebote', 'Antwort innerhalb eines Werktags'],
    heroCards: {
      build: { label: 'Aufbauen', title: 'Website ist live', meta: 'Mobile-Score 98' },
      grow: { label: 'Wachsen', title: 'Organischer Traffic', meta: 'Letzte 6 Monate' },
      protect: { label: 'Schützen', title: 'Sicherheitscheck bestanden', meta: 'SSL · Backups · Updates' },
    },
    servicesEyebrow: 'Leistungen',
    servicesTitle: 'Alles, was Ihr Unternehmen online braucht — aus einer Hand.',
    servicesText:
      'Die meisten Unternehmen jonglieren mit Webdesigner, Marketing-Freelancer und IT-Dienstleister. Wir bringen alles zusammen, damit Website, Marketing und Sicherheit als Einheit funktionieren.',
    whyEyebrow: 'Warum Marketixo',
    whyTitle: 'Eine Agentur, die in Ergebnissen denkt — nicht in Leistungspaketen.',
    why: [
      { icon: 'users', title: 'Ein Team für alles', text: 'Design, Marketing und Technik aus einer Hand. Kein Hin und Her zwischen Agenturen, ein Ansprechpartner, der Ihr Projekt kennt.' },
      { icon: 'tag', title: 'Klare Festpreise', text: 'Sie wissen vorher, was Sie zahlen. Keine Stundenüberraschungen, keine versteckten Kosten.' },
      { icon: 'bolt', title: 'Schnell & rankingstark', text: 'Jede Website ist schnell, mobiloptimiert und ab Tag eins SEO-fertig. Denn eine Website, die niemand findet, ist verschenktes Geld.' },
      { icon: 'shield', title: 'Sicherheit inklusive', text: 'Mit eigener Cybersecurity und Qualitätssicherung ist alles, was wir bauen, getestet und geschützt — nicht nur schön.' },
    ],
    processEyebrow: 'So arbeiten wir',
    processTitle: 'Vom ersten Gespräch zu messbaren Ergebnissen in vier Schritten.',
    process: [
      { title: 'Kostenloses Erstgespräch', text: '20 Minuten, um Ihr Unternehmen, Ihre Ziele und Ihr Budget zu verstehen.' },
      { title: 'Plan & Festpreis', text: 'Ein klares Angebot mit Umfang, Zeitplan und Preis — meist innerhalb von 48 Stunden.' },
      { title: 'Umsetzung & Launch', text: 'Wir gestalten, entwickeln und testen — mit Abstimmung bei jedem Meilenstein.' },
      { title: 'Messen & verbessern', text: 'Wir messen, was zählt, und optimieren auch nach dem Launch weiter.' },
    ],
    workEyebrow: 'Aktuelle Projekte',
    workTitle: 'Marken, mit denen wir arbeiten',
    clientsHint: 'Fahren Sie über ein Logo, um zu sehen, was wir gemacht haben.',
    testimonialsTitle: 'Das sagen unsere Kunden',
    faq: [
      { q: 'Was kostet eine Website oder ein Marketingprojekt?', a: 'Jedes Unternehmen ist anders, deshalb erhalten Sie nach einem kurzen Gespräch einen Festpreis. Websites für kleine Unternehmen beginnen meist im niedrigen vierstelligen Bereich; laufendes Marketing ist ein Monatspaket. Den Preis kennen Sie immer, bevor wir starten.' },
      { q: 'Arbeiten Sie mit Kunden in Deutschland, Österreich und der Schweiz?', a: 'Ja. Wir arbeiten remote mit Kunden in ganz Europa, auf Deutsch und Englisch, und optimieren für jeden Markt separat.' },
      { q: 'Kann ich auch nur eine Leistung buchen?', a: 'Selbstverständlich. Viele Kunden starten mit einem Projekt, etwa einer neuen Website oder einem SEO-Audit, und erweitern später.' },
      { q: 'Wie schnell antworten Sie?', a: 'Innerhalb eines Werktags. Per WhatsApp meist deutlich schneller.' },
    ],
  },
}[lang];

const marquee = services.map((svc) => svc.copy[lang].title.split(' (')[0]);
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  alternates={alternates}
  appendSiteName={false}
  noindex
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1>
          {copy.h1[0]}<span class="hero__hl">{copy.h1[1]}</span>{copy.h1[2]}
        </h1>
        <p class="lead">{copy.lead}</p>
        <div class="btn-row">
          <a href={url('contact', lang) + '#quote'} class="btn btn--signal">
            {s.cta.quote}
            <Icon name="arrow" class="arrow" />
          </a>
          <a href={whatsappLink(s.whatsappText)} class="btn btn--ghost" target="_blank" rel="noopener">
            <Icon name="whatsapp" />
            {s.cta.whatsapp}
          </a>
        </div>
        <ul class="hero__trust">
          {copy.trust.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="hero__visual" aria-hidden="true">
        <div class="hcard hcard--build">
          <span class="hcard__label">{copy.heroCards.build.label}</span>
          <div class="hcard__browser">
            <div class="hcard__dots"><i></i><i></i><i></i></div>
            <div class="hcard__page">
              <span class="w75 dark"></span>
              <span class="w90"></span>
              <span class="w60"></span>
              <span class="pill"></span>
            </div>
          </div>
          <div class="hcard__foot">
            <strong>{copy.heroCards.build.title}</strong>
            <span class="hcard__score">98</span>
          </div>
        </div>

        <div class="hcard hcard--grow">
          <span class="hcard__label">{copy.heroCards.grow.label}</span>
          <strong>{copy.heroCards.grow.title}</strong>
          <small>{copy.heroCards.grow.meta}</small>
          <svg viewBox="0 0 240 90" class="hcard__chart" preserveAspectRatio="none">
            <defs>
              <linearGradient id="g" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#0E9F6E" stop-opacity="0.28"></stop>
                <stop offset="1" stop-color="#0E9F6E" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
            <path d="M0 80 C30 76 45 70 70 66 S110 60 130 48 S170 36 190 24 S225 10 240 6 V90 H0Z" fill="url(#g)"></path>
            <path d="M0 80 C30 76 45 70 70 66 S110 60 130 48 S170 36 190 24 S225 10 240 6" fill="none" stroke="#0E9F6E" stroke-width="3" stroke-linecap="round"></path>
          </svg>
        </div>

        <div class="hcard hcard--protect">
          <span class="hcard__shield"><Icon name="shield" size={22} /></span>
          <div>
            <span class="hcard__label">{copy.heroCards.protect.label}</span>
            <strong>{copy.heroCards.protect.title}</strong>
            <small>{copy.heroCards.protect.meta}</small>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {
        [0, 1].map(() => (
          <ul>
            {marquee.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <!-- Services -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <span class="eyebrow">{copy.servicesEyebrow}</span>
          <h2 style="margin-top:1rem">{copy.servicesTitle}</h2>
        </div>
        <p class="lead">{copy.servicesText}</p>
      </div>

      <ServiceExplorer lang={lang} />
    </div>
  </section>

  <!-- Why -->
  <section class="section section--ink">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{copy.whyEyebrow}</span>
        <h2>{copy.whyTitle}</h2>
      </div>
      <div class="grid grid--4 why">
        {
          copy.why.map((item, i) => (
            <div class="why__item reveal" style={`transition-delay:${i * 80}ms`}>
              <span class="why__num">0{i + 1}</span>
              <Icon name={item.icon} size={28} class="why__icon" />
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{copy.processEyebrow}</span>
        <h2>{copy.processTitle}</h2>
      </div>
      <ol class="process">
        {
          copy.process.map((step, i) => (
            <li class="process__step reveal" style={`transition-delay:${i * 80}ms`}>
              <span class="process__num">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Work -->
  <section class="section section--white">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <span class="eyebrow">{copy.workEyebrow}</span>
          <h2 style="margin-top:1rem">{copy.workTitle}</h2>
        </div>
        <div class="work-aside">
          <p class="work-hint">{copy.clientsHint}</p>
          <a href={url('work', lang)} class="link-arrow">{s.cta.allWork} <Icon name="arrow" /></a>
        </div>
      </div>
      <LogoGrid lang={lang} withCta />
    </div>
  </section>

  {
    testimonials.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <h2>{copy.testimonialsTitle}</h2>
          </div>
          <div class="grid grid--3">
            {testimonials.map((item) => (
              <figure class="card quote-card reveal">
                <blockquote>“{item.quote[lang]}”</blockquote>
                <figcaption>
                  <strong>{item.name}</strong>
                  <span>{item.role}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <Faq title={s.faqTitle} items={copy.faq} />
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 7vw, 96px) clamp(56px, 8vw, 112px);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, rgb(13 15 20 / 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(13 15 20 / 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 80% 70% at 70% 30%, #000 30%, transparent 75%);
  }
  .hero__grid {
    display: grid;
    gap: clamp(48px, 6vw, 72px);
    align-items: center;
  }
  @media (min-width: 1000px) {
    .hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }
  .hero h1 {
    margin: 1.25rem 0 1.5rem;
    max-width: 14ch;
  }
  :global(html[lang='de']) .hero h1 {
    max-width: 17ch;
    font-size: clamp(2.3rem, 5.6vw, 4.4rem);
  }
  .hero__hl {
    position: relative;
    white-space: nowrap;
    color: var(--signal);
  }
  .hero__hl::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.02em;
    height: 0.14em;
    border-radius: 99px;
    background: currentColor;
    opacity: 0.22;
  }
  .hero .lead {
    max-width: 560px;
    margin-bottom: 2rem;
  }
  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hero__trust li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--grow);
  }

  /* Hero visual: three stacked cards for Build / Grow / Protect */
  .hero__visual {
    position: relative;
    height: 520px;
    max-width: 500px;
    width: 100%;
    margin-inline: auto;
  }
  .hcard {
    position: absolute;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--white);
    box-shadow: var(--shadow-lg);
    animation: float 7s ease-in-out infinite;
  }
  .hcard strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .hcard small {
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .hcard__label {
    display: inline-block;
    margin-bottom: 0.6rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: color-mix(in srgb, var(--accent) 12%, white);
    color: var(--accent);
  }
  .hcard--build {
    --accent: var(--build);
    top: 0;
    left: 0;
    width: 74%;
  }
  .hcard__browser {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper);
  }
  .hcard__dots {
    display: flex;
    gap: 5px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--line);
    background: var(--white);
  }
  .hcard__dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line);
  }
  .hcard__page {
    display: grid;
    gap: 8px;
    padding: 18px 16px 22px;
  }
  .hcard__page span {
    height: 8px;
    border-radius: 6px;
    background: #e4e0d6;
  }
  .hcard__page .dark {
    height: 14px;
    background: var(--ink);
  }
  .hcard__page .w75 {
    width: 75%;
  }
  .hcard__page .w90 {
    width: 90%;
  }
  .hcard__page .w60 {
    width: 60%;
  }
  .hcard__page .pill {
    width: 34%;
    height: 18px;
    margin-top: 4px;
    border-radius: 99px;
    background: var(--signal);
  }
  .hcard__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
  }
  .hcard__score {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 3px solid var(--grow);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--grow);
  }
  .hcard--grow {
    --accent: var(--grow);
    top: 150px;
    right: 0;
    width: 60%;
    z-index: 1;
    animation-delay: -2.4s;
  }
  .hcard__chart {
    width: 100%;
    height: 80px;
    margin-top: 12px;
  }
  .hcard--protect {
    --accent: var(--protect);
    bottom: 0;
    left: 0;
    z-index: 2;
    display: flex;
    gap: 14px;
    align-items: center;
    width: 64%;
    animation-delay: -4.6s;
  }
  .hcard--protect .hcard__label {
    margin-bottom: 0.35rem;
  }
  .hcard__shield {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--protect);
    color: var(--white);
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  @media (max-width: 480px) {
    .hero__visual {
      height: 470px;
    }
    .hcard--build {
      width: 86%;
    }
    .hcard--grow {
      width: 70%;
      top: 165px;
    }
    .hcard--protect {
      width: 88%;
    }
  }

  /* Recent work: hint + link beside the heading */
  .work-aside {
    display: grid;
    justify-items: end;
    gap: 0.5rem;
  }
  .work-hint {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  @media (max-width: 700px) {
    .work-aside {
      justify-items: start;
    }
  }
  @media (hover: none) {
    .work-hint {
      display: none;
    }
  }

  /* Marquee */
  .marquee {
    overflow: hidden;
    padding-block: 22px;
    background: var(--ink);
    color: var(--on-ink);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }
  .marquee ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .marquee li {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-right: 2rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .marquee li::after {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--signal);
    rotate: 45deg;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* Why */
  .why__item {
    position: relative;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-ink);
  }
  .why__num {
    position: absolute;
    top: 1.5rem;
    right: 0;
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--on-ink-muted);
  }
  .why__item :global(.why__icon) {
    color: var(--signal);
    margin-bottom: 1.5rem;
  }
  .why__item h3 {
    font-size: 1.3rem;
    color: var(--white);
  }
  .why__item p {
    margin: 0;
    color: var(--on-ink-muted);
    font-size: 0.975rem;
  }

  /* Process */
  .process {
    display: grid;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
  }
  @media (min-width: 720px) {
    .process {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .process {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .process__step {
    padding: 28px;
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid var(--line);
  }
  .process__num {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 2.5rem;
    border-radius: 50%;
    background: var(--ink);
