---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import { whatsappLink } from '~/config/site';
import { alternatesFor, t, url, type Lang } from '~/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const copy = {
  en: {
    title: 'Thank you',
    h1: 'Thanks — your request is on its way.',
    lead: 'We’ll get back to you within one business day. In a hurry? Message us on WhatsApp and mention your name.',
    back: 'Back to home',
    read: 'While you wait',
  },
  de: {
    title: 'Vielen Dank',
    h1: 'Danke — Ihre Anfrage ist bei uns angekommen.',
    lead: 'Wir melden uns innerhalb eines Werktags. Es eilt? Schreiben Sie uns per WhatsApp und nennen Sie Ihren Namen.',
    back: 'Zur Startseite',
    read: 'Während Sie warten',
  },
}[lang];
---

<BaseLayout lang={lang} title={copy.title} description={copy.lead} alternates={alternatesFor('thanks')} noindex>
  <section class="section thanks">
    <div class="container">
      <span class="thanks__icon"><Icon name="check" size={32} /></span>
      <h1>{copy.h1}</h1>
      <p class="lead">{copy.lead}</p>
      <div class="btn-row" style="justify-content:center;margin-top:2rem">
        <a href={whatsappLink(s.whatsappText)} class="btn btn--signal" target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          {s.cta.whatsapp}
        </a>
        <a href={url('home', lang)} class="btn btn--ghost">{copy.back}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks {
    text-align: center;
    min-height: 60vh;
    display: grid;
    align-items: center;
  }
  .thanks h1 {
    max-width: 18ch;
    margin: 1.5rem auto 1rem;
    font-size: clamp(2.2rem, 5vw, 3.75rem);
  }
  .thanks .lead {
    max-width: 560px;
    margin-inline: auto;
  }
  .thanks__icon {
    display: inline-grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--signal);
    color: var(--white);
  }
</style>
