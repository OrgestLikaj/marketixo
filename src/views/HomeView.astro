---
/**
 * Home — v3 layout: white hero with a product-style preview, a navy band with the
 * client strip and the service "platform" tabs, an oat band of case studies, navy
 * facts, a white spotlight row and a navy CTA + FAQ close.
 * Every number on this page is counted from real data (services, languages, offices,
 * projects) — nothing is invented.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/Button.astro';
import Icon from '~/components/Icon.astro';
import Faq from '~/components/Faq.astro';
import ServiceVisual from '~/components/ServiceVisual.astro';
import { formatDate, locales, useT } from '~/i18n';
import { url } from '~/i18n/routes';
import { serviceKeys, serviceMeta } from '~/data/services';
import { clientLogos, featuredProjects, projectByKey, projects } from '~/data/projects';
import { workImages } from '~/lib/work-images';
import { insightSlug, publishedInsights, type PageEntry } from '~/lib/pages';
import { site } from '~/config/site';

interface Props {
  page: PageEntry;
}
const { page } = Astro.props;
const lang = page.lang;
const t = useT(lang);
const h = t.home;
const v = h.v3;

const services = await getCollection('services', (e) => e.data.lang === lang);
const byKey = Object.fromEntries(services.map((s) => [s.data.key, s.data]));
const work = await getCollection('work', (e) => e.data.lang === lang);
const workByKey = Object.fromEntries(work.map((w) => [w.data.key, w.data]));

// ── Logos (equal visual weight: same area for every mark) ──
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/clients/*.{webp,png,svg}', { eager: true });
const logoFor = (key: string) => Object.entries(files).find(([p]) => p.split('/').pop()!.replace(/\.\w+$/, '') === key)?.[1].default;
const sized = (img: ImageMetadata, area: number, maxW: number, maxH: number) => {
  const ratio = img.width / img.height;
  let w = Math.sqrt(area * ratio);
  if (w > maxW) w = maxW;
  if (w / ratio > maxH) w = maxH * ratio;
  return Math.round(w);
};
const strip = clientLogos.map((c) => ({ ...c, img: logoFor(c.key) })).filter((c) => c.img);

// ── Hero preview: real screenshots of live client work ──
const heroMain = projectByKey('medicus-center')!;
const heroMainImg = workImages(heroMain.key);
const heroSide = projectByKey('ir-real-estate')!;
const heroSideImg = workImages(heroSide.key);

// ── Case studies (featured projects) ──
const cases = featuredProjects.slice(0, 4).map((p) => {
  const logo = clientLogos.find((c) => c.project === p.key);
  const langs = p.siteLanguages?.length ?? 0;
  return {
    project: p,
    copy: workByKey[p.key],
    img: workImages(p.key),
    logo: logo ? logoFor(logo.key) : undefined,
    stat: langs > 1 ? { value: String(langs), label: v.statLanguages } : { value: String(p.services.length), label: v.statServices },
  };
});

// ── Facts: counted, not claimed ──
const facts = [
  { value: String(serviceKeys.length), label: v.facts.disciplines },
  { value: String(locales.length), label: v.facts.languages },
  { value: String(site.offices.length), label: v.facts.locations },
  { value: String(projects.length), label: v.facts.caseStudies },
];
const techItems = t.tech.flatMap((a) => a.items).slice(0, 12);
const featuredIcons = ['layers', 'web', 'spark'];

// ── Spotlight: latest articles + case studies ──
const posts = (await publishedInsights(lang)).slice(0, 2);
const spotProjects = featuredProjects.filter((p) => p.key !== cases[0]?.project.key).slice(0, 4 - posts.length);
const faqs = t.faqPage.items.slice(0, 6);

const heroLines = h.hero.lines;
---

<BaseLayout page={page} title={h.metaTitle} description={t.meta.defaultDescription}>
  <!-- ───────────── Hero ───────────── -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container container--wide hero__grid">
      <div class="hero__copy">
        <p class="eyebrow" data-reveal>{h.hero.eyebrow}</p>
        <h1 id="hero-title" class="display hero__title" data-reveal style="--reveal-delay:1">
          <span class="hero__accent">{heroLines[0]}</span>
          {' ' + heroLines.slice(1).join(' ')}
        </h1>
        <p class="lead hero__lead" data-reveal style="--reveal-delay:2">{h.hero.lead}</p>
        <div class="hero__actions" data-reveal style="--reveal-delay:3">
          <Button href={url.section(lang, 'contact')} size="lg" arrow={false}>{t.common.startProject}</Button>
          <Button href={url.section(lang, 'work')} variant="secondary" size="lg" arrow={false}>{t.common.viewWork}</Button>
        </div>
      </div>

      <div class="hero__ui" role="group" aria-label={h.hero.previewLabel}>
        <div class="blueprint hero__dots" aria-hidden="true"></div>
        <div class="ui" data-reveal style="--reveal-delay:2">
          <div class="ui__bar" aria-hidden="true">
            <span class="ui__brand"><i></i>marketixo</span>
            <span class="ui__sep"></span>
            <span class="ui__crumb">{h.hero.previewLabel}</span>
          </div>
          <div class="ui__body">
            <ul class="ui__nav" role="list" aria-hidden="true">
              {
                h.hero.pillars.map((p, i) => (
                  <li class:list={{ 'is-on': i === 0 }}>
                    <Icon name="check" size={14} />
                    {p}
                  </li>
                ))
              }
            </ul>
            <div class="ui__main">
              {
                heroMainImg.desktop && (
                  <a href={url.project(lang, heroMain.key)} class="ui__shot">
                    <Image
                      src={heroMainImg.desktop}
                      alt={heroMain.client}
                      widths={[480, 720, 960]}
                      sizes="(min-width: 1100px) 38vw, 90vw"
                      loading="eager"
                      fetchpriority="high"
                      layout="none"
                    />
                    <span class="ui__label mono">{heroMain.client}</span>
                  </a>
                )
              }
              <div class="ui__row">
                {
                  heroSideImg.desktop && (
                    <a href={url.project(lang, heroSide.key)} class="ui__shot ui__shot--sm">
                      <Image src={heroSideImg.desktop} alt={heroSide.client} widths={[320, 480]} sizes="18vw" layout="none" />
                      <span class="ui__label mono">{heroSide.client}</span>
                    </a>
                  )
                }
                <div class="ui__status" aria-hidden="true">
                  <p class="ui__status-head">
                    <span class="ui__dot"></span>
                    {h.hero.status}
                  </p>
                  <p class="ui__status-num mono">{h.hero.pillars.length}/{h.hero.pillars.length}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────── Navy band: clients + platform ───────────── -->
  <div class="on-dark band">
    <section class="strip" aria-label={h.clients.eyebrow} data-strip>
      <p class="strip__label mono">{v.trusted}</p>
      <div class="strip__viewport">
        <ul class="strip__track" role="list">
          {
            [0, 1].map((copy) =>
              strip.map((c) => (
                <li aria-hidden={copy === 1 ? 'true' : undefined}>
                  <Image
                    src={c.img!}
                    alt={copy === 1 ? '' : c.client}
                    widths={[120, 240]}
                    sizes="120px"
                    layout="none"
                    class="strip__logo"
                    style={`--w:${sized(c.img!, 2400, 132, 40)}px`}
                  />
                </li>
              )),
            )
          }
        </ul>
      </div>
      <button type="button" class="strip__toggle" data-strip-toggle aria-pressed="false" data-label-pause={v.pause} data-label-play={v.play}>
        <span class="strip__icon" aria-hidden="true"></span>
        <span class="sr-only" data-strip-label>{v.pause}</span>
      </button>
    </section>

    <section class="section platform" aria-labelledby="services-title">
      <div class="container">
        <div class="center-head">
          <p class="eyebrow" data-reveal>{h.services.eyebrow}</p>
          <h2 id="services-title" class="h2" data-reveal style="--reveal-delay:1">{h.services.heading}</h2>
        </div>

        <div class="tabs" data-tabs>
          <div class="tabs__list" role="tablist" aria-label={h.services.eyebrow} data-reveal style="--reveal-delay:2">
            {
              serviceKeys.map((key, i) => (
                <button
                  type="button"
                  role="tab"
                  class="pill"
                  id={`svc-tab-${key}`}
                  aria-controls={`svc-panel-${key}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                >
                  {byKey[key]?.shortTitle ?? key}
                </button>
              ))
            }
          </div>
          {
            serviceKeys.map((key, i) => (
              <div class="panel" role="tabpanel" id={`svc-panel-${key}`} aria-labelledby={`svc-tab-${key}`} data-panel hidden={i !== 0}>
                <div class="panel__copy">
                  <span class="panel__icon">
                    <Icon name={serviceMeta[key].icon} size={30} />
                  </span>
                  <h3 class="panel__title">{byKey[key]?.title}</h3>
                  <p class="panel__text">{byKey[key]?.hero.lead}</p>
                  <div class="panel__cta">
                    <Button href={url.service(lang, key)} arrow={false}>
                      {t.common.learnMore}
                      <span class="sr-only">: {byKey[key]?.title}</span>
                    </Button>
                  </div>
                </div>
                <div class="panel__visual on-dark" aria-hidden="true">
                  <ServiceVisual service={key} />
                </div>
              </div>
            ))
          }
        </div>

        <div class="featured">
          <p class="eyebrow eyebrow--plain" data-reveal>{h.why.eyebrow}</p>
          <ul class="featured__grid" role="list">
            {
              h.why.points.map((p, i) => (
                <li class="fcard" data-reveal style={`--reveal-delay:${i}`}>
                  <span class="fcard__icon">
                    <Icon name={featuredIcons[i] ?? 'check'} size={22} />
                  </span>
                  <h3 class="fcard__title">{p.title}</h3>
                  <p class="fcard__text">{p.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  </div>

  <!-- ───────────── Proven impact (oat) ───────────── -->
  <section class="section on-surface impact" aria-labelledby="work-title">
    <div class="container">
      <div class="center-head">
        <p class="eyebrow" data-reveal>{h.work.eyebrow}</p>
        <h2 id="work-title" class="h2" data-reveal style="--reveal-delay:1">{h.work.heading}</h2>
      </div>

      <div class="tabs" data-tabs>
        <div class="logo-tabs" role="tablist" aria-label={h.work.eyebrow} data-reveal style="--reveal-delay:2">
          {
            cases.map((c, i) => (
              <button
                type="button"
                role="tab"
                class="logo-tab"
                id={`case-tab-${c.project.key}`}
                aria-controls={`case-panel-${c.project.key}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {c.logo ? (
                  <Image
                    src={c.logo}
                    alt={c.project.client}
                    widths={[160, 320]}
                    sizes="160px"
                    layout="none"
                    class="logo-tab__img"
                    style={`--w:${sized(c.logo, 3000, 150, 48)}px`}
                  />
                ) : (
                  <span class="logo-tab__name">{c.project.client}</span>
                )}
              </button>
            ))
          }
        </div>
        {
          cases.map((c, i) => (
            <article class="case" role="tabpanel" id={`case-panel-${c.project.key}`} aria-labelledby={`case-tab-${c.project.key}`} data-panel hidden={i !== 0}>
              <div class="case__copy">
                <p class="case__client">{c.project.client}</p>
                <div class="case__stat">
                  <span class="case__num mono">{c.stat.value}</span>
                  <span class="case__label">{c.stat.label}</span>
                </div>
                <h3 class="case__title">{c.copy?.summary}</h3>
                <p class="case__meta">
                  {c.copy?.industry}
                  {c.copy?.location && <span> · {c.copy.location}</span>}
                </p>
                <a href={url.project(lang, c.project.key)} class="case__link">
                  {v.fullStory}
                  <span class="sr-only">: {c.project.client}</span>
                  <Icon name="arrow-right" size={16} />
                </a>
              </div>
              <div class="case__media">
                {c.img.desktop && (
                  <Image src={c.img.desktop} alt="" widths={[560, 840, 1120]} sizes="(min-width: 900px) 46vw, 92vw" layout="none" class="case__img" />
                )}
              </div>
            </article>
          ))
        }
      </div>

      <p class="impact__more" data-reveal>
        <a href={url.section(lang, 'work')}>{t.common.viewAllWork} <Icon name="arrow-right" size={16} /></a>
      </p>
    </div>
  </section>

  <!-- ───────────── Facts (navy) ───────────── -->
  <section class="section on-dark facts" aria-labelledby="why-title">
    <div class="container facts__grid">
      <div class="facts__head">
        <p class="eyebrow" data-reveal>{h.why.eyebrow}</p>
        <h2 id="why-title" class="h2" data-reveal style="--reveal-delay:1">{h.why.heading}</h2>
        <dl class="facts__list">
          {
            facts.map((f, i) => (
              <div data-reveal style={`--reveal-delay:${i + 2}`}>
                <dt class="facts__num">{f.value}</dt>
                <dd>{f.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="facts__cards">
        <article class="xcard xcard--teal" data-reveal style="--reveal-delay:2">
          <p class="eyebrow eyebrow--plain">{h.process.eyebrow}</p>
          <h3 class="xcard__title">{h.process.heading}</h3>
          <p class="xcard__text">{h.process.lead}</p>
          <ol class="xcard__steps" role="list">
            {
              h.process.steps.map((s, i) => (
                <li>
                  <span class="mono">0{i + 1}</span> {s.title}
                </li>
              ))
            }
          </ol>
          <a href={url.section(lang, 'about')} class="xcard__link">{t.common.learnMore} <Icon name="arrow-right" size={16} /></a>
        </article>
        <article class="xcard" data-reveal style="--reveal-delay:3">
          <p class="eyebrow eyebrow--plain">{h.tech.eyebrow}</p>
          <h3 class="xcard__title">{h.tech.heading}</h3>
          <ul class="xcard__chips" role="list">
            {techItems.map((item) => <li>{item}</li>)}
          </ul>
          <a href={url.section(lang, 'services')} class="xcard__link">{t.common.exploreServices} <Icon name="arrow-right" size={16} /></a>
        </article>
      </div>
    </div>
  </section>

  <!-- ───────────── Spotlight (white) ───────────── -->
  <section class="section spot" aria-labelledby="spot-title">
    <div class="container">
      <h2 id="spot-title" class="h2 spot__title" data-reveal>{v.spotlight}</h2>
      <ul class="spot__grid" role="list">
        {
          posts.map((post, i) => (
            <li class="scard" data-reveal style={`--reveal-delay:${i}`}>
              <a href={url.insight(lang, insightSlug(post))} class="scard__link">
                <span class="scard__media scard__media--post on-dark" aria-hidden="true">
                  <span class="blueprint" />
                  <span class="scard__topic">{t.insights.categories[post.data.categories[0]]}</span>
                </span>
                <span class="scard__kicker mono">
                  {t.nav.insights} · {formatDate(post.data.pubDate, lang)}
                </span>
                <span class="scard__title">{post.data.title}</span>
                <span class="scard__more">
                  {t.common.readMore} <Icon name="arrow-right" size={14} />
                </span>
              </a>
            </li>
          ))
        }
        {
          spotProjects.map((p, i) => {
            const img = workImages(p.key);
            return (
              <li class="scard" data-reveal style={`--reveal-delay:${posts.length + i}`}>
                <a href={url.project(lang, p.key)} class="scard__link">
                  <span class="scard__media">
                    {img.desktop && (
                      <Image src={img.desktop} alt="" widths={[360, 540, 720]} sizes="(min-width: 1100px) 22vw, (min-width: 640px) 45vw, 92vw" layout="none" />
                    )}
                  </span>
                  <span class="scard__kicker mono">
                    {h.clients.caseStudy} · {workByKey[p.key]?.industry}
                  </span>
                  <span class="scard__title">{p.client}</span>
                  <span class="scard__more">
                    {t.common.viewProject} <Icon name="arrow-right" size={14} />
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- ───────────── Close: CTA + FAQ (navy) ───────────── -->
  <section class="section on-dark close" aria-labelledby="cta-title">
    <div class="container close__grid">
      <div class="close__cta" data-reveal>
        <h2 id="cta-title" class="close__title">
          {h.cta.heading}
          <span>{h.cta.headingAccent}</span>
        </h2>
        <p class="close__text">{h.cta.text}</p>
        <div class="close__actions">
          <Button href={url.section(lang, 'contact')} arrow={false}>{t.common.startProject}</Button>
          <Button href={url.section(lang, 'work')} variant="secondary" arrow={false}>{t.common.viewWork}</Button>
        </div>
      </div>
      <div class="close__faq">
        <div class="close__faq-head" data-reveal>
          <h2 class="h3">{v.faqHeading}</h2>
          <a href={url.section(lang, 'faq')} class="close__all">{v.allFaqs} <Icon name="arrow-right" size={14} /></a>
        </div>
        <Faq items={faqs} />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // ARIA tabs (services + case studies). Without JS every panel stays visible.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls')!)!);
    const select = (i: number, focus = false) => {
      tabs.forEach((tab, j) => {
        const on = i === j;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[j].hidden = !on;
      });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const n = tabs.length;
        const next = ({ ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: n - 1 } as Record<string, number>)[e.key];
        if (next === undefined) return;
        e.preventDefault();
        select((next + n) % n, true);
      });
    });
  });

  // Logo strip: pause/play (WCAG 2.2.2 — moving content needs a pause control).
  document.querySelectorAll<HTMLElement>('[data-strip]').forEach((strip) => {
    const btn = strip.querySelector<HTMLButtonElement>('[data-strip-toggle]');
    const label = strip.querySelector<HTMLElement>('[data-strip-label]');
    btn?.addEventListener('click', () => {
      const paused = strip.classList.toggle('is-paused');
      btn.setAttribute('aria-pressed', String(paused));
      if (label) label.textContent = (paused ? btn.dataset.labelPlay : btn.dataset.labelPause) ?? '';
    });
  });
</script>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    padding-top: calc(var(--header-h) + clamp(40px, 6vw, 88px));
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .hero__copy {
    display: grid;
    gap: 1.5rem;
    align-content: center;
    padding-bottom: clamp(40px, 6vw, 88px);
  }
  .hero__title {
    max-width: 14ch;
  }
  .hero__accent {
    color: var(--accent);
  }
  .hero__lead {
    max-width: 50ch;
    color: var(--text);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  /* Product-style preview: a window cut off by the band below and the right edge. */
  .hero__ui {
    position: relative;
    align-self: end;
    margin-right: calc(var(--gutter) * -1 - max(0px, (100vw - var(--container-wide) - var(--gutter) * 2) / 2));
    padding-left: clamp(24px, 4vw, 64px);
  }
  .hero__dots {
    inset: 10% auto 0 -2%;
    width: 30%;
    mask-image: none;
  }
  .ui {
    position: relative;
    background: #fff;
    border: 1px solid var(--line);
    border-bottom: 0;
    border-right: 0;
    box-shadow: var(--shadow-lg);
  }
  .ui__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 52px;
    padding-inline: 1.25rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
  }
  .ui__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .ui__brand i {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: linear-gradient(135deg, var(--dark-teal), var(--dark-cyan));
  }
  .ui__sep {
    width: 1px;
    height: 20px;
    background: var(--line-strong);
  }
  .ui__crumb {
    color: var(--text-muted);
  }
  .ui__body {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
  }
  .ui__nav {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: 1.25rem 1rem;
    border-right: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .ui__nav li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.6rem;
  }
  .ui__nav :global(.icon) {
    color: #2f9e6e;
  }
  .ui__nav .is-on {
    background: var(--oat);
    color: var(--text);
  }
  .ui__main {
    display: grid;
    gap: 1rem;
    padding: 1.25rem 1.25rem 0;
    background: var(--oat);
  }
  .ui__shot {
    position: relative;
    display: block;
    background: #fff;
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .ui__shot img {
    width: 100%;
    aspect-ratio: 16 / 9.5;
    object-fit: cover;
    object-position: top;
    transition: transform 900ms var(--ease-out);
  }
  .ui__shot:hover img {
    transform: scale(1.02);
  }
  .ui__shot--sm img {
    aspect-ratio: 16 / 10;
  }
  .ui__label {
    position: absolute;
