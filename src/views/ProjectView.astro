---
/**
 * Client profile — a short, visual page per client: who they are, what we did (services),
 * the live website on desktop and mobile, and a link to it. The long-form case-study fields in
 * src/content/work/<lang>/<key>.yaml (challenge, approach, design, development, result) are kept
 * in the content files but not shown here.
 */
import { Image, getImage } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import BrowserFrame from '~/components/BrowserFrame.astro';
import PhoneFrame from '~/components/PhoneFrame.astro';
import Button from '~/components/Button.astro';
import Badge from '~/components/Badge.astro';
import Icon from '~/components/Icon.astro';
import Testimonial from '~/components/Testimonial.astro';
import CtaBand from '~/components/CtaBand.astro';
import { fmt, languageMeta, useT, isLang } from '~/i18n';
import { url } from '~/i18n/routes';
import { projectByKey, sortedProjects } from '~/data/projects';
import { serviceMeta } from '~/data/services';
import { workImages } from '~/lib/work-images';
import { logoWidth, projectLogo } from '~/lib/client-logos';
import { breadcrumbs, caseStudy } from '~/lib/schema';
import { site } from '~/config/site';
import type { PageEntry } from '~/lib/pages';

interface Props {
  page: PageEntry;
}
const { page } = Astro.props;
const lang = page.lang;
const t = useT(lang);
const cs = t.caseStudy;
const project = projectByKey(page.key!)!;
const entry = await getEntry('work', `${lang}/${project.key}`);
if (!entry) throw new Error(`Missing case study: src/content/work/${lang}/${project.key}.yaml`);
const c = entry.data;
const img = workImages(project.key);
const logo = projectLogo(project.key);

const services = await getCollection('services', (e) => e.data.lang === lang);
const serviceData = Object.fromEntries(services.map((s) => [s.data.key, s.data]));
const serviceNames = Object.fromEntries(services.map((s) => [s.data.key, s.data.shortTitle]));
const work = await getCollection('work', (e) => e.data.lang === lang);
const copyFor = (key: string) => work.find((w) => w.data.key === key)?.data;

const siblings = project.group ? sortedProjects.filter((p) => p.key !== project.key && p.group === project.group) : [];
const idx = sortedProjects.findIndex((p) => p.key === project.key);
const prev = sortedProjects[(idx - 1 + sortedProjects.length) % sortedProjects.length];
const next = sortedProjects[(idx + 1) % sortedProjects.length];

const crumbs = [
  { name: t.nav.home, path: url.section(lang, 'home') },
  { name: t.nav.work, path: url.section(lang, 'work') },
  { name: project.client, path: page.path },
];
const og = img.desktop ? await getImage({ src: img.desktop, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg' }) : undefined;
const title = `${project.client} — ${c.industry} | Marketixo`;
const langNames = (project.siteLanguages ?? []).map((l) => (isLang(l) ? languageMeta[l].native : l.toUpperCase()));
const external = project.url ?? project.profile;
const host = external ? new URL(external).host.replace(/^www\./, '') : '';
---

<BaseLayout
  page={page}
  title={title.length > 70 ? `${project.client} | Marketixo` : title}
  description={c.metaDescription}
  image={og?.src}
  imageAlt={project.client}
  schema={[
    breadcrumbs(crumbs),
    caseStudy({ name: project.client, description: c.metaDescription, path: page.path, lang, image: og?.src ?? site.ogImage, client: project.client, clientUrl: project.url, services: project.services.map((s) => serviceNames[s] ?? s) }),
  ]}
>
  <article style={`--brand:${project.brand}`}>
    <header class="pf-hero">
      <div class="pf-hero__glow" aria-hidden="true"></div>
      <div class="container container--wide">
        <Breadcrumbs lang={lang} items={crumbs} />
        <div class="pf-hero__grid">
          <div class="pf-hero__main">
            <div class="pf-hero__id" data-reveal>
              {
                logo && (
                  <span class:list={['pf-logo', { 'pf-logo--dark': logo.dark }]}>
                    <Image src={logo.img} alt="" widths={[120, 240]} sizes="120px" layout="none" style={`width:${logoWidth(logo.img, 2400, 104, 46)}px`} />
                  </span>
                )
              }
              <p class="eyebrow">{c.industry}</p>
            </div>
            <h1 class="pf-hero__title" data-reveal style="--reveal-delay:1">{project.client}</h1>
            <p class="lead pf-hero__lead" data-reveal style="--reveal-delay:2">{c.summary}</p>
            <div class="pf-hero__actions" data-reveal style="--reveal-delay:3">
              {
                external && (
                  <Button href={external} external size="lg">
                    {project.url ? cs.visitSite : cs.profile}
                    <span class="sr-only"> ({t.common.opensNewTab})</span>
                  </Button>
                )
              }
              <Button href={url.section(lang, 'contact')} variant="secondary" size="lg">{t.common.startProject}</Button>
            </div>
          </div>

          <dl class="facts" data-reveal style="--reveal-delay:3">
            <div>
              <dt>{cs.industry}</dt>
              <dd>{c.industry}</dd>
            </div>
            {
              c.location && (
                <div>
                  <dt>{cs.location}</dt>
                  <dd>{c.location}</dd>
                </div>
              )
            }
            {
              langNames.length > 0 && (
                <div>
                  <dt>{cs.languages}</dt>
                  <dd>{langNames.join(' · ')}</dd>
                </div>
              )
            }
            {
              host && (
                <div>
                  <dt>{project.url ? cs.liveSite : cs.profile}</dt>
                  <dd>{host}</dd>
                </div>
              )
            }
          </dl>
        </div>
      </div>
    </header>

    <div class="container container--wide">
      {
        img.desktop ? (
          <div class="cs-shot" data-reveal="mask">
            <div class="showcase">
              <BrowserFrame
                src={img.desktop}
                alt={`${project.client} — ${cs.galleryDesktop}`}
                url={project.url}
                loading="eager"
                fetchpriority="high"
                sizes="(min-width: 1560px) 1520px, 96vw"
                aspect="16 / 9"
                class="showcase__desk"
              />
              {img.mobile && <PhoneFrame src={img.mobile} alt={`${project.client} — ${cs.galleryMobile}`} sizes="(min-width: 1024px) 260px, 30vw" class="showcase__phone" />}
            </div>
          </div>
        ) : (
          <div>
            <div class="pf-cover" aria-hidden="true">
              <div class="pf-cover__grid">
                {Array.from({ length: 12 }, (_, i) => (
                  <span style={`--d:${i}`} />
                ))}
              </div>
              <span class="pf-cover__name">{project.client}</span>
            </div>
            <p class="pf-nosite">{cs.noSite}</p>
          </div>
        )
      }
    </div>

    <section class="section did" aria-labelledby="what-we-did">
      <div class="container container--wide did__grid">
        <div class="did__text">
          <h2 id="what-we-did" class="h2" data-reveal>{cs.whatWeDid}</h2>
          <p class="did__lead" data-reveal style="--reveal-delay:1">{c.overview}</p>
          {
            c.highlights.length > 0 && (
              <ul role="list" class="highlights" aria-label={cs.highlights}>
                {c.highlights.map((h, i) => (
                  <li data-reveal style={`--reveal-delay:${i}`}>
                    <Icon name="check" size={18} />
                    {h}
                  </li>
                ))}
              </ul>
            )
          }
          {
            c.results.length > 0 && (
              <ul role="list" class="metrics">
                {c.results.map((r) => (
                  <li>
                    <strong>{r.value}</strong>
                    <span>{r.label}</span>
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <div class="did__side">
          <h3 class="eyebrow eyebrow--plain">{cs.services}</h3>
          <ul role="list" class="svc">
            {
              project.services.map((s, i) => (
                <li data-reveal style={`--reveal-delay:${i}`}>
                  <a href={url.service(lang, s)} class="svc__link">
                    <span class="svc__icon">
                      <Icon name={serviceMeta[s].icon} size={20} />
                    </span>
                    <span class="svc__text">
                      <strong>{serviceNames[s] ?? s}</strong>
                      {serviceData[s]?.tagline && <span>{serviceData[s].tagline}</span>}
                    </span>
                    <Icon name="arrow-right" size={16} class="svc__arrow" />
                  </a>
                </li>
              ))
            }
          </ul>
          <h3 class="eyebrow eyebrow--plain did__gap">{cs.technologies}</h3>
          <ul role="list" class="tech">
            {project.technologies.map((tech) => <li><Badge>{tech}</Badge></li>)}
          </ul>
        </div>
      </div>
    </section>

    {
      img.page && (
        <section class="section section--flush-top" aria-labelledby="gallery">
          <div class="container container--wide">
            <h2 id="gallery" class="eyebrow">
              {cs.galleryPage}
            </h2>
            <figure class="scroller" data-reveal tabindex="0" aria-label={cs.galleryPage}>
              <div class="scroller__win">
                <Image src={img.page} alt={`${project.client} — ${cs.galleryPage}`} widths={[640, 960, 1440, 1920]} sizes="(min-width: 1560px) 1520px, 96vw" loading="lazy" layout="none" class="scroller__img" />
              </div>
            </figure>
          </div>
        </section>
      )
    }

    <Testimonial lang={lang} project={project.key} />

    <section class="section section--sm section--line" aria-label={t.nav.work}>
      <div class="container container--wide">
        {
          siblings.length > 0 && (
            <div class="group">
              <h2 class="eyebrow">{fmt(cs.siblings, { group: project.group! })}</h2>
              <ul role="list" class="group__list">
                {siblings.map((sib) => (
                  <li>
                    <a href={url.project(lang, sib.key)}>
                      <span>{sib.client}</span>
                      <span class="group__ind">{copyFor(sib.key)?.industry}</span>
                      <Icon name="arrow-right" size={18} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <nav class="pager" aria-label={t.nav.work}>
          <a href={url.project(lang, prev.key)} rel="prev">
            <span class="mono">← {cs.prev}</span>
            <strong>{prev.client}</strong>
          </a>
          <a href={url.project(lang, next.key)} rel="next" class="pager__next">
            <span class="mono">{cs.next} →</span>
            <strong>{next.client}</strong>
          </a>
        </nav>
      </div>
    </section>
  </article>

  <CtaBand lang={lang} heading={cs.cta} accent={t.home.cta.headingAccent} />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .pf-hero {
    position: relative;
    padding-top: calc(var(--header-h) + clamp(32px, 5vw, 72px));
    padding-bottom: clamp(32px, 4vw, 56px);
    overflow: hidden;
    isolation: isolate;
  }
  .pf-hero__glow {
    position: absolute;
    top: -40%;
    right: -10%;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--brand) 45%, transparent), transparent 70%);
    opacity: 0.6;
    z-index: -1;
  }
  .pf-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2rem, 5vw, 6rem);
    align-items: end;
    margin-top: clamp(1.75rem, 3.5vw, 3rem);
  }
  .pf-hero__main {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .pf-hero__id {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .pf-logo {
    display: grid;
    place-items: center;
    height: 4.25rem;
    min-width: 7.5rem;
    padding: 0.6rem 1rem;
    border-radius: var(--radius);
    background: #fff;
    box-shadow: var(--shadow);
  }
  .pf-logo--dark {
    background: var(--ink-black);
    border: 1px solid var(--line-strong);
  }
  .pf-logo img {
    height: auto;
    max-width: 100%;
  }
  .pf-hero__title {
    font-size: clamp(2.5rem, 1.4rem + 4.2vw, 5.75rem);
    letter-spacing: var(--tracking-display);
    line-height: 0.95;
  }
  .pf-hero__lead {
    max-width: 52ch;
  }
  .pf-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .facts {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .facts > div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    font-family: var(--font-code);
    font-size: var(--fs-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-subtle);
    padding-top: 0.2rem;
  }
  .facts dd {
    margin: 0;
    font-size: 0.9375rem;
  }

  /* ---------- Showcase: desktop + phone ---------- */
  .showcase {
    position: relative;
    padding-bottom: clamp(2rem, 6vw, 5rem);
  }
  .showcase :global(.showcase__desk) {
    width: 100%;
  }
  @media (min-width: 640px) {
    .showcase :global(.showcase__desk) {
      width: 86%;
    }
  }
  .showcase :global(.showcase__phone) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: clamp(120px, 19%, 270px);
  }
  @media (max-width: 639px) {
    .showcase {
      padding-bottom: 0;
    }
    .showcase :global(.showcase__phone) {
      display: none;
    }
  }
  .pf-cover {
    position: relative;
    display: grid;
    place-items: end start;
    aspect-ratio: 16 / 7;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-strong);
    background:
      radial-gradient(ellipse at 75% 30%, color-mix(in srgb, var(--brand) 60%, transparent), transparent 60%),
      linear-gradient(135deg, #021a22, color-mix(in srgb, var(--brand) 35%, #001219));
    overflow: hidden;
  }
  .pf-cover__grid {
    position: absolute;
    top: 50%;
    right: 6%;
    translate: 0 -50%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    width: min(44%, 460px);
    transform: rotate(-6deg);
  }
  .pf-cover__grid span {
    aspect-ratio: 1;
    border-radius: 8px;
    background: rgb(255 255 255 / calc(0.05 + var(--d) * 0.01));
    border: 1px solid rgb(255 255 255 / 0.12);
  }
  .pf-cover__grid span:nth-child(3n + 1) {
    background: color-mix(in srgb, var(--brand) 70%, transparent);
  }
  .pf-cover__name {
    position: relative;
    max-width: 50%;
    font-size: clamp(2rem, 1rem + 4vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.95;
    color: #fff;
  }
  .pf-nosite {
    margin-top: 1rem;
    font-family: var(--font-code);
    font-size: var(--fs-xs);
    color: var(--text-subtle);
  }

  /* ---------- What we did ---------- */
  .did {
    padding-top: clamp(3rem, 6vw, 5.5rem);
  }
  .did__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: start;
  }
  .did__text {
    display: grid;
    gap: 1.25rem;
  }
  .did__lead {
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.75rem);
    letter-spacing: -0.02em;
    line-height: 1.35;
    max-width: 52ch;
  }
  .highlights {
    display: grid;
    margin-top: 0.5rem;
    border-top: 1px solid var(--line);
  }
  .highlights li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
  }
  .highlights :global(.icon) {
    flex: none;
    margin-top: 0.15rem;
    color: var(--pearl-aqua);
  }
  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-top: 1rem;
  }
  .metrics strong {
    display: block;
    font-size: clamp(2.5rem, 2rem + 2vw, 4rem);
    letter-spacing: -0.05em;
    color: var(--golden-orange);
  }
  .metrics span {
    color: var(--text-muted);
  }
  .did__side {
    display: grid;
    gap: 1rem;
  }
  .did__gap {
    margin-top: 1rem;
  }
  .svc {
    display: grid;
    gap: 0.5rem;
  }
  .svc__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-1);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }
  .svc__link:hover {
    border-color: var(--line-strong);
    background: var(--surface-2);
  }
  .svc__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--brand) 30%, var(--surface-3));
    color: #fff;
  }
  .svc__text {
    display: grid;
    gap: 0.1rem;
  }
  .svc__text strong {
    font-weight: 600;
  }
  .svc__text span {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  .svc__link :global(.svc__arrow) {
    color: var(--accent);
    transition: transform var(--dur) var(--ease);
  }
  .svc__link:hover :global(.svc__arrow) {
    transform: translateX(4px);
  }
  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* ---------- Full-page screenshot ---------- */
  .scroller {
    margin: 1.25rem 0 0;
  }
  .scroller__win {
    height: clamp(300px, 36vw, 560px);
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-strong);
    background: #fff;
    box-shadow: var(--shadow-lg);
  }
  .scroller__img {
    width: 100%;
    height: auto;
    transition: transform 7s var(--ease);
  }
  @media (prefers-reduced-motion: no-preference) {
    .scroller:hover .scroller__img,
    .scroller:focus-visible .scroller__img {
      transform: translateY(calc(-100% + clamp(300px, 36vw, 560px)));
    }
  }

  /* ---------- Group + pager ---------- */
  .group {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .group__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px;
    margin-top: 1.25rem;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .group__list a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg);
    text-decoration: none;
    font-weight: 600;
    font-size: 1.125rem;
    transition: background-color var(--dur) var(--ease);
  }
  .group__list a:hover {
    background: var(--surface-1);
  }
  .group__ind {
    grid-row: 2;
    font-weight: 400;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  .group__list :global(.icon) {
    grid-row: span 2;
    align-self: center;
    color: var(--pearl-aqua);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: grid;
    gap: 0.4rem;
    padding-block: 1.5rem;
    text-decoration: none;
  }
  .pager a strong {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    letter-spacing: -0.03em;
    transition: color var(--dur) var(--ease);
  }
  .pager a:hover strong {
    color: var(--pearl-aqua);
  }
  .pager .mono {
    color: var(--text-subtle);
  }
  .pager__next {
    text-align: right;
  }

  @media (max-width: 1023px) {
    .pf-hero__grid,
    .did__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 479px) {
    .pf-hero__actions {
      display: grid;
      width: 100%;
    }
  }
</style>
