---
/**
 * Home page. The previous design is kept at /home-classic/ (src/views/HomePageClassic.astro).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import Faq from '~/components/Faq.astro';
import WorkIndex from '~/components/WorkIndex.astro';
import { site, whatsappLink } from '~/config/site';
import { alternatesFor, t, url, type Lang } from '~/i18n/ui';
import { groupOrder, services, servicesByGroup, serviceUrl } from '~/data/services';
import { allClients, projects, testimonials } from '~/data/work';
import { logoFor } from '~/lib/assets';
import { faqSchema } from '~/lib/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);

const copy = {
  en: {
    title: 'Marketixo — Web Design, SEO & Digital Marketing Agency',
    description:
      'Marketixo builds websites, brands and marketing that bring you clients — plus cybersecurity and software testing to keep it all running. Free quote in 24h.',
    eyebrow: 'Digital agency · English & Deutsch',
    h1: ['Build it.', 'Grow it.', 'Protect it.'],
    sub: 'Your website, marketing and security — handled by one team.',
    lead: 'Most businesses juggle a web designer, a marketing freelancer and an IT person. We do all three, with one plan and one point of contact.',
    stats: [
      { value: String(allClients.length), label: 'brands we’ve worked with' },
      { value: String(services.length), label: 'services under one roof' },
      { value: '2', label: 'languages: English & German' },
      { value: '1', label: 'point of contact for everything' },
    ],
    trustedBy: 'Trusted by',
    pillarsEyebrow: 'What we do',
    pillarsTitle: 'Three things every business needs online.',
    pillarsText: 'Pick one, or let us take care of all three. Every service is fixed-price and works with the others.',
    compareEyebrow: 'Why one team',
    compareTitle: 'Stop managing three agencies.',
    usual: {
      title: 'The usual way',
      items: [
        'A web designer, a marketer and an IT person, each with their own invoice',
        'A beautiful website nobody finds on Google',
        'Ads sending traffic to pages that don’t convert',
        'Security is “someone else’s job” until something breaks',
        'When results are poor, everyone points at someone else',
      ],
    },
    ours: {
      title: 'With Marketixo',
      items: [
        'One team, one plan, one fixed quote',
        'Every site is fast, mobile-first and SEO-ready from day one',
        'Ads, SEO and landing pages built to work together',
        'Tested, backed up and protected as standard',
        'One person who knows your project and owns the results',
      ],
    },
    processEyebrow: 'How we work',
    processTitle: 'From first call to results.',
    process: [
      { when: 'Day 1', title: 'Free intro call', text: '20 minutes to understand your business, goals and budget.' },
      { when: 'Within 48 h', title: 'Plan & fixed quote', text: 'A clear proposal with scope, timeline and price.' },
      { when: 'Milestones', title: 'Build & launch', text: 'We design, build and test, with check-ins along the way.' },
      { when: 'Ongoing', title: 'Measure & improve', text: 'We track what matters and keep improving after launch.' },
    ],
    workEyebrow: 'Selected work',
    workTitle: 'Projects we’re proud of.',
    testimonialsTitle: 'What clients say',
    contactTitle: 'Rather talk to a person?',
    contactText: 'Send a message on WhatsApp, write an email or book a short call. We reply within one business day.',
    finalTitle: 'Let’s build something that works.',
    finalText: 'Free consultation · Fixed-price quotes · Reply within 1 business day',
    faq: [
      { q: 'How much does a website or marketing project cost?', a: 'Every business is different, so we give you a fixed price after a short call. Small business websites typically start in the low four figures; ongoing marketing is a monthly package. You always know the price before we start.' },
      { q: 'Do you work with clients in Germany, Austria and Switzerland?', a: 'Yes. We work remotely with clients across Europe, in English and German, and we optimise for each market separately.' },
      { q: 'Can I hire you for just one service?', a: 'Absolutely. Many clients start with one thing, like a new website or an SEO audit, and add more later.' },
      { q: 'How quickly do you respond?', a: 'Within one business day. On WhatsApp usually much faster.' },
    ],
  },
  de: {
    title: 'Marketixo — Agentur für Webdesign, SEO & Online-Marketing',
    description:
      'Marketixo entwickelt Websites, Marken und Marketing, die Kunden bringen — plus Cybersecurity und Softwaretests, damit alles läuft. Angebot innerhalb von 24 h.',
    eyebrow: 'Digitalagentur · Deutsch & English',
    h1: ['Aufbauen.', 'Wachsen.', 'Schützen.'],
    sub: 'Website, Marketing und Sicherheit — aus einer Hand.',
    lead: 'Die meisten Unternehmen jonglieren mit Webdesigner, Marketing-Freelancer und IT-Dienstleister. Wir übernehmen alles drei, mit einem Plan und einem Ansprechpartner.',
    stats: [
      { value: String(allClients.length), label: 'Marken, mit denen wir arbeiten' },
      { value: String(services.length), label: 'Leistungen aus einer Hand' },
      { value: '2', label: 'Sprachen: Deutsch & Englisch' },
      { value: '1', label: 'Ansprechpartner für alles' },
    ],
    trustedBy: 'Vertrauen uns',
    pillarsEyebrow: 'Was wir tun',
    pillarsTitle: 'Drei Dinge, die jedes Unternehmen online braucht.',
    pillarsText: 'Wählen Sie eins aus oder überlassen Sie uns alle drei. Jede Leistung zum Festpreis, und alles greift ineinander.',
    compareEyebrow: 'Warum ein Team',
    compareTitle: 'Schluss mit drei Agenturen.',
    usual: {
      title: 'Der übliche Weg',
      items: [
        'Webdesigner, Marketing und IT — jeder mit eigener Rechnung',
        'Eine schöne Website, die bei Google niemand findet',
        'Anzeigen, die auf Seiten führen, die nicht konvertieren',
        'Sicherheit ist „nicht unser Thema“ — bis etwas kaputtgeht',
        'Bleiben Ergebnisse aus, zeigt jeder auf den anderen',
      ],
    },
    ours: {
      title: 'Mit Marketixo',
      items: [
        'Ein Team, ein Plan, ein Festpreis',
        'Jede Website schnell, mobiloptimiert und ab Tag eins SEO-fertig',
        'Werbung, SEO und Landingpages, die zusammenarbeiten',
        'Getestet, gesichert und geschützt als Standard',
        'Ein Ansprechpartner, der Ihr Projekt kennt und für Ergebnisse geradesteht',
      ],
    },
    processEyebrow: 'So arbeiten wir',
    processTitle: 'Vom ersten Gespräch zu Ergebnissen.',
    process: [
      { when: 'Tag 1', title: 'Kostenloses Erstgespräch', text: '20 Minuten, um Ihr Unternehmen, Ihre Ziele und Ihr Budget zu verstehen.' },
      { when: 'Innerhalb 48 h', title: 'Plan & Festpreis', text: 'Ein klares Angebot mit Umfang, Zeitplan und Preis.' },
      { when: 'Meilensteine', title: 'Umsetzung & Launch', text: 'Wir gestalten, entwickeln und testen — mit Abstimmung unterwegs.' },
      { when: 'Laufend', title: 'Messen & verbessern', text: 'Wir messen, was zählt, und optimieren nach dem Launch weiter.' },
    ],
    workEyebrow: 'Ausgewählte Projekte',
    workTitle: 'Projekte, auf die wir stolz sind.',
    testimonialsTitle: 'Das sagen unsere Kunden',
    contactTitle: 'Lieber persönlich sprechen?',
    contactText: 'Schreiben Sie uns per WhatsApp oder E-Mail, oder buchen Sie ein kurzes Gespräch. Wir antworten innerhalb eines Werktags.',
    finalTitle: 'Lassen Sie uns etwas bauen, das funktioniert.',
    finalText: 'Kostenlose Erstberatung · Festpreisangebote · Antwort innerhalb eines Werktags',
    faq: [
      { q: 'Was kostet eine Website oder ein Marketingprojekt?', a: 'Jedes Unternehmen ist anders, deshalb erhalten Sie nach einem kurzen Gespräch einen Festpreis. Websites für kleine Unternehmen beginnen meist im niedrigen vierstelligen Bereich; laufendes Marketing ist ein Monatspaket. Den Preis kennen Sie immer, bevor wir starten.' },
      { q: 'Arbeiten Sie mit Kunden in Deutschland, Österreich und der Schweiz?', a: 'Ja. Wir arbeiten remote mit Kunden in ganz Europa, auf Deutsch und Englisch, und optimieren für jeden Markt separat.' },
      { q: 'Kann ich auch nur eine Leistung buchen?', a: 'Selbstverständlich. Viele Kunden starten mit einem Projekt, etwa einer neuen Website oder einem SEO-Audit, und erweitern später.' },
      { q: 'Wie schnell antworten Sie?', a: 'Innerhalb eines Werktags. Per WhatsApp meist deutlich schneller.' },
    ],
  },
}[lang];

const logos = allClients.flatMap((c) => {
  const src = logoFor(c.key, c.logo);
  return src ? [{ name: c.client, src }] : [];
});
const groupIcons = { build: 'layout', grow: 'chart', protect: 'shield' } as const;
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  alternates={alternatesFor('home')}
  appendSiteName={false}
  schema={[faqSchema(copy.faq)]}
>
  <!-- Hero: dark panel with a stacked headline -->
  <section class="hx">
    <div class="container">
      <div class="hx__panel">
        <div class="hx__glow" aria-hidden="true"></div>
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1 class="hx__title">
          {
            copy.h1.map((line, i) => (
              <span class={`hx__line hx__line--${groupOrder[i]}`} style={`animation-delay:${i * 120}ms`}>
                {line}
              </span>
            ))
          }
        </h1>
        <div class="hx__bottom">
          <div>
            <p class="hx__sub">{copy.sub}</p>
            <p class="hx__lead">{copy.lead}</p>
            <div class="btn-row">
              <a href={url('contact', lang) + '#quote'} class="btn btn--signal">
                {s.cta.quote}
                <Icon name="arrow" class="arrow" />
              </a>
              <a href={whatsappLink(s.whatsappText)} class="btn btn--ghost" target="_blank" rel="noopener">
                <Icon name="whatsapp" />
                {s.cta.whatsapp}
              </a>
            </div>
          </div>
          <dl class="hx__stats">
            {
              copy.stats.map((stat) => (
                <div>
                  <dt>{stat.label}</dt>
                  <dd>{stat.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- Client logos -->
  {
    logos.length > 0 && (
      <section class="logos" aria-label={copy.trustedBy}>
        <p class="logos__label">{copy.trustedBy}</p>
        <div class="logos__viewport">
          <div class="logos__track">
            {[0, 1].map((copyIndex) => (
              <ul aria-hidden={copyIndex === 1 ? 'true' : undefined}>
                {logos.map((logo) => (
                  <li>
                    <img src={logo.src} alt={copyIndex === 0 ? logo.name : ''} loading="lazy" decoding="async" />
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Build / Grow / Protect -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <span class="eyebrow">{copy.pillarsEyebrow}</span>
          <h2 style="margin-top:1rem">{copy.pillarsTitle}</h2>
        </div>
        <p class="lead">{copy.pillarsText}</p>
      </div>

      <div class="pillars">
        {
          groupOrder.map((g, i) => (
            <article class={`pillar pillar--${g} reveal`} style={`transition-delay:${i * 80}ms`}>
              <header class="pillar__head">
                <span class="pillar__icon">
                  <Icon name={groupIcons[g]} size={22} />
                </span>
                <span class="pillar__num">0{i + 1}</span>
              </header>
              <h3>{s.groups[g].name}</h3>
              <p>{s.groups[g].text}</p>
              <ul class="pillar__list">
                {servicesByGroup(g).map((svc) => (
                  <li>
                    <a href={serviceUrl(svc, lang)}>
                      <span>{svc.copy[lang].title}</span>
                      <Icon name="arrow" size={18} />
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <p class="pillars__more">
        <a href={url('services', lang)} class="link-arrow">{s.cta.allServices} <Icon name="arrow" /></a>
      </p>
    </div>
  </section>

  <!-- The usual way vs. one team -->
  <section class="section section--ink">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{copy.compareEyebrow}</span>
        <h2>{copy.compareTitle}</h2>
      </div>
      <div class="compare">
        <div class="compare__col compare__col--usual reveal">
          <h3>{copy.usual.title}</h3>
          <ul>{copy.usual.items.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="compare__col compare__col--ours reveal" style="transition-delay:100ms">
          <h3>{copy.ours.title}</h3>
          <ul>{copy.ours.items.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Process timeline -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{copy.processEyebrow}</span>
        <h2>{copy.processTitle}</h2>
      </div>
      <ol class="timeline">
        {
          copy.process.map((step, i) => (
            <li class="timeline__step reveal" style={`transition-delay:${i * 80}ms`}>
              <span class="timeline__dot" aria-hidden="true">{i + 1}</span>
              <span class="timeline__when">{step.when}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Selected work -->
  <section class="section section--white">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <span class="eyebrow">{copy.workEyebrow}</span>
          <h2 style="margin-top:1rem">{copy.workTitle}</h2>
        </div>
        <a href={url('work', lang)} class="link-arrow">{s.cta.allWork} <Icon name="arrow" /></a>
      </div>
      <WorkIndex projects={projects.slice(0, 5)} lang={lang} />
    </div>
  </section>

  {
    testimonials.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <h2>{copy.testimonialsTitle}</h2>
          </div>
          <div class="grid grid--3">
            {testimonials.map((item) => (
              <figure class="card quote-card reveal">
                <blockquote>“{item.quote[lang]}”</blockquote>
                <figcaption>
                  <strong>{item.name}</strong>
                  <span>{item.role}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ + direct contact -->
  <section class="section">
    <div class="container">
      <Faq title={s.faqTitle} items={copy.faq} />

      <div class="talk reveal">
        <div>
          <h2>{copy.contactTitle}</h2>
          <p>{copy.contactText}</p>
        </div>
        <ul class="talk__links">
          <li>
            <a href={whatsappLink(s.whatsappText)} target="_blank" rel="noopener">
              <Icon name="whatsapp" size={20} />
              <span>WhatsApp</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`}>
              <Icon name="mail" size={20} />
              <span>{site.email}</span>
            </a>
          </li>
          {
            site.bookingUrl && (
              <li>
                <a href={site.bookingUrl} target="_blank" rel="noopener">
                  <Icon name="calendar" size={20} />
                  <span>{s.cta.book}</span>
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Final call to action -->
  <section class="final">
    <div class="container">
      <h2>{copy.finalTitle}</h2>
      <div class="final__row">
        <a href={url('contact', lang) + '#quote'} class="btn final__btn">
          {s.cta.quote}
          <Icon name="arrow" class="arrow" />
        </a>
        <p>{copy.finalText}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hx {
    padding-block: clamp(12px, 2vw, 24px) clamp(40px, 6vw, 72px);
  }
  .hx__panel {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(32px, 6vw, 80px) clamp(24px, 5vw, 72px) clamp(32px, 5vw, 64px);
    border-radius: calc(var(--radius-lg) + 8px);
    background: var(--ink);
    color: var(--on-ink);
  }
  .hx__panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 70% 80% at 85% 20%, #000 20%, transparent 70%);
  }
  .hx__glow {
    position: absolute;
    z-index: -1;
    top: -30%;
    right: -12%;
    width: 60%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 90 31 / 0.4), rgb(255 90 31 / 0) 65%);
    filter: blur(8px);
  }
  .hx .eyebrow {
    color: var(--on-ink-muted);
  }
  .hx__title {
    display: grid;
    margin: 1.5rem 0 clamp(2rem, 5vw, 4rem);
    font-size: clamp(2.6rem, 13vw, 8.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    color: var(--white);
  }
  .hx__line {
    display: flex;
    align-items: center;
    gap: 0.25em;
    animation: rise 0.8s var(--ease) both;
  }
  .hx__line::after {
    content: '';
    flex: none;
    width: 0.2em;
    height: 0.2em;
    border-radius: 0.05em;
    background: var(--accent);
    rotate: 45deg;
  }
  .hx__line--build {
    --accent: var(--build);
  }
  .hx__line--grow {
    --accent: var(--grow);
  }
  .hx__line--protect {
    --accent: var(--protect);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.3em);
    }
  }
  .hx__bottom {
    display: grid;
    gap: clamp(32px, 5vw, 56px);
    padding-top: clamp(24px, 4vw, 40px);
    border-top: 1px solid var(--line-ink);
  }
  @media (min-width: 1000px) {
    .hx__bottom {
      grid-template-columns: 1.1fr 1fr;
      align-items: end;
    }
  }
  .hx__sub {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--white);
  }
  .hx__lead {
    max-width: 52ch;
    margin: 0 0 2rem;
    color: var(--on-ink-muted);
  }
  .hx .btn--ghost {
    --btn-fg: var(--on-ink);
  }
  .hx .btn--ghost:hover {
    --btn-bg: var(--white);
    --btn-fg: var(--ink);
    border-color: var(--white);
  }
  .hx__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line-ink);
    border-radius: var(--radius-lg);
    background: var(--line-ink);
  }
  .hx__stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.25rem;
    padding: clamp(16px, 2.4vw, 24px);
    background: var(--ink-2);
  }
  .hx__stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--white);
  }
  .hx__stats dt {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--on-ink-muted);
  }

  /* Logo strip */
  .logos {
    padding-bottom: clamp(24px, 4vw, 48px);
  }
  .logos__label {
    margin: 0 0 1.25rem;
    text-align: center;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .logos__viewport {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }
  .logos__track {
    display: flex;
    width: max-content;
    animation: logos 60s linear infinite;
  }
  .logos__viewport:hover .logos__track {
    animation-play-state: paused;
  }
  .logos ul {
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 0 16px 0 0;
    list-style: none;
  }
  .logos li {
    display: grid;
    place-items: center;
    width: 168px;
    height: 88px;
    padding: 18px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
  }
  .logos img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.75;
    transition:
      filter 0.25s var(--ease),
      opacity 0.25s var(--ease);
  }
  .logos li:hover img {
    filter: none;
    opacity: 1;
  }
  @keyframes logos {
    to {
      transform: translateX(-50%);
    }
  }

  /* Pillars */
  .pillars {
    display: grid;
    gap: clamp(16px, 2vw, 24px);
  }
  @media (min-width: 900px) {
    .pillars {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .pillar {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 3vw, 36px) clamp(24px, 3vw, 32px) clamp(24px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
  }
  .pillar::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: var(--accent);
  }
  .pillar--build {
    --accent: var(--build);
  }
  .pillar--grow {
    --accent: var(--grow);
  }
  .pillar--protect {
    --accent: var(--protect);
  }
  .pillar__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
  }
  .pillar__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--accent) 12%, white);
    color: var(--accent);
  }
  .pillar__num {
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--muted);
  }
  .pillar h3 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
  }
  .pillar > p {
    color: var(--muted);
