---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import ServiceCard from '~/components/ServiceCard.astro';
import Faq from '~/components/Faq.astro';
import QuoteForm from '~/components/QuoteForm.astro';
import { site, whatsappLink } from '~/config/site';
import { t, url, type Lang } from '~/i18n/ui';
import { services, serviceAlternates, serviceUrl, type Service } from '~/data/services';
import { breadcrumbSchema, faqSchema, serviceSchema } from '~/lib/schema';

interface Props {
  lang: Lang;
  service: Service;
}
const { lang, service } = Astro.props;
const s = t(lang);
const c = service.copy[lang];
const path = serviceUrl(service, lang);

const copy = {
  en: {
    outcomes: 'What you get',
    included: 'What’s included',
    asideTitle: `Get a free quote for ${c.title.toLowerCase()}`,
    asideText: 'Tell us about your project and get a clear, fixed-price proposal — usually within 48 hours.',
    related: 'Works well together with',
    formTitle: 'Let’s talk about your project',
  },
  de: {
    outcomes: 'Ihr Mehrwert',
    included: 'Leistungsumfang',
    asideTitle: `Kostenloses Angebot für ${c.title}`,
    asideText: 'Erzählen Sie uns von Ihrem Projekt und erhalten Sie ein klares Festpreisangebot — meist innerhalb von 48 Stunden.',
    related: 'Passt gut zusammen mit',
    formTitle: 'Lassen Sie uns über Ihr Projekt sprechen',
  },
}[lang];

// Related: other services in the same group first, then the rest.
const related = [
  ...services.filter((x) => x.group === service.group && x.key !== service.key),
  ...services.filter((x) => x.group !== service.group),
].slice(0, 3);

const crumbs = [
  { label: s.breadcrumbHome, href: url('home', lang) },
  { label: s.nav.services, href: url('services', lang) },
  { label: c.title, href: path },
];
---

<BaseLayout
  lang={lang}
  title={c.headline}
  description={c.metaDescription}
  alternates={serviceAlternates(service)}
  schema={[
    serviceSchema({ name: c.title, description: c.metaDescription, path, lang }),
    breadcrumbSchema(crumbs.map((x) => ({ name: x.label, path: x.href }))),
    faqSchema(c.faq),
  ]}
>
  <section class={`page-hero svc-hero svc-hero--${service.group}`}>
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="svc-hero__grid">
        <div>
          <span class="svc-hero__badge"><Icon name={service.icon} size={18} /> {c.title}</span>
          <h1>{c.headline}</h1>
          <p class="lead">{c.intro}</p>
          <div class="btn-row" style="margin-top:2rem">
            <a href="#quote" class="btn btn--signal">{s.cta.quote} <Icon name="arrow" class="arrow" /></a>
            <a href={whatsappLink(s.whatsappText)} class="btn btn--ghost" target="_blank" rel="noopener">
              <Icon name="whatsapp" />
              {s.cta.whatsapp}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight section--white">
    <div class="container">
      <h2 class="visually-hidden">{copy.outcomes}</h2>
      <div class="grid grid--3">
        {
          c.outcomes.map((o, i) => (
            <div class="outcome reveal" style={`transition-delay:${i * 80}ms`}>
              <span class="outcome__num">0{i + 1}</span>
              <h3>{o.title}</h3>
              <p>{o.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container included">
      <div>
        <span class="eyebrow">{c.title}</span>
        <h2 style="margin-top:1rem">{copy.included}</h2>
        <ul class="check-list included__list">
          {c.deliverables.map((d) => <li>{d}</li>)}
        </ul>
      </div>
      <aside class="included__aside">
        <h3>{copy.asideTitle}</h3>
        <p>{copy.asideText}</p>
        <a href="#quote" class="btn btn--signal">{s.cta.quote} <Icon name="arrow" class="arrow" /></a>
        {
          site.bookingUrl && (
            <a href={site.bookingUrl} class="btn btn--ghost" target="_blank" rel="noopener">
              <Icon name="calendar" />
              {s.cta.book}
            </a>
          )
        }
      </aside>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <Faq title={s.faqTitle} items={c.faq} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>{copy.related}</h2></div>
      <div class="grid grid--3">
        {related.map((r) => <ServiceCard service={r} lang={lang} />)}
      </div>
    </div>
  </section>

  <section class="section section--ink" id="quote">
    <div class="container form-wrap">
      <div>
        <h2>{copy.formTitle}</h2>
        <p class="lead">{s.form.intro}</p>
      </div>
      <div class="form-card">
        <QuoteForm lang={lang} preselect={service.key} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .svc-hero {
    --accent: var(--build);
  }
  .svc-hero--grow {
    --accent: var(--grow);
  }
  .svc-hero--protect {
    --accent: var(--protect);
  }
  .svc-hero h1 {
    max-width: 18ch;
  }
  .svc-hero .lead {
    max-width: 680px;
  }
  .svc-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 12%, white);
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .outcome {
    padding-top: 1.5rem;
    border-top: 2px solid var(--ink);
  }
  .outcome__num {
    font-family: var(--font-display);
    color: var(--signal);
    font-weight: 700;
  }
  .outcome h3 {
    margin-top: 1rem;
  }
  .outcome p {
    margin: 0;
    color: var(--muted);
  }
  .included {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1000px) {
    .included {
      grid-template-columns: 1.4fr 1fr;
      gap: 5rem;
      align-items: start;
    }
  }
  .included__list {
    margin-top: 2rem;
    font-size: 1.125rem;
  }
  .included__aside {
    position: sticky;
    top: 100px;
    display: grid;
    gap: 0.75rem;
    padding: 32px;
    border-radius: var(--radius-lg);
    background: var(--ink);
    color: var(--on-ink);
  }
  .included__aside h3 {
    margin: 0;
    color: var(--white);
  }
  .included__aside p {
    color: var(--on-ink-muted);
    margin-bottom: 0.75rem;
  }
  .included__aside .btn--ghost {
    --btn-fg: var(--on-ink);
  }
  .included__aside .btn--ghost:hover {
    --btn-bg: var(--white);
    --btn-fg: var(--ink);
  }
  .form-wrap {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1000px) {
    .form-wrap {
      grid-template-columns: 1fr 1.4fr;
      gap: 5rem;
      align-items: start;
    }
  }
  .form-card {
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--white);
    color: var(--text);
  }
</style>
