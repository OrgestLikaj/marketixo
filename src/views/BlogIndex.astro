---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Icon from '~/components/Icon.astro';
import CtaBand from '~/components/CtaBand.astro';
import { alternatesFor, t, url, type Lang } from '~/i18n/ui';
import { formatDate, getPosts, postUrl, readingTime } from '~/lib/blog';
import { breadcrumbSchema } from '~/lib/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const posts = await getPosts(lang);
const copy = {
  en: {
    title: 'Blog: Web Design, SEO & Marketing Tips',
    description: 'Practical advice on websites, SEO, online advertising, branding and security for small and medium businesses.',
    h1: 'Insights & guides',
    lead: 'Practical, no-fluff advice on websites, SEO, ads and security, written for business owners.',
    min: 'min read',
    empty: 'New articles are coming soon.',
  },
  de: {
    title: 'Blog: Tipps zu Webdesign, SEO & Marketing',
    description: 'Praxisnahe Tipps zu Websites, SEO, Online-Werbung, Branding und IT-Sicherheit für kleine und mittlere Unternehmen.',
    h1: 'Wissen & Ratgeber',
    lead: 'Praxisnahe Tipps ohne Fachchinesisch zu Websites, SEO, Werbung und Sicherheit — für Unternehmerinnen und Unternehmer.',
    min: 'Min. Lesezeit',
    empty: 'Neue Artikel folgen in Kürze.',
  },
}[lang];
const crumbs = [
  { label: s.breadcrumbHome, href: url('home', lang) },
  { label: s.nav.blog, href: url('blog', lang) },
];
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  alternates={alternatesFor('blog')}
  schema={[breadcrumbSchema(crumbs.map((c) => ({ name: c.label, path: c.href })))]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1>{copy.h1}</h1>
      <p class="lead">{copy.lead}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      {posts.length === 0 && <p class="lead">{copy.empty}</p>}
      <div class="grid grid--3">
        {
          posts.map((post) => (
            <a href={postUrl(post)} class="post-card reveal">
              <div class="post-card__tags">
                {post.data.tags.slice(0, 2).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <div class="post-card__meta">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
                <span>
                  · {readingTime(post.body)} {copy.min}
                </span>
                <Icon name="arrow-up-right" size={20} class="post-card__go" />
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    text-decoration: none;
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }
  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .post-card h2 {
    margin: 0.75rem 0 0;
    font-size: 1.4rem;
    line-height: 1.2;
  }
  .post-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.975rem;
  }
  .post-card__meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .post-card__meta :global(.post-card__go) {
    margin-left: auto;
    color: var(--ink);
  }
</style>
