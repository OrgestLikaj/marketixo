---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Icon from '~/components/Icon.astro';
import CtaBand from '~/components/CtaBand.astro';
import { site } from '~/config/site';
import { alternatesFor, t, url, type Lang } from '~/i18n/ui';
import { breadcrumbSchema } from '~/lib/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);

// TODO: Add your own story here — who you are, why you started Marketixo, and a photo.
// People buy from people: a real face and a short personal story build a lot of trust.
const copy = {
  en: {
    title: 'About Marketixo — Digital Agency',
    description: 'Marketixo is a digital agency for web design, marketing, cybersecurity and software testing. Learn how we work and what we stand for.',
    h1: 'Digital done properly, from first click to final check.',
    lead: 'Marketixo brings design, marketing and technology together in one team, so businesses don’t have to coordinate five freelancers to succeed online.',
    storyTitle: 'Why we exist',
    story: [
      'Too many businesses pay for a beautiful website that nobody finds, run ads without knowing what they bring, or only think about security after something goes wrong.',
      'We started Marketixo to fix that: one team that builds your online presence, helps it grow, and keeps it safe and working. Combining marketing with real technical skills like cybersecurity and software testing is what makes us different.',
      'We work remotely with clients across Europe in English and German, and treat every budget with the respect it deserves.',
    ],
    valuesTitle: 'What we stand for',
    values: [
      { icon: 'chat', title: 'Honest advice', text: 'If something won’t help your business, we’ll tell you, even if it means a smaller project.' },
      { icon: 'tag', title: 'Clear prices', text: 'Fixed quotes, clear scope, no surprises on the invoice.' },
      { icon: 'chart', title: 'Measurable results', text: 'We agree on goals up front and report on them in plain language.' },
      { icon: 'shield', title: 'Built to last', text: 'Fast, secure, tested work that doesn’t fall apart after launch.' },
    ],
    facts: [
      { k: 'Languages', v: 'English · Deutsch' },
      { k: 'Working with', v: 'Clients across Europe' },
      { k: 'Founded', v: String(site.foundingYear) },
    ],
  },
  de: {
    title: 'Über Marketixo — Digitalagentur',
    description: 'Marketixo ist eine Digitalagentur für Webdesign, Marketing, Cybersecurity und Softwaretests. Erfahren Sie, wie wir arbeiten und wofür wir stehen.',
    h1: 'Digital, aber richtig — vom ersten Klick bis zum letzten Check.',
    lead: 'Marketixo vereint Design, Marketing und Technik in einem Team, damit Unternehmen nicht fünf Freelancer koordinieren müssen, um online erfolgreich zu sein.',
    storyTitle: 'Warum es uns gibt',
    story: [
      'Zu viele Unternehmen bezahlen für eine schöne Website, die niemand findet, schalten Anzeigen, ohne zu wissen, was sie bringen, oder denken erst an Sicherheit, wenn etwas schiefgeht.',
      'Deshalb haben wir Marketixo gegründet: ein Team, das Ihren Online-Auftritt aufbaut, wachsen lässt und sicher hält. Die Verbindung von Marketing mit echtem technischen Know-how wie Cybersecurity und Softwaretests unterscheidet uns von anderen Agenturen.',
      'Wir arbeiten remote mit Kunden in ganz Europa, auf Deutsch und Englisch, und gehen mit jedem Budget verantwortungsvoll um.',
    ],
    valuesTitle: 'Wofür wir stehen',
    values: [
      { icon: 'chat', title: 'Ehrliche Beratung', text: 'Wenn etwas Ihrem Geschäft nicht hilft, sagen wir es Ihnen — auch wenn das Projekt dadurch kleiner wird.' },
      { icon: 'tag', title: 'Klare Preise', text: 'Festpreisangebote, klarer Umfang, keine Überraschungen auf der Rechnung.' },
      { icon: 'chart', title: 'Messbare Ergebnisse', text: 'Wir vereinbaren Ziele vorab und berichten verständlich darüber.' },
      { icon: 'shield', title: 'Nachhaltig gebaut', text: 'Schnelle, sichere und getestete Arbeit, die nach dem Launch nicht auseinanderfällt.' },
    ],
    facts: [
      { k: 'Sprachen', v: 'Deutsch · English' },
      { k: 'Kunden', v: 'In ganz Europa' },
      { k: 'Gegründet', v: String(site.foundingYear) },
    ],
  },
}[lang];
const crumbs = [
  { label: s.breadcrumbHome, href: url('home', lang) },
  { label: s.nav.about, href: url('about', lang) },
];
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  alternates={alternatesFor('about')}
  appendSiteName={false}
  schema={[breadcrumbSchema(crumbs.map((c) => ({ name: c.label, path: c.href })))]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1 style="max-width:20ch">{copy.h1}</h1>
      <p class="lead">{copy.lead}</p>
      <dl class="facts">
        {
          copy.facts.map((f) => (
            <div>
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section section--white">
    <div class="container story">
      <h2>{copy.storyTitle}</h2>
      <div class="prose">
        {copy.story.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>{copy.valuesTitle}</h2></div>
      <div class="grid grid--4">
        {
          copy.values.map((v, i) => (
            <div class="card value reveal" style={`transition-delay:${i * 80}ms`}>
              <Icon name={v.icon} size={28} class="value__icon" />
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 3rem;
    margin: 3rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .facts dt {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
  }
  .story {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 1000px) {
    .story {
      grid-template-columns: 1fr 1.5fr;
      gap: 5rem;
    }
  }
  .value :global(.value__icon) {
    color: var(--signal);
    margin-bottom: 2rem;
  }
  .value p {
    margin: 0;
    color: var(--muted);
    font-size: 0.975rem;
  }
</style>
