---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import CtaBand from '~/components/CtaBand.astro';
import { alternatesFor, t, url, type Lang } from '~/i18n/ui';
import { projects } from '~/data/work';
import { breadcrumbSchema } from '~/lib/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const copy = {
  en: {
    title: 'Our Work: Websites, Branding & Marketing Projects',
    description: 'Selected websites, logos, brand identities and marketing campaigns created by Marketixo for businesses across Europe.',
    h1: 'Work we’re proud of.',
    lead: 'A selection of websites, brands and campaigns. Want to see something specific for your industry? Just ask.',
  },
  de: {
    title: 'Referenzen: Websites, Branding & Marketingprojekte',
    description: 'Ausgewählte Websites, Logos, Markenauftritte und Marketingkampagnen, die Marketixo für Unternehmen in ganz Europa umgesetzt hat.',
    h1: 'Projekte, auf die wir stolz sind.',
    lead: 'Eine Auswahl an Websites, Marken und Kampagnen. Sie möchten Beispiele aus Ihrer Branche sehen? Fragen Sie uns einfach.',
  },
}[lang];
const crumbs = [
  { label: s.breadcrumbHome, href: url('home', lang) },
  { label: s.nav.work, href: url('work', lang) },
];
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  alternates={alternatesFor('work')}
  schema={[breadcrumbSchema(crumbs.map((c) => ({ name: c.label, path: c.href })))]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1>{copy.h1}</h1>
      <p class="lead">{copy.lead}</p>
    </div>
  </section>
  <section class="section section--white" style="padding-top:clamp(48px,6vw,80px)">
    <div class="container">
      <div class="grid grid--2 work-grid">
        {projects.map((p) => <ProjectCard project={p} lang={lang} />)}
      </div>
    </div>
  </section>
  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .work-grid {
    row-gap: clamp(40px, 5vw, 64px);
  }
</style>
