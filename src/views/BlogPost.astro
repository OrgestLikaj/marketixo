---
import { render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import CtaBand from '~/components/CtaBand.astro';
import { t, url } from '~/i18n/ui';
import { formatDate, postAlternates, postUrl, readingTime, type Post } from '~/lib/blog';
import { articleSchema, breadcrumbSchema } from '~/lib/schema';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { lang, title, description, pubDate, updatedDate, tags } = post.data;
const s = t(lang);
const { Content } = await render(post);
const alternates = await postAlternates(post);
const path = postUrl(post);
const min = lang === 'de' ? 'Min. Lesezeit' : 'min read';
const crumbs = [
  { label: s.breadcrumbHome, href: url('home', lang) },
  { label: s.nav.blog, href: url('blog', lang) },
  { label: title, href: path },
];
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  alternates={alternates}
  ogType="article"
  schema={[
    articleSchema({ title, description, path, lang, published: pubDate, modified: updatedDate }),
    breadcrumbSchema(crumbs.map((c) => ({ name: c.label, path: c.href }))),
  ]}
>
  <article>
    <header class="page-hero post-hero">
      <div class="container">
        <Breadcrumbs items={crumbs} />
        <div class="post-hero__tags">
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        <p class="post-hero__meta">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time> · {readingTime(post.body)} {min}
        </p>
      </div>
    </header>
    <div class="container">
      <div class="prose post-body">
        <Content />
      </div>
    </div>
  </article>
  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .post-hero h1 {
    max-width: 22ch;
    font-size: clamp(2.2rem, 5vw, 3.75rem);
  }
  .post-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 2rem;
  }
  .post-hero__meta {
    margin: 1.5rem 0 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .post-body {
    padding-bottom: 2rem;
  }
</style>
