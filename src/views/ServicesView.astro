---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import ServiceVisual from '~/components/ServiceVisual.astro';
import Icon from '~/components/Icon.astro';
import CtaBand from '~/components/CtaBand.astro';
import { useT } from '~/i18n';
import { url } from '~/i18n/routes';
import { serviceKeys, serviceMeta, type ServiceGroup } from '~/data/services';
import { breadcrumbs } from '~/lib/schema';
import type { PageEntry } from '~/lib/pages';

interface Props {
  page: PageEntry;
}
const { page } = Astro.props;
const lang = page.lang;
const t = useT(lang);
const sp = t.servicesPage;
const copy = await getCollection('services', (e) => e.data.lang === lang);
const byKey = Object.fromEntries(copy.map((c) => [c.data.key, c.data]));
const groups: ServiceGroup[] = ['build', 'grow', 'protect'];
const crumbs = [
  { name: t.nav.home, path: url.section(lang, 'home') },
  { name: t.nav.services, path: page.path },
];
const itemList = {
  '@type': 'ItemList',
  itemListElement: serviceKeys.map((k, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: byKey[k]?.title,
    url: new URL(url.service(lang, k), Astro.site).href,
  })),
};
---

<BaseLayout page={page} title={sp.metaTitle} description={sp.metaDescription} schema={[breadcrumbs(crumbs), itemList]}>
  <PageHero lang={lang} crumbs={crumbs} eyebrow={sp.eyebrow} title={sp.heading} lead={sp.lead} />

  {
    groups.map((group) => (
      <section class="grp" aria-labelledby={`grp-${group}`}>
        <div class="container container--wide">
          <header class="grp__head" data-reveal>
            <h2 id={`grp-${group}`} class="grp__title">
              <span class="grp__label">{t.common.groups[group]}</span>
              <span class="grp__line">{t.common.groupLines[group]}</span>
            </h2>
            <p class="grp__desc">{sp.groups[group]}</p>
          </header>
          <ul role="list" class="rows">
            {serviceKeys
              .filter((k) => serviceMeta[k].group === group)
              .map((key) => {
                const s = byKey[key]!;
                return (
                  <li class="row" data-reveal>
                    <div class="row__main">
                      <span class="index-num">{serviceMeta[key].index}</span>
                      <h3 class="row__title">
                        <a href={url.service(lang, key)} class="row__link">
                          {s.title}
                        </a>
                      </h3>
                      <p class="row__tagline">{s.tagline}</p>
                      <ul role="list" class="row__items" aria-label={sp.included}>
                        {s.included.items.slice(0, 5).map((it) => (
                          <li>
                            <Icon name="check" size={14} /> {it.title}
                          </li>
                        ))}
                      </ul>
                      <span class="row__more" aria-hidden="true">
                        {t.common.learnMore} <Icon name="arrow-right" size={16} />
                      </span>
                    </div>
                    <ServiceVisual service={key} class="row__visual" />
                  </li>
                );
              })}
          </ul>
        </div>
      </section>
    ))
  }

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .grp {
    padding-block: clamp(56px, 7vw, 104px);
    border-top: 1px solid var(--line);
  }
  .grp__head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 1rem 3rem;
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .grp__title {
    display: grid;
    gap: 0.5rem;
  }
  .grp__label {
    font-family: var(--font-code);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pearl-aqua);
  }
  .grp__line {
    font-size: var(--fs-h2);
    letter-spacing: var(--tracking-display);
  }
  .grp__desc {
    color: var(--text-muted);
    font-size: var(--fs-lg);
    max-width: 48ch;
  }
  .rows {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(1.5rem, 4vw, 5rem);
    align-items: center;
    padding-block: clamp(2rem, 4vw, 3.25rem);
    border-bottom: 1px solid var(--line);
  }
  .row__main {
    display: grid;
    gap: 0.85rem;
  }
  .row__title {
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3.25rem);
    letter-spacing: -0.045em;
  }
  .row__link {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size 500ms var(--ease-out);
  }
  .row__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .row:hover .row__link {
    background-size: 100% 2px;
  }
  .row__tagline {
    font-size: var(--fs-lg);
    color: var(--text-muted);
    max-width: 52ch;
  }
  .row__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }
  .row__items li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .row__items :global(.icon) {
    color: var(--dark-cyan);
  }
  .row__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-weight: 600;
    color: var(--pearl-aqua);
  }
  .row:hover .row__more :global(.icon) {
    transform: translateX(4px);
  }
  .row__more :global(.icon) {
    transition: transform var(--dur) var(--ease);
  }
  .row__visual {
    max-width: 420px;
    justify-self: end;
  }
  .row:has(.row__link:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }
  .row__link:focus-visible {
    outline: none;
  }
  @media (max-width: 899px) {
    .grp__head,
    .row {
      grid-template-columns: 1fr;
    }
    .row__visual {
      justify-self: start;
      max-width: 360px;
      order: -1;
    }
  }
</style>
