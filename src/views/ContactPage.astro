---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Icon from '~/components/Icon.astro';
import QuoteForm from '~/components/QuoteForm.astro';
import { site, whatsappLink } from '~/config/site';
import { alternatesFor, t, url, type Lang } from '~/i18n/ui';
import { breadcrumbSchema } from '~/lib/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const copy = {
  en: {
    title: 'Contact & Free Quote',
    description: 'Get a free, fixed-price quote for your website, SEO, ads, branding, security or testing project. Reply within one business day.',
    h1: 'Let’s build something that works.',
    lead: 'Fill in the form for a free quote, or reach us directly. Whatever is easiest for you.',
    direct: 'Prefer to talk directly?',
    waText: 'Fastest reply, usually within the hour',
    bookText: 'Pick a time that suits you',
    emailText: 'For files and longer briefs',
    phoneText: 'Mon–Fri, 9:00–18:00 CET',
    response: 'We reply within one business day.',
  },
  de: {
    title: 'Kontakt & kostenloses Angebot',
    description: 'Kostenloses Festpreisangebot für Website, SEO, Werbung, Branding, Sicherheit oder Softwaretests. Antwort innerhalb eines Werktags.',
    h1: 'Lassen Sie uns etwas bauen, das funktioniert.',
    lead: 'Füllen Sie das Formular für ein kostenloses Angebot aus oder kontaktieren Sie uns direkt — ganz wie es Ihnen lieber ist.',
    direct: 'Lieber direkt sprechen?',
    waText: 'Schnellste Antwort, meist innerhalb einer Stunde',
    bookText: 'Wählen Sie einen passenden Termin',
    emailText: 'Für Dateien und ausführliche Briefings',
    phoneText: 'Mo–Fr, 9:00–18:00 Uhr MEZ',
    response: 'Wir antworten innerhalb eines Werktags.',
  },
}[lang];
const crumbs = [
  { label: s.breadcrumbHome, href: url('home', lang) },
  { label: s.nav.contact, href: url('contact', lang) },
];
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  alternates={alternatesFor('contact')}
  schema={[breadcrumbSchema(crumbs.map((c) => ({ name: c.label, path: c.href })))]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1 style="max-width:18ch">{copy.h1}</h1>
      <p class="lead">{copy.lead}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container contact">
      <div class="contact__form card" id="quote">
        <h2>{s.form.title}</h2>
        <p class="contact__intro">{s.form.intro}</p>
        <QuoteForm lang={lang} />
      </div>

      <aside class="contact__aside">
        <h2>{copy.direct}</h2>
        <a class="channel channel--wa" href={whatsappLink(s.whatsappText)} target="_blank" rel="noopener">
          <span class="channel__icon"><Icon name="whatsapp" /></span>
          <span><strong>WhatsApp</strong><small>{copy.waText}</small></span>
        </a>
        {
          site.bookingUrl && (
            <a class="channel" href={site.bookingUrl} target="_blank" rel="noopener">
              <span class="channel__icon"><Icon name="calendar" /></span>
              <span>
                <strong>{s.cta.book}</strong>
                <small>{copy.bookText}</small>
              </span>
            </a>
          )
        }
        <a class="channel" href={`mailto:${site.email}`}>
          <span class="channel__icon"><Icon name="mail" /></span>
          <span><strong>{site.email}</strong><small>{copy.emailText}</small></span>
        </a>
        <a class="channel" href={`tel:${site.phoneHref}`}>
          <span class="channel__icon"><Icon name="phone" /></span>
          <span><strong>{site.phone}</strong><small>{copy.phoneText}</small></span>
        </a>
        <p class="contact__note"><Icon name="bolt" size={18} /> {copy.response}</p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1000px) {
    .contact {
      grid-template-columns: 1.6fr 1fr;
      gap: 4rem;
      align-items: start;
    }
  }
  .contact__form h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 0.5rem;
  }
  .contact__intro {
    color: var(--muted);
    margin-bottom: 2rem;
  }
  .contact__aside {
    display: grid;
    gap: 0.75rem;
    position: sticky;
    top: 100px;
  }
  .contact__aside h2 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .channel {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--white);
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s var(--ease);
  }
  .channel:hover {
    border-color: var(--ink);
    transform: translateX(4px);
  }
  .channel strong {
    display: block;
    font-size: 1rem;
    word-break: break-word;
  }
  .channel small {
    color: var(--muted);
    font-size: 0.875rem;
  }
  .channel__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--paper);
  }
  .channel--wa .channel__icon {
    background: #25d366;
    color: #fff;
  }
  .contact__note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .contact__note :global(svg) {
    color: var(--signal);
  }
</style>
