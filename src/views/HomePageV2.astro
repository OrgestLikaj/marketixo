---
/**
 * Alternative home page design, previewed at /home-v2/ and /de/home-v2/ (noindex, not linked).
 * To make it the live home page, import this view in src/pages/index.astro and
 * src/pages/de/index.astro instead of HomePage.astro.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import Logo from '~/components/Logo.astro';
import ServiceExplorer from '~/components/ServiceExplorer.astro';
import Faq from '~/components/Faq.astro';
import CtaBand from '~/components/CtaBand.astro';
import LogoGrid from '~/components/LogoGrid.astro';
import { whatsappLink } from '~/config/site';
import { alternatesFor, t, url, type Lang } from '~/i18n/ui';
import { testimonials } from '~/data/work';
import { faqSchema } from '~/lib/schema';
import { withBase } from '~/lib/paths';

interface Props {
  lang: Lang;
  /** Rendered at the preview URLs: points hreflang at them and keeps them out of search results. */
  preview?: boolean;
}
const { lang, preview = false } = Astro.props;
const s = t(lang);
const alternates = preview ? { en: withBase('/home-v2/'), de: withBase('/de/home-v2/') } : alternatesFor('home');

const copy = {
  en: {
    title: 'Marketixo — Web Design, SEO & Digital Marketing Agency',
    description:
      'Marketixo builds websites, brands and marketing that bring you clients — plus cybersecurity and software testing to keep it all running. Free quote in 24h.',
    eyebrow: 'Digital agency · English & Deutsch',
    h1: ['Websites and marketing that ', 'bring you clients', '.'],
    lead: 'Design, SEO, ads and social media — plus security and testing that keep everything running. One team, one plan, one point of contact.',
    trust: ['Free consultation', 'Fixed-price quotes', 'Reply within 1 business day'],
    stage: {
      build: { label: 'Build', title: 'New website live' },
      grow: { label: 'Grow', title: 'Organic traffic', meta: 'Last 6 months' },
      protect: { label: 'Protect', title: 'Security check passed', checks: ['SSL', 'Backups', 'Updates'] },
    },
    servicesEyebrow: 'Services',
    servicesTitle: 'Everything your business needs online, under one roof.',
    servicesText:
      'Most businesses juggle a web designer, a marketing freelancer and an IT person. We bring it together, so your website, marketing and security work as one.',
    whyEyebrow: 'Why Marketixo',
    whyTitle: 'An agency that thinks in results, not deliverables.',
    why: {
      team: {
        title: 'One team for everything',
        text: 'Design, marketing and tech under one roof. No finger-pointing between agencies, one person who knows your project.',
        chips: ['Design', 'Marketing', 'Tech'],
        badge: 'One point of contact',
      },
      fast: {
        title: 'Fast & built to rank',
        text: 'Every site is fast, mobile-first and SEO-ready from day one.',
        score: 'Mobile performance',
      },
      price: {
        title: 'Clear, fixed quotes',
        text: 'You know what you pay before we start. No hourly surprises.',
        lines: ['Website design', 'SEO setup', 'Launch & training'],
        stamp: 'Fixed price',
      },
      secure: {
        title: 'Security built in',
        text: 'With in-house cybersecurity and QA, what we build is tested and protected, not just pretty.',
        rows: [
          ['SSL certificate', 'Active'],
          ['Daily backups', 'Up to date'],
          ['Software updates', 'Installed'],
          ['Vulnerability scan', 'Passed'],
        ],
      },
    },
    processEyebrow: 'How we work',
    processTitle: 'From first call to measurable results in four steps.',
    process: [
      { when: '20 min', title: 'Free intro call', text: 'We get to know your business, goals and budget.' },
      { when: '48 h', title: 'Plan & fixed quote', text: 'A clear proposal with scope, timeline and price.' },
      { when: 'Milestones', title: 'Build & launch', text: 'We design, build and test, with check-ins at every step.' },
      { when: 'Ongoing', title: 'Measure & improve', text: 'We track what matters and keep improving after launch.' },
    ],
    workEyebrow: 'Recent work',
    workTitle: 'Brands we’ve worked with',
    clientsHint: 'Hover over a logo to see what we did.',
    testimonialsTitle: 'What clients say',
    faq: [
      { q: 'How much does a website or marketing project cost?', a: 'Every business is different, so we give you a fixed price after a short call. Small business websites typically start in the low four figures; ongoing marketing is a monthly package. You always know the price before we start.' },
      { q: 'Do you work with clients in Germany, Austria and Switzerland?', a: 'Yes. We work remotely with clients across Europe, in English and German, and we optimise for each market separately.' },
      { q: 'Can I hire you for just one service?', a: 'Absolutely. Many clients start with one thing, like a new website or an SEO audit, and add more later.' },
      { q: 'How quickly do you respond?', a: 'Within one business day. On WhatsApp usually much faster.' },
    ],
  },
  de: {
    title: 'Marketixo — Agentur für Webdesign, SEO & Online-Marketing',
    description:
      'Marketixo entwickelt Websites, Marken und Marketing, die Kunden bringen — plus Cybersecurity und Softwaretests, damit alles läuft. Angebot innerhalb von 24 h.',
    eyebrow: 'Digitalagentur · Deutsch & English',
    h1: ['Websites und Marketing, die Ihnen ', 'Kunden bringen', '.'],
    lead: 'Design, SEO, Werbung und Social Media — plus Sicherheit und Tests, damit alles zuverlässig läuft. Ein Team, ein Plan, ein Ansprechpartner.',
    trust: ['Kostenlose Erstberatung', 'Festpreisangebote', 'Antwort innerhalb eines Werktags'],
    stage: {
      build: { label: 'Aufbauen', title: 'Website ist live' },
      grow: { label: 'Wachsen', title: 'Organischer Traffic', meta: 'Letzte 6 Monate' },
      protect: { label: 'Schützen', title: 'Sicherheitscheck bestanden', checks: ['SSL', 'Backups', 'Updates'] },
    },
    servicesEyebrow: 'Leistungen',
    servicesTitle: 'Alles, was Ihr Unternehmen online braucht — aus einer Hand.',
    servicesText:
      'Die meisten Unternehmen jonglieren mit Webdesigner, Marketing-Freelancer und IT-Dienstleister. Wir bringen alles zusammen, damit Website, Marketing und Sicherheit als Einheit funktionieren.',
    whyEyebrow: 'Warum Marketixo',
    whyTitle: 'Eine Agentur, die in Ergebnissen denkt — nicht in Leistungspaketen.',
    why: {
      team: {
        title: 'Ein Team für alles',
        text: 'Design, Marketing und Technik aus einer Hand. Kein Hin und Her zwischen Agenturen, ein Ansprechpartner, der Ihr Projekt kennt.',
        chips: ['Design', 'Marketing', 'Technik'],
        badge: 'Ein Ansprechpartner',
      },
      fast: {
        title: 'Schnell & rankingstark',
        text: 'Jede Website ist schnell, mobiloptimiert und ab Tag eins SEO-fertig.',
        score: 'Mobile Performance',
      },
      price: {
        title: 'Klare Festpreise',
        text: 'Sie wissen vorher, was Sie zahlen. Keine Stundenüberraschungen.',
        lines: ['Webdesign', 'SEO-Einrichtung', 'Launch & Einweisung'],
        stamp: 'Festpreis',
      },
      secure: {
        title: 'Sicherheit inklusive',
        text: 'Mit eigener Cybersecurity und Qualitätssicherung ist alles, was wir bauen, getestet und geschützt — nicht nur schön.',
        rows: [
          ['SSL-Zertifikat', 'Aktiv'],
          ['Tägliche Backups', 'Aktuell'],
          ['Software-Updates', 'Installiert'],
          ['Schwachstellen-Scan', 'Bestanden'],
        ],
      },
    },
    processEyebrow: 'So arbeiten wir',
    processTitle: 'Vom ersten Gespräch zu messbaren Ergebnissen in vier Schritten.',
    process: [
      { when: '20 Min.', title: 'Kostenloses Erstgespräch', text: 'Wir lernen Ihr Unternehmen, Ihre Ziele und Ihr Budget kennen.' },
      { when: '48 h', title: 'Plan & Festpreis', text: 'Ein klares Angebot mit Umfang, Zeitplan und Preis.' },
      { when: 'Meilensteine', title: 'Umsetzung & Launch', text: 'Wir gestalten, entwickeln und testen — mit Abstimmung bei jedem Schritt.' },
      { when: 'Laufend', title: 'Messen & verbessern', text: 'Wir messen, was zählt, und optimieren nach dem Launch weiter.' },
    ],
    workEyebrow: 'Aktuelle Projekte',
    workTitle: 'Marken, mit denen wir arbeiten',
    clientsHint: 'Fahren Sie über ein Logo, um zu sehen, was wir gemacht haben.',
    testimonialsTitle: 'Das sagen unsere Kunden',
    faq: [
      { q: 'Was kostet eine Website oder ein Marketingprojekt?', a: 'Jedes Unternehmen ist anders, deshalb erhalten Sie nach einem kurzen Gespräch einen Festpreis. Websites für kleine Unternehmen beginnen meist im niedrigen vierstelligen Bereich; laufendes Marketing ist ein Monatspaket. Den Preis kennen Sie immer, bevor wir starten.' },
      { q: 'Arbeiten Sie mit Kunden in Deutschland, Österreich und der Schweiz?', a: 'Ja. Wir arbeiten remote mit Kunden in ganz Europa, auf Deutsch und Englisch, und optimieren für jeden Markt separat.' },
      { q: 'Kann ich auch nur eine Leistung buchen?', a: 'Selbstverständlich. Viele Kunden starten mit einem Projekt, etwa einer neuen Website oder einem SEO-Audit, und erweitern später.' },
      { q: 'Wie schnell antworten Sie?', a: 'Innerhalb eines Werktags. Per WhatsApp meist deutlich schneller.' },
    ],
  },
}[lang];
const why = copy.why;
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  alternates={alternates}
  appendSiteName={false}
  noindex={preview}
  schema={[faqSchema(copy.faq)]}
>
  <!-- Hero: centred headline, then the Build / Grow / Protect stage -->
  <section class="hero">
    <div class="container hero__copy">
      <span class="hero__pill">{copy.eyebrow}</span>
      <h1>
        {copy.h1[0]}<span class="hero__hl">{copy.h1[1]}<svg viewBox="0 0 300 14" preserveAspectRatio="none" aria-hidden="true"><path d="M3 10 C60 3 140 2 297 7"></path></svg></span>{copy.h1[2]}
      </h1>
      <p class="lead">{copy.lead}</p>
      <div class="btn-row hero__ctas">
        <a href={url('contact', lang) + '#quote'} class="btn btn--signal">
          {s.cta.quote}
          <Icon name="arrow" class="arrow" />
        </a>
        <a href={whatsappLink(s.whatsappText)} class="btn btn--ghost" target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          {s.cta.whatsapp}
        </a>
      </div>
      <ul class="hero__trust">
        {copy.trust.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="container">
      <div class="stage" aria-hidden="true">
        <div class="scard scard--build">
          <span class="scard__label">{copy.stage.build.label}</span>
          <div class="scard__browser">
            <div class="scard__dots"><i></i><i></i><i></i></div>
            <div class="scard__page">
              <span class="w75 dark"></span>
              <span class="w90"></span>
              <span class="w60"></span>
              <span class="pill"></span>
            </div>
          </div>
          <div class="scard__foot">
            <strong>{copy.stage.build.title}</strong>
            <span class="scard__score">98</span>
          </div>
        </div>

        <div class="scard scard--grow">
          <span class="scard__label">{copy.stage.grow.label}</span>
          <strong>{copy.stage.grow.title}</strong>
          <small>{copy.stage.grow.meta}</small>
          <svg viewBox="0 0 240 110" class="scard__chart" preserveAspectRatio="none">
            <defs>
              <linearGradient id="g2" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#0E9F6E" stop-opacity="0.28"></stop>
                <stop offset="1" stop-color="#0E9F6E" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
            <path d="M0 100 C30 96 45 88 70 82 S110 74 130 60 S170 44 190 30 S225 12 240 6 V110 H0Z" fill="url(#g2)"></path>
            <path d="M0 100 C30 96 45 88 70 82 S110 74 130 60 S170 44 190 30 S225 12 240 6" fill="none" stroke="#0E9F6E" stroke-width="3" stroke-linecap="round"></path>
          </svg>
        </div>

        <div class="scard scard--protect">
          <span class="scard__label">{copy.stage.protect.label}</span>
          <div class="scard__shieldrow">
            <span class="scard__shield"><Icon name="shield" size={22} /></span>
            <strong>{copy.stage.protect.title}</strong>
          </div>
          <ul class="scard__checks">
            {copy.stage.protect.checks.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <span class="eyebrow">{copy.servicesEyebrow}</span>
          <h2 style="margin-top:1rem">{copy.servicesTitle}</h2>
        </div>
        <p class="lead">{copy.servicesText}</p>
      </div>

      <ServiceExplorer lang={lang} />
    </div>
  </section>

  <!-- Why: bento grid -->
  <section class="section section--white">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{copy.whyEyebrow}</span>
        <h2>{copy.whyTitle}</h2>
      </div>

      <div class="bento">
        <article class="bento__card bento__card--team reveal">
          <div class="bento__visual" aria-hidden="true">
            <div class="merge">
              <ul class="merge__chips">
                <li><Icon name="pen" size={16} />{why.team.chips[0]}</li>
                <li><Icon name="chart" size={16} />{why.team.chips[1]}</li>
                <li><Icon name="shield" size={16} />{why.team.chips[2]}</li>
              </ul>
              <span class="merge__bracket"></span>
              <span class="merge__badge"><Logo markOnly />{why.team.badge}</span>
            </div>
          </div>
          <h3>{why.team.title}</h3>
          <p>{why.team.text}</p>
        </article>

        <article class="bento__card reveal" style="transition-delay:80ms">
          <div class="bento__visual" aria-hidden="true">
            <div class="ring">
              <svg viewBox="0 0 120 120">
                <circle cx="60" cy="60" r="50" class="ring__track"></circle>
                <circle cx="60" cy="60" r="50" class="ring__value" pathLength="100" stroke-dasharray="98 100"></circle>
              </svg>
              <span class="ring__num">98</span>
            </div>
            <span class="bento__caption">{why.fast.score}</span>
          </div>
          <h3>{why.fast.title}</h3>
          <p>{why.fast.text}</p>
        </article>

        <article class="bento__card reveal">
          <div class="bento__visual" aria-hidden="true">
            <div class="quote-doc">
              {why.price.lines.map((line) => (
                <div class="quote-doc__line">
                  <span>{line}</span>
                  <i></i>
                  <Icon name="check" size={18} />
                </div>
              ))}
              <span class="quote-doc__stamp">{why.price.stamp}</span>
            </div>
          </div>
          <h3>{why.price.title}</h3>
          <p>{why.price.text}</p>
        </article>

        <article class="bento__card bento__card--secure reveal" style="transition-delay:80ms">
          <div class="bento__visual" aria-hidden="true">
            <ul class="status">
              {why.secure.rows.map(([label, state]) => (
                <li>
                  <span>{label}</span>
                  <span class="status__ok">{state}</span>
                </li>
              ))}
            </ul>
          </div>
          <h3>{why.secure.title}</h3>
          <p>{why.secure.text}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{copy.processEyebrow}</span>
        <h2>{copy.processTitle}</h2>
      </div>
      <ol class="steps reveal">
        {
          copy.process.map((step, i) => (
            <li class="steps__item">
              <div class="steps__top">
                <span class="steps__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="steps__when">{step.when}</span>
              </div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Work -->
  <section class="section section--white">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <span class="eyebrow">{copy.workEyebrow}</span>
          <h2 style="margin-top:1rem">{copy.workTitle}</h2>
        </div>
        <div class="work-aside">
          <p class="work-hint">{copy.clientsHint}</p>
          <a href={url('work', lang)} class="link-arrow">{s.cta.allWork} <Icon name="arrow" /></a>
        </div>
      </div>
      <LogoGrid lang={lang} withCta />
    </div>
  </section>

  {
    testimonials.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <h2>{copy.testimonialsTitle}</h2>
          </div>
          <div class="grid grid--3">
            {testimonials.map((item) => (
              <figure class="card quote-card reveal">
                <blockquote>“{item.quote[lang]}”</blockquote>
                <figcaption>
                  <strong>{item.name}</strong>
                  <span>{item.role}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <Faq title={s.faqTitle} items={copy.faq} />
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 7vw, 88px) clamp(56px, 8vw, 104px);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, rgb(13 15 20 / 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(13 15 20 / 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 25%, #000 25%, transparent 75%);
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hero__pill::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--grow);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--grow) 18%, transparent);
  }
  .hero h1 {
    max-width: 18ch;
    margin: 1.5rem 0 1.5rem;
  }
  :global(html[lang='de']) .hero h1 {
    max-width: 20ch;
    font-size: clamp(2.3rem, 5.6vw, 4.4rem);
  }
  .hero__hl {
    position: relative;
    white-space: nowrap;
    color: var(--signal);
  }
  .hero__hl svg {
    position: absolute;
    left: 0;
    bottom: -0.12em;
    width: 100%;
    height: 0.22em;
    overflow: visible;
  }
  .hero__hl path {
    fill: none;
    stroke: currentColor;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 320;
    stroke-dashoffset: 320;
    animation: draw 1s 0.4s var(--ease) forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__hl path {
      stroke-dashoffset: 0;
    }
  }
  .hero .lead {
    max-width: 620px;
    margin-bottom: 2rem;
  }
  .hero__ctas {
    justify-content: center;
  }
  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hero__trust li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--grow);
  }

  /* Stage: three cards side by side */
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: center;
    max-width: 1040px;
    margin: clamp(48px, 7vw, 80px) auto 0;
  }
  .stage::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 10% 15% -10%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 90 31 / 0.16), rgb(255 90 31 / 0));
  }
  .scard {
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--white);
    box-shadow: var(--shadow-lg);
  }
  .scard strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .scard small {
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .scard__label {
    display: inline-block;
    margin-bottom: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: color-mix(in srgb, var(--accent) 12%, white);
    color: var(--accent);
  }
  .scard--build {
    --accent: var(--build);
    rotate: -2deg;
  }
  .scard--grow {
    --accent: var(--grow);
    position: relative;
    z-index: 1;
    padding: 24px;
    translate: 0 -16px;
  }
  .scard--protect {
    --accent: var(--protect);
    rotate: 2deg;
  }
  .scard__browser {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper);
  }
  .scard__dots {
    display: flex;
    gap: 5px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--line);
    background: var(--white);
  }
  .scard__dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line);
  }
  .scard__page {
    display: grid;
    gap: 8px;
    padding: 16px 14px 18px;
  }
  .scard__page span {
    height: 8px;
    border-radius: 6px;
    background: var(--line);
  }
  .scard__page .dark {
    height: 13px;
    background: var(--ink);
  }
  .scard__page .w75 {
    width: 75%;
  }
  .scard__page .w90 {
    width: 90%;
  }
  .scard__page .w60 {
    width: 60%;
  }
  .scard__page .pill {
    width: 36%;
    height: 18px;
    margin-top: 4px;
    border-radius: 99px;
    background: var(--signal);
  }
  .scard__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 14px;
  }
  .scard__score {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
