---
import '~/styles/global.css';
import { Font } from 'astro:assets';
import Seo from '~/components/Seo.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import CookieConsent from '~/components/CookieConsent.astro';
import { site } from '~/config/site';
import { useT, type Lang } from '~/i18n';
import type { PageEntry } from '~/lib/pages';
import { graph, organization, website } from '~/lib/schema';

interface Props {
  page: Pick<PageEntry, 'lang' | 'path' | 'alternates' | 'kind' | 'noindex'>;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  article?: { published: Date; modified?: Date; author: string; section?: string; tags?: string[] };
  canonical?: string;
  /** Page-specific JSON-LD nodes; Organization + WebSite are always added. */
  schema?: object[];
  /** Pages that open on a light section can ask for a dark-on-light header. */
  bodyClass?: string;
}

const { page, title, description, image, imageAlt, type, article, canonical, schema = [], bodyClass } = Astro.props;
const lang: Lang = page.lang;
const t = useT(lang);
const jsonLd = graph(organization(lang), website(lang, t.meta.defaultDescription), ...schema);
const xDefault = page.kind === 'home' ? '/' : undefined;
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Enables reveal animations; falls back to fully visible content if scripts don't run. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      setTimeout(function () { if (!window.__mxReveal) document.documentElement.classList.remove('js'); }, 2500);
    </script>
    <Font cssVariable="--font-sans" preload={[{ subset: 'latin', weight: '300 800' }]} />
    <Font cssVariable="--font-mono" />
    <Seo
      lang={lang}
      title={title}
      description={description}
      path={page.path}
      alternates={page.alternates}
      xDefault={xDefault}
      noindex={page.noindex}
      image={image}
      imageAlt={imageAlt}
      type={type}
      article={article}
      canonical={canonical}
      jsonLd={jsonLd}
    />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="dark light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    {page.kind === 'insights' && <link rel="alternate" type="application/rss+xml" title={`${site.name} — ${t.nav.insights}`} href={`/${lang}/rss.xml`} />}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header page={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer page={page} />
    <CookieConsent lang={lang} />
    <script>
      import { initReveal } from '~/scripts/reveal';
      initReveal();
    </script>
  </body>
</html>
