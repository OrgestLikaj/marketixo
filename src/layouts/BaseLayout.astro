---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import WhatsAppButton from '~/components/WhatsAppButton.astro';
import { site } from '~/config/site';
import { defaultLang, localeMeta, t, type Alternates, type Lang } from '~/i18n/ui';
import { organizationSchema } from '~/lib/schema';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** URLs of this page in every available language (used for hreflang + switcher). */
  alternates: Alternates;
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Set to false to use the title exactly as given (e.g. on the home page). */
  appendSiteName?: boolean;
}

const {
  lang,
  title,
  description,
  alternates,
  schema = [],
  ogImage = '/og.png',
  ogType = 'website',
  noindex = false,
  appendSiteName = true,
} = Astro.props;

const s = t(lang);
const fullTitle = appendSiteName ? `${title} | ${site.name}` : title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const abs = (path: string) => new URL(path, Astro.site).href;
const hreflangs = Object.entries(alternates) as [Lang, string][];
const jsonLd = [organizationSchema(lang), ...schema];
---

<!doctype html>
<html lang={localeMeta[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {hreflangs.map(([l, href]) => <link rel="alternate" hreflang={l} href={abs(href)} />)}
    {alternates[defaultLang] && <link rel="alternate" hreflang="x-default" href={abs(alternates[defaultLang]!)} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={localeMeta[lang].ogLocale} />
    {
      hreflangs
        .filter(([l]) => l !== lang)
        .map(([l]) => <meta property="og:locale:alternate" content={localeMeta[l].ogLocale} />)
    }
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0d0f14" />
    <link rel="sitemap" href="/sitemap.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd.length === 1 ? jsonLd[0] : { '@context': 'https://schema.org', '@graph': jsonLd.map(({ '@context': _, ...rest }) => rest) })} />
  </head>
  <body>
    <a class="skip-link" href="#main">{s.skip}</a>
    <Header lang={lang} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppButton lang={lang} />

    <script>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100px;
    left: 16px;
    z-index: 100;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    background: var(--ink);
    color: var(--white);
    text-decoration: none;
  }
  .skip-link:focus {
    top: 16px;
  }
</style>
