---
/**
 * Grid of client logos. At rest only the logo shows, in colour on white. On hover or keyboard
 * focus the tile turns dark grey, the logo becomes a white mark, and the client's name, what we
 * did and a link to the work appear. Touch screens (no hover) show the name under the logo.
 */
import Icon from './Icon.astro';
import { allClients, type Client } from '~/data/work';
import { t, url, type Lang } from '~/i18n/ui';
import { logoFor } from '~/lib/assets';
import { serviceShort } from '~/lib/work';

interface Props {
  lang: Lang;
  clients?: Client[];
  /** Columns on large screens (tablets use up to 4, phones 2). */
  cols?: number;
  /** Adds a closing "Your brand next?" tile. */
  withCta?: boolean;
}
const { lang, clients = allClients, cols = 5, withCta = false } = Astro.props;
const s = t(lang);
const viewWork = lang === 'de' ? 'Projekt ansehen' : 'View work';
const cta = {
  en: { title: 'Your brand next?', text: 'Get a free quote' },
  de: { title: 'Ihre Marke als Nächstes?', text: 'Kostenloses Angebot' },
}[lang];

const tiles = clients.map((c) => ({
  ...c,
  src: logoFor(c.key, c.logo),
  did: (c.services ?? []).map((k) => serviceShort(k, lang)).join(' · '),
}));
const total = tiles.length + (withCta ? 1 : 0);
---

<ul class="lg" style={`--cols-lg:${cols};--cols-md:${Math.min(cols, 4)}`} data-odd={total % 2 === 1 ? '' : undefined}>
  {
    tiles.map((c) => {
      const Tag = c.url ? 'a' : 'div';
      const linkProps = c.url ? { href: c.url, target: '_blank', rel: 'noopener' } : { tabindex: 0 };
      return (
        <li>
          <Tag class="lg__tile" {...linkProps} aria-label={c.url ? `${c.client}: ${viewWork}` : undefined}>
            <span class="lg__logo">
              {c.src ? <img src={c.src} alt="" loading="lazy" decoding="async" /> : <b>{c.client}</b>}
            </span>
            <span class="lg__info">
              <strong>{c.client}</strong>
              {c.did && <span class="lg__did">{c.did}</span>}
              {c.url && (
                <span class="lg__link">
                  {viewWork} <Icon name="arrow-up-right" size={14} />
                </span>
              )}
            </span>
            <span class="lg__caption" aria-hidden="true">
              {c.client}
            </span>
          </Tag>
        </li>
      );
    })
  }
  {
    withCta && (
      <li>
        <a class="lg__tile lg__tile--cta" href={url('contact', lang) + '#quote'}>
          <span class="lg__cta">
            <strong>{cta.title}</strong>
            <span>
              {cta.text} <Icon name="arrow" size={14} />
            </span>
          </span>
        </a>
      </li>
    )
  }
</ul>

<style>
  .lg {
    --tile-bg: var(--white);
    --hover-bg: #23262e;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(8px, 1.2vw, 14px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 640px) {
    .lg {
      grid-template-columns: repeat(var(--cols-md), minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .lg {
      grid-template-columns: repeat(var(--cols-lg), minmax(0, 1fr));
    }
  }
  /* Phones: an odd last tile spans both columns so the grid ends evenly. */
  @media (max-width: 639px) {
    .lg .lg__tile {
      aspect-ratio: 3 / 2;
    }
    .lg[data-odd] > li:last-child {
      grid-column: span 2;
    }
    .lg[data-odd] > li:last-child .lg__tile {
      aspect-ratio: 3 / 1;
    }
  }

  .lg__tile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    max-width: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--tile-bg);
    color: var(--white);
    text-decoration: none;
    outline-offset: 3px;
    transition:
      background-color 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }

  /* Logo: fits a fixed box, in colour at rest. */
  .lg__logo {
    position: absolute;
    inset: 0;
    transition: transform 0.45s var(--ease);
  }
  .lg__logo img {
    position: absolute;
    top: 18%;
    left: 15%;
    width: 70%;
    height: 64%;
    object-fit: contain;
    mix-blend-mode: multiply;
    transition:
      filter 0.35s var(--ease),
      opacity 0.35s var(--ease);
  }
  .lg__logo b {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0 10%;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.05rem;
    text-align: center;
  }

  /* Details, revealed on hover / focus. */
  .lg__info {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 0.2rem;
    padding: 0 14px 12px;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.3s var(--ease),
      transform 0.35s var(--ease);
  }
  .lg__info strong {
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 0.95rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .lg__did {
    display: -webkit-box;
    overflow: hidden;
    color: rgb(255 255 255 / 0.62);
    font-size: 0.75rem;
    line-height: 1.35;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .lg__link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.2rem;
    color: #ff8a5c;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 500;
  }
  .lg__caption {
    display: none;
  }

  @media (hover: hover) {
    .lg__tile:hover,
    .lg__tile:focus-visible {
      border-color: var(--hover-bg);
      background: var(--hover-bg);
    }
    .lg__tile:hover .lg__logo,
    .lg__tile:focus-visible .lg__logo {
      transform: translateY(-27%) scale(0.5);
    }
    .lg__tile:hover .lg__logo img,
    .lg__tile:focus-visible .lg__logo img {
      mix-blend-mode: normal;
      filter: brightness(0) invert(1);
      opacity: 0.9;
    }
    .lg__tile:hover .lg__logo b,
    .lg__tile:focus-visible .lg__logo b {
      color: var(--white);
    }
    .lg__tile:hover .lg__info,
    .lg__tile:focus-visible .lg__info {
      opacity: 1;
      transform: none;
    }
  }
  /* Keyboard users on touch-first devices still get the details. */
  .lg__tile:focus-visible {
    border-color: var(--hover-bg);
    background: var(--hover-bg);
  }
  .lg__tile:focus-visible .lg__info {
    opacity: 1;
    transform: none;
  }

  /* Touch screens: no hover, so show the name under the logo. */
  @media (hover: none) {
    .lg__logo img {
      top: 12%;
      height: 54%;
    }
    .lg__caption {
      position: absolute;
      inset: auto 0 9%;
      display: block;
      overflow: hidden;
      padding: 0 10px;
      color: var(--muted);
      font-size: 0.75rem;
      text-align: center;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .lg__tile:focus-visible .lg__caption {
      display: none;
    }
  }

  /* Closing call-to-action tile */
  .lg__tile--cta {
    border-style: dashed;
    border-color: color-mix(in srgb, var(--ink) 28%, transparent);
    background: transparent;
    color: var(--ink);
  }
  .lg__cta {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.35rem;
    padding: 0 12px;
    text-align: center;
  }
  .lg__cta strong {
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.2;
  }
  .lg__cta span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--signal-dark);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .lg__tile--cta:hover,
  .lg__tile--cta:focus-visible {
    border-style: solid;
    border-color: var(--signal);
    background: var(--signal);
    color: var(--white);
  }
  .lg__tile--cta:hover .lg__cta span,
  .lg__tile--cta:focus-visible .lg__cta span {
    color: var(--white);
  }
</style>
