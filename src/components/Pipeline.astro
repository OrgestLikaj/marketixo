---
/**
 * Brand → Website → Traffic → Conversion → Security → Quality.
 * Drawn like a CI pipeline: every stage is owned by the same team.
 */
interface Props {
  steps: { title: string; text: string }[];
  status?: string;
}
const { steps, status } = Astro.props;
---

<div class="pl" data-reveal>
  <ol class="pl__list" role="list">
    {
      steps.map((step, i) => (
        <li class="pl__step" style={`--i:${i}`}>
          <div class="pl__node" aria-hidden="true">
            <span class="pl__dot" />
          </div>
          <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="pl__title">{step.title}</h3>
          <p class="pl__text">{step.text}</p>
        </li>
      ))
    }
  </ol>
  {
    status && (
      <p class="pl__status mono" aria-hidden="true">
        <span class="pl__ok">●</span> {status}
      </p>
    )
  }
</div>

<style>
  .pl {
    position: relative;
  }
  .pl__list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }
  .pl__list::before,
  .pl__list::after {
    content: '';
    position: absolute;
    top: 11px;
    left: 11px;
    right: 0;
    height: 1px;
  }
  .pl__list::before {
    background: var(--line-strong);
  }
  .pl__list::after {
    background: linear-gradient(90deg, var(--dark-cyan), var(--pearl-aqua) 70%, var(--golden-orange));
    transform-origin: left;
  }
  .pl__step {
    position: relative;
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .pl__node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 23px;
    height: 23px;
    margin-bottom: 1rem;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--pearl-aqua);
  }
  .pl__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--pearl-aqua);
  }
  .pl__step:last-child .pl__node {
    border-color: var(--golden-orange);
  }
  .pl__step:last-child .pl__dot {
    background: var(--golden-orange);
  }
  .pl__title {
    font-size: 1.375rem;
    letter-spacing: -0.03em;
  }
  .pl__text {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .pl__status {
    margin-top: 2.5rem;
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  .pl__ok {
    color: #5fd3a6;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .pl .pl__list::after {
      transform: scaleX(0);
      transition: transform 2.2s var(--ease-out) 0.2s;
    }
    :global(.js) .pl.is-in .pl__list::after {
      transform: scaleX(1);
    }
    :global(.js) .pl .pl__node {
      opacity: 0;
      transform: scale(0.4);
      transition:
        transform 500ms var(--ease-out),
        opacity 500ms var(--ease-out);
      transition-delay: calc(var(--i) * 300ms + 300ms);
    }
    :global(.js) .pl.is-in .pl__node {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 1023px) {
    .pl__list {
      grid-template-columns: 1fr;
      gap: 0;
      padding-left: 2.75rem;
    }
    .pl__list::before,
    .pl__list::after {
      top: 0;
      bottom: 0;
      left: 11px;
      right: auto;
      width: 1px;
      height: auto;
    }
    .pl__list::after {
      background: linear-gradient(180deg, var(--dark-cyan), var(--pearl-aqua) 70%, var(--golden-orange));
      transform-origin: top;
    }
    :global(.js) .pl .pl__list::after {
      transform: scaleY(0);
    }
    :global(.js) .pl.is-in .pl__list::after {
      transform: scaleY(1);
    }
    .pl__step {
      padding-bottom: 2rem;
    }
    .pl__node {
      position: absolute;
      left: -2.75rem;
      top: 0;
      margin: 0;
    }
  }
</style>
