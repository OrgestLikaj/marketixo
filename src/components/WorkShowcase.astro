---
import Icon from './Icon.astro';
import type { Project } from '~/data/work';
import type { Lang } from '~/i18n/ui';
import { logoFor, screenshotFor } from '~/lib/assets';
import { projectLink, projectServices } from '~/lib/work';

/** One large row per project, alternating sides — reads like a set of case studies. */
interface Props {
  projects: Project[];
  lang: Lang;
}
const { projects, lang } = Astro.props;
const copy = {
  en: { did: 'What we did', website: 'Visit website', profile: 'View profile' },
  de: { did: 'Unsere Leistungen', website: 'Website ansehen', profile: 'Profil ansehen' },
}[lang];
const total = String(projects.length).padStart(2, '0');
/** "Medicus Center" → "MC", "IR" → "IR", "Finman" → "F". */
const monogram = (name: string) => {
  const words = name.split(/\s+/);
  if (words.length > 1) return words.slice(0, 2).map((w) => w[0].toUpperCase()).join('');
  return name.length <= 3 ? name : name[0].toUpperCase();
};
---

<ol class="showcase">
  {
    projects.map((p, i) => {
      const link = projectLink(p);
      const logo = logoFor(p.key, p.logo);
      const image = screenshotFor(p.key, p.image);
      return (
        <li class="sc reveal" style={`--c:${p.color}`}>
          <a class="sc__visual" href={link?.href} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
            <span class="sc__big">{p.client}</span>
            {image ? (
              <span class="sc__shot">
                <img src={image} alt="" loading="lazy" decoding="async" width="1440" height="900" />
              </span>
            ) : (
              <span class="sc__badge">{logo ? <img src={logo} alt="" /> : monogram(p.client)}</span>
            )}
          </a>
          <div class="sc__text">
            <span class="sc__count">
              {String(i + 1).padStart(2, '0')} <span>/ {total}</span>
            </span>
            <h3>{p.client}</h3>
            <p class="sc__summary">{p.summary[lang]}</p>
            {p.result && <p class="sc__result">{p.result[lang]}</p>}
            <p class="sc__label">{copy.did}</p>
            <ul class="sc__services">
              {projectServices(p, lang).map((s) => (
                <li>
                  <Icon name={s.icon} size={18} />
                  {s.title}
                </li>
              ))}
            </ul>
            {link && (
              <a class="sc__cta" href={link.href} target="_blank" rel="noopener">
                {p.url ? copy.website : copy.profile}
                <span>{link.label}</span>
                <Icon name="arrow-up-right" size={18} />
              </a>
            )}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .showcase {
    display: grid;
    gap: clamp(56px, 8vw, 120px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sc {
    display: grid;
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
  }
  @media (min-width: 900px) {
    .sc {
      grid-template-columns: 1.25fr 1fr;
    }
    .sc:nth-child(even) .sc__visual {
      order: 2;
    }
  }

  /* Visual: a brand-colour panel with the client name set huge behind a badge or screenshot */
  .sc__visual {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(100% 80% at 0% 0%, color-mix(in srgb, var(--c) 50%, white) 0%, transparent 60%),
      var(--c);
    text-decoration: none;
  }
  .sc__big {
    position: absolute;
    left: -0.04em;
    bottom: -0.2em;
    max-width: 100%;
    font-family: var(--font-display);
    font-size: clamp(5rem, 15vw, 12rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.06em;
    white-space: nowrap;
    color: rgb(255 255 255 / 0.14);
    transition: transform 1.2s var(--ease);
  }
  .sc__visual:hover .sc__big {
    transform: translateX(-4%);
  }
  .sc__badge {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(120px, 16vw, 180px);
    aspect-ratio: 1;
    border-radius: 32%;
    background: var(--white);
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.25);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    color: var(--c);
    transition: transform 0.6s var(--ease);
  }
  .sc__badge img {
    width: 70%;
    height: 70%;
    object-fit: contain;
  }
  .sc__visual:hover .sc__badge {
    transform: translateY(-8px) rotate(-4deg);
  }
  .sc__shot {
    position: relative;
    width: 82%;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.3);
    transition: transform 0.6s var(--ease);
  }
  .sc__shot img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }
  .sc__visual:hover .sc__shot {
    transform: translateY(-8px);
  }

  /* Text */
  .sc__count {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--c);
  }
  .sc__count span {
    color: var(--muted);
  }
  .sc h3 {
    margin: 0.5rem 0 1rem;
    font-size: clamp(2.25rem, 4.4vw, 3.5rem);
    letter-spacing: -0.04em;
  }
  .sc__summary {
    max-width: 46ch;
    color: var(--muted);
  }
  .sc__result {
    font-weight: 600;
    color: var(--signal-dark);
  }
  .sc__label {
    margin: 1.75rem 0 0.75rem;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sc__services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.975rem;
  }
  .sc__services li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .sc__services :global(svg) {
    flex: none;
    color: var(--c);
  }
  .sc__cta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    margin-top: 2rem;
    padding-bottom: 0.3rem;
    border-bottom: 2px solid var(--c);
    font-family: var(--font-display);
    font-weight: 500;
    text-decoration: none;
  }
  .sc__cta span {
    color: var(--muted);
    font-weight: 400;
  }
  .sc__cta :global(svg) {
    transition: transform 0.2s var(--ease);
  }
  .sc__cta:hover :global(svg) {
    transform: translate(2px, -2px);
  }
</style>
