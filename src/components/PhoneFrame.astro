---
/** A slim phone outline around a real mobile screenshot. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
  /** Forwarded attributes (incl. the parent's scoped-style id). */
  [key: string]: unknown;
}
const { src, alt, sizes = '(min-width: 1024px) 280px, 45vw', loading = 'lazy', class: className , ...rest } = Astro.props;
---

<figure {...rest} class:list={['pf', className]}>
  <div class="pf__screen">
    <Image src={src} alt={alt} widths={[240, 360, 480, 720]} sizes={sizes} loading={loading} decoding="async" class="pf__img" layout="none" />
  </div>
</figure>

<style>
  .pf {
    margin: 0;
    padding: 8px;
    border-radius: 34px;
    background: linear-gradient(160deg, #123c48, #04202a);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-lg);
    aspect-ratio: 390 / 844;
  }
  .pf__screen {
    position: relative;
    height: 100%;
    border-radius: 27px;
    overflow: hidden;
    background: #fff;
  }
  .pf__screen::before {
    content: '';
    position: absolute;
    top: 8px;
    left: 50%;
    width: 30%;
    height: 18px;
    translate: -50% 0;
    border-radius: 999px;
    background: #000;
    z-index: 1;
  }
  .pf__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
</style>
