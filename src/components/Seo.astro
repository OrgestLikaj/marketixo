---
/**
 * Everything search engines and social networks read: title, description,
 * canonical, hreflang (+ x-default), Open Graph, X/Twitter card and JSON-LD.
 */
import { site } from '~/config/site';
import { languageMeta, locales, type Lang } from '~/i18n/config';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  alternates: Partial<Record<Lang, string>>;
  /** x-default target; defaults to the English alternate. */
  xDefault?: string;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  article?: { published: Date; modified?: Date; author: string; section?: string; tags?: string[] };
  canonical?: string;
  jsonLd?: object;
}

const { lang, title, description, path, alternates, xDefault, noindex, image, imageAlt, type = 'website', article, canonical, jsonLd } = Astro.props;
const abs = (p: string) => new URL(p, site.url).href;
const canonicalUrl = canonical ?? abs(path);
const ogImage = abs(image ?? site.ogImage);
const robots = noindex || site.noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1';
const hreflangs = locales.filter((l) => alternates[l]).map((l) => ({ hreflang: languageMeta[l].hreflang, href: abs(alternates[l]!) }));
const xDefaultHref = xDefault ? abs(xDefault) : alternates.en ? abs(alternates.en) : undefined;
const otherLocales = locales.filter((l) => l !== lang && alternates[l]).map((l) => languageMeta[l].ogLocale);
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalUrl} />
{!noindex && hreflangs.map((h) => <link rel="alternate" hreflang={h.hreflang} href={h.href} />)}
{!noindex && xDefaultHref && hreflangs.length > 1 && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt ?? title} />
<meta property="og:locale" content={languageMeta[lang].ogLocale} />
{otherLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}
{article && <meta property="article:published_time" content={article.published.toISOString()} />}
{article && <meta property="article:modified_time" content={(article.modified ?? article.published).toISOString()} />}
{article && <meta property="article:author" content={article.author} />}
{article?.section && <meta property="article:section" content={article.section} />}
{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{site.social.x && <meta name="twitter:site" content={'@' + site.social.x.replace(/\/$/, '').split('/').pop()} />}

{site.analytics.googleSiteVerification && <meta name="google-site-verification" content={site.analytics.googleSiteVerification} />}
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
