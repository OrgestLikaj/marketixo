---
import Icon from './Icon.astro';
import { services } from '~/data/services';
import type { Project } from '~/data/work';
import type { Lang } from '~/i18n/ui';
import { hostOf, logoFor, screenshotFor } from '~/lib/assets';

interface Props {
  project: Project;
  lang: Lang;
}
const { project, lang } = Astro.props;
const tags = project.services
  .map((k) => services.find((s) => s.key === k)?.copy[lang].title.split(' (')[0])
  .filter(Boolean);
const image = screenshotFor(project.key, project.image);
const logo = logoFor(project.key, project.logo);
const host = hostOf(project.url);
const visit = lang === 'de' ? 'Website ansehen' : 'Visit website';
---

<a class="project reveal" href={project.url} target="_blank" rel="noopener">
  <div class="project__cover" style={`--c:${project.color}`}>
    <div class="project__mock">
      <div class="project__bar" aria-hidden="true">
        <i></i><i></i><i></i>
        <span class="project__url">{host}</span>
      </div>
      {
        image ? (
          <img src={image} alt={`${project.client} — ${host}`} loading="lazy" decoding="async" width="1440" height="900" />
        ) : (
          <div class="project__body" aria-hidden="true">
            {logo ? <img class="project__logo" src={logo} alt="" /> : <span class="project__name">{project.client}</span>}
            <span class="project__l"></span>
            <span class="project__l project__l--short"></span>
            <span class="project__btn"></span>
          </div>
        )
      }
    </div>
  </div>
  <div class="project__meta">
    <h3>{project.client}</h3>
    {project.year && <span class="project__year">{project.year}</span>}
  </div>
  <p>{project.summary[lang]}</p>
  {project.result && <p class="project__result">{project.result[lang]}</p>}
  <ul class="project__tags">
    {tags.map((tag) => <li class="tag">{tag}</li>)}
  </ul>
  <span class="project__visit">{visit} <Icon name="arrow-up-right" size={16} /></span>
</a>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
  }
  .project__cover {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    margin-bottom: 0.75rem;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--c) 55%, white) 0%, transparent 60%),
      var(--c);
  }
  .project__mock {
    position: absolute;
    left: 9%;
    right: 9%;
    top: 12%;
    bottom: -4%;
    overflow: hidden;
    border-radius: 12px 12px 0 0;
    background: var(--white);
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.25);
    transition: transform 0.6s var(--ease);
  }
  .project:hover .project__mock {
    transform: translateY(-6px);
  }
  .project__mock > img {
    width: 100%;
    height: calc(100% - 33px);
    object-fit: cover;
    object-position: top;
  }
  .project__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 33px;
    padding: 0 12px;
    border-bottom: 1px solid #eee;
  }
  .project__bar i {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #e3e3e3;
  }
  .project__url {
    flex: 1;
    margin-left: 8px;
    padding: 2px 10px;
    border-radius: 6px;
    background: #f3f3f3;
    font-size: 0.6875rem;
    color: #777;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .project__body {
    display: grid;
    gap: 10px;
    padding: 10% 10%;
  }
  .project__name {
    margin-bottom: 8px;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--c);
  }
  .project__logo {
    height: 48px;
    width: auto;
    max-width: 70%;
    margin-bottom: 8px;
    object-fit: contain;
    object-position: left;
  }
  .project__body span.project__l {
    display: block;
    height: 10px;
    border-radius: 6px;
    background: #ececec;
  }
  .project__body .project__l--short {
    width: 60%;
  }
  .project__body .project__btn {
    display: block;
    width: 32%;
    height: 22px;
    margin-top: 6px;
    border-radius: 999px;
    background: var(--c);
  }
  .project__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .project h3 {
    margin: 0;
    font-size: 1.375rem;
  }
  .project__year {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .project p {
    margin: 0;
    color: var(--muted);
    font-size: 0.975rem;
  }
  .project .project__result {
    color: var(--signal-dark);
    font-weight: 600;
  }
  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }
  .section--white .project__tags .tag {
    background: var(--paper);
  }
  .project__visit {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.9375rem;
  }
  .project:hover .project__visit {
    color: var(--signal-dark);
  }
</style>
