---
/**
 * Portfolio card. Layout variants are set by ProjectGrid:
 *   feature — full width, large image
 *   wide    — image 8/12 + text 4/12
 *   half    — half width (optionally offset for an editorial stagger)
 */
import BrowserFrame from './BrowserFrame.astro';
import Badge from './Badge.astro';
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';
import type { Project } from '~/data/projects';
import { useT, type Lang } from '~/i18n';
import { url } from '~/i18n/routes';
import { workImages } from '~/lib/work-images';

interface Props {
  project: Project;
  copy: CollectionEntry<'work'>['data'];
  serviceNames: Record<string, string>;
  lang: Lang;
  index: number;
  layout?: 'feature' | 'wide' | 'half';
  headingLevel?: 2 | 3;
  eager?: boolean;
}
const { project, copy, serviceNames, lang, index, layout = 'half', headingLevel = 3, eager = false } = Astro.props;
const t = useT(lang);
const img = workImages(project.key);
const href = url.project(lang, project.key);
const H = `h${headingLevel}` as 'h2' | 'h3';
const num = String(index + 1).padStart(2, '0');
const sizes =
  layout === 'feature' ? '(min-width: 1400px) 1320px, 94vw' : layout === 'wide' ? '(min-width: 1024px) 66vw, 94vw' : '(min-width: 768px) 46vw, 94vw';
const aspect = layout === 'feature' ? '16 / 8' : layout === 'wide' ? '16 / 10' : '4 / 3';
---

<article
  class:list={['pc', `pc--${layout}`]}
  data-categories={project.categories.join(' ')}
  data-reveal
  style={`--brand:${project.brand}`}
>
  <div class="pc__media">
    {
      img.desktop ? (
        <BrowserFrame
          src={img.desktop}
          alt={`${project.client} — ${copy.industry}`}
          url={project.url}
          sizes={sizes}
          aspect={aspect}
          loading={eager ? 'eager' : 'lazy'}
          class="pc__frame"
        />
      ) : (
        <div class="pc__cover" style={`aspect-ratio:${aspect}`} aria-hidden="true">
          <div class="pc__tiles">
            {Array.from({ length: 9 }, (_, i) => (
              <span style={`--d:${i}`} />
            ))}
          </div>
          <span class="pc__cover-name">{project.client}</span>
        </div>
      )
    }
  </div>

  <div class="pc__body">
    <div class="pc__meta">
      <span class="index-num">{num}</span>
      <span class="pc__industry">{copy.industry}</span>
    </div>
    <H class="pc__title">
      <a href={href} class="pc__link">{project.client}</a>
    </H>
    {layout !== 'half' && <p class="pc__summary">{copy.summary}</p>}
    <ul class="pc__tags" role="list" aria-label={t.caseStudy.services}>
      {project.services.map((s) => <li><Badge>{serviceNames[s] ?? s}</Badge></li>)}
    </ul>
    <span class="pc__cta" aria-hidden="true">
      {t.common.viewProject}
      <Icon name="arrow-right" size={16} />
    </span>
  </div>
</article>

<style>
  .pc {
    position: relative;
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .pc__media {
    position: relative;
    border-radius: var(--radius-lg);
  }
  /* Brand-coloured halo behind the screenshot, revealed on hover */
  .pc__media::before {
    content: '';
    position: absolute;
    inset: 8% 6% -4%;
    background: var(--brand);
    filter: blur(60px);
    opacity: 0.18;
    z-index: -1;
    transition: opacity 600ms var(--ease);
  }
  .pc:hover .pc__media::before {
    opacity: 0.38;
  }
  .pc :global(.bf__img) {
    transition: transform 1.4s var(--ease-out);
  }
  .pc:hover :global(.bf__img) {
    transform: scale(1.035);
  }
  .pc__body {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .pc__meta {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }
  .pc__industry {
    font-family: var(--font-code);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  .pc__title {
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .pc--feature .pc__title {
    font-size: clamp(2rem, 1.2rem + 3vw, 3.75rem);
  }
  .pc__link {
    text-decoration: none;
  }
  /* Whole card is clickable via the title link */
  .pc__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .pc__link:focus-visible {
    outline: none;
  }
  .pc:has(.pc__link:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 8px;
    border-radius: var(--radius-lg);
  }
  .pc__summary {
    color: var(--text-muted);
    max-width: 52ch;
  }
  .pc__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .pc__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--pearl-aqua);
  }
  .pc__cta :global(.icon) {
    transition: transform var(--dur) var(--ease);
  }
  .pc:hover .pc__cta :global(.icon) {
    transform: translateX(4px);
  }

  /* Feature: title and summary side by side under the image */
  @media (min-width: 900px) {
    .pc--feature .pc__body {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-areas:
        'meta meta'
        'title summary'
        'title tags'
        'title cta';
      column-gap: 3rem;
    }
    .pc--feature .pc__meta {
      grid-area: meta;
    }
    .pc--feature .pc__title {
      grid-area: title;
    }
    .pc--feature .pc__summary {
      grid-area: summary;
    }
    .pc--feature .pc__tags {
      grid-area: tags;
    }
    .pc--feature .pc__cta {
      grid-area: cta;
    }
    .pc--wide {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      align-items: end;
      gap: clamp(1.5rem, 3vw, 3rem);
    }
  }

  /* Cover for projects without a website screenshot */
  .pc__cover {
    position: relative;
    display: grid;
    place-items: end start;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-strong);
    background:
      radial-gradient(ellipse at 80% 20%, color-mix(in srgb, var(--brand) 55%, transparent), transparent 60%),
      linear-gradient(135deg, #021a22, color-mix(in srgb, var(--brand) 35%, #001219));
    overflow: hidden;
  }
  .pc__tiles {
    position: absolute;
    top: 50%;
    right: 8%;
    translate: 0 -50%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    width: min(46%, 300px);
    transform: rotate(-6deg);
  }
  .pc__tiles span {
    aspect-ratio: 1;
    border-radius: 6px;
    background: rgb(255 255 255 / calc(0.06 + var(--d) * 0.015));
    border: 1px solid rgb(255 255 255 / 0.12);
    transition: transform 600ms var(--ease-out);
    transition-delay: calc(var(--d) * 30ms);
  }
  .pc__tiles span:nth-child(3n + 2) {
    background: color-mix(in srgb, var(--brand) 70%, transparent);
  }
  .pc:hover .pc__tiles span {
    transform: translateY(-6px);
  }
  .pc__cover-name {
    position: relative;
    max-width: 50%;
    font-size: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: #fff;
  }
</style>
