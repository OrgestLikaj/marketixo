---
import Icon from './Icon.astro';
import type { Project } from '~/data/work';
import type { Lang } from '~/i18n/ui';
import { projectLink, projectServices } from '~/lib/work';

/** Editorial list: big client names, one row each; the row fills with the brand colour on hover. */
interface Props {
  projects: Project[];
  lang: Lang;
}
const { projects, lang } = Astro.props;
---

<ol class="windex">
  {
    projects.map((p, i) => {
      const link = projectLink(p);
      const services = projectServices(p, lang);
      return (
        <li class="reveal" style={`--c:${p.color};transition-delay:${Math.min(i, 5) * 50}ms`}>
          <a class="windex__row" href={link?.href} target="_blank" rel="noopener">
            <span class="windex__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="windex__head">
              <h3 class="windex__name">{p.client}</h3>
              <span class="windex__summary">{p.summary[lang]}</span>
            </span>
            <span class="windex__services">{services.map((s) => s.title).join(' · ')}</span>
            <span class="windex__link">
              <span>{link?.label}</span>
              <Icon name="arrow-up-right" size={20} />
            </span>
          </a>
        </li>
      );
    })
  }
</ol>

<style>
  .windex {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .windex li {
    border-bottom: 1px solid var(--line);
  }
  .windex__row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.5rem 1.25rem;
    align-items: baseline;
    padding: clamp(20px, 3vw, 36px) 0;
    overflow: hidden;
    text-decoration: none;
    transition:
      padding 0.45s var(--ease),
      color 0.3s var(--ease);
  }
  @media (min-width: 900px) {
    .windex__row {
      grid-template-columns: 3rem minmax(0, 1.3fr) minmax(0, 1fr) auto;
      gap: 2rem;
      align-items: center;
    }
  }
  /* Brand-colour fill that wipes up from the bottom */
  .windex__row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--c);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.45s var(--ease);
  }
  .windex__row:hover,
  .windex__row:focus-visible {
    padding-inline: clamp(16px, 2.4vw, 32px);
    color: var(--white);
  }
  .windex__row:hover::before,
  .windex__row:focus-visible::before {
    transform: none;
  }
  .windex__num {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
  }
  .windex__head {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }
  .windex__name {
    margin: 0;
    color: inherit;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .windex__summary,
  .windex__services {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .windex__services {
    grid-column: 2 / -1;
  }
  @media (min-width: 900px) {
    .windex__services {
      grid-column: auto;
    }
  }
  .windex__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    grid-row: 1;
    grid-column: 3;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  .windex__link span {
    display: none;
  }
  @media (min-width: 900px) {
    .windex__link {
      grid-column: 4;
    }
    .windex__link span {
      display: inline;
    }
  }
  .windex__link :global(svg) {
    transition: transform 0.3s var(--ease);
  }
  .windex__row:hover .windex__link :global(svg) {
    transform: rotate(45deg);
  }
  .windex__row:hover :is(.windex__num, .windex__summary, .windex__services),
  .windex__row:focus-visible :is(.windex__num, .windex__summary, .windex__services) {
    color: rgb(255 255 255 / 0.85);
  }
</style>
