---
import Icon from './Icon.astro';
import type { Project } from '~/data/work';
import { t, url, type Lang } from '~/i18n/ui';
import { logoFor } from '~/lib/assets';
import { projectLink, projectServices } from '~/lib/work';

/**
 * Logo-led cards: each client's logo sits large on a clean panel tinted with their brand colour.
 * Until a logo file exists in /public/clients/<key>.(svg|png|webp), a monogram + name mark is shown.
 */
interface Props {
  projects: Project[];
  lang: Lang;
  /** Adds a closing "your brand next" card (used on the full Work page). */
  withCta?: boolean;
}
const { projects, lang, withCta = false } = Astro.props;
const s = t(lang);

/** "Medicus Center" → "MC", "IR" → "IR", "Finman" → "FI". */
const monogram = (name: string) => {
  const words = name.split(/\s+/).filter(Boolean);
  return (words.length > 1 ? words[0][0] + words[1][0] : words[0].slice(0, 2)).toUpperCase();
};

const items = projects.map((p) => ({
  p,
  link: projectLink(p),
  logo: logoFor(p.key, p.logo),
  services: projectServices(p, lang),
}));
const cols = items.length + (withCta ? 1 : 0) <= 3 ? 3 : 4;
/** The closing card stretches over whatever is left of the last row (a full row if nothing is). */
const fill = (perRow: number) => perRow - (items.length % perRow);
const cta = {
  en: { title: 'Your brand next?', text: 'Tell us about your business and get a free, fixed-price quote.' },
  de: { title: 'Ihre Marke als Nächstes?', text: 'Erzählen Sie uns von Ihrem Unternehmen und erhalten Sie ein kostenloses Festpreisangebot.' },
}[lang];
---

<ul class="logos" style={`--cols:${cols}`}>
  {
    items.map(({ p, link, logo, services }, i) => (
      <li class="reveal" style={`--c:${p.color};${p.logoBg ? `--stage:${p.logoBg};` : ''}transition-delay:${(i % cols) * 60}ms`}>
        <a class="logo-card" href={link?.href} target="_blank" rel="noopener">
          <div class:list={['logo-card__stage', { 'is-placeholder': !logo, 'has-bg': p.logoBg }]}>
            <ul class="logo-card__icons" aria-label={services.map((x) => x.title).join(', ')}>
              {services.map((x) => (
                <li title={x.title}>
                  <Icon name={x.icon} size={14} />
                </li>
              ))}
            </ul>
            {logo ? (
              <img class="logo-card__img" src={logo} alt={`${p.client} logo`} loading="lazy" decoding="async" />
            ) : (
              <span class="logo-card__mark" aria-hidden="true">
                {p.client.length > 3 && <span class="logo-card__mono">{monogram(p.client)}</span>}
                <span class:list={['logo-card__word', { 'logo-card__word--short': p.client.length <= 3 }]}>{p.client}</span>
              </span>
            )}
          </div>
          <div class="logo-card__body">
            <h3>{p.client}</h3>
            <p>{p.summary[lang]}</p>
          </div>
          <div class="logo-card__foot">
            <span class="logo-card__link">
              {link?.label}
              <Icon name="arrow-up-right" size={16} />
            </span>
          </div>
        </a>
      </li>
    ))
  }
  {
    withCta && (
      <li class="reveal logos__cta" style={`--span-md:${fill(2)};--span-lg:${fill(cols)}`}>
        <a class="logo-card logo-card--cta" href={url('contact', lang) + '#quote'}>
          <div class="logo-card__cta-inner">
            <div class="logo-card__stage">
              <span class="logo-card__plus" aria-hidden="true">
                <Icon name="arrow-up-right" size={28} />
              </span>
            </div>
            <div class="logo-card__content">
              <div class="logo-card__body">
                <h3>{cta.title}</h3>
                <p>{cta.text}</p>
              </div>
              <div class="logo-card__foot">
                <span class="logo-card__link">
                  {s.cta.quote}
                  <Icon name="arrow" size={16} />
                </span>
              </div>
            </div>
          </div>
        </a>
      </li>
    )
  }
</ul>

<style>
  .logos {
    display: grid;
    gap: clamp(12px, 1.6vw, 20px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 640px) {
    .logos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 640px) {
    .logos__cta {
      grid-column: span var(--span-md);
    }
  }
  @media (min-width: 1000px) {
    .logos {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    }
    .logos__cta {
      grid-column: span var(--span-lg);
    }
  }
  .logos > li {
    display: flex;
    min-width: 0;
  }

  .logo-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    text-decoration: none;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }
  .logo-card:hover {
    transform: translateY(-4px);
    border-color: transparent;
    box-shadow: var(--shadow-lg);
  }

  /* The logo panel: white with a hint of the client's colour, stronger on hover. */
  .logo-card__stage {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    max-width: 100%;
    padding: 12%;
    background: var(--stage, color-mix(in srgb, var(--c) 5%, white));
    border-bottom: 1px solid color-mix(in srgb, var(--c) 14%, white);
    transition: background-color 0.35s var(--ease);
  }
  .logo-card__stage::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    background: var(--c);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease);
  }
  .logo-card:hover .logo-card__stage::after {
    transform: scaleX(1);
  }
  .logo-card:hover .logo-card__stage:not(.has-bg) {
    background: color-mix(in srgb, var(--c) 9%, white);
  }
  /* A fixed height (not max-height) so SVGs without their own width still size correctly. */
  .logo-card__img {
    max-width: 78%;
    height: 96px;
    width: auto;
    object-fit: contain;
    transition: transform 0.45s var(--ease);
  }
  /* Lets logos saved on a white background (JPG/PNG) blend into the tinted panel. */
  .logo-card__stage:not(.has-bg) .logo-card__img {
    mix-blend-mode: multiply;
  }
  .logo-card:hover .logo-card__img {
    transform: scale(1.04);
  }

  /* Stand-in until the real logo is added: monogram + name in the brand colour. */
  .logo-card__mark {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    color: var(--c);
  }
  .logo-card__mono {
    display: grid;
    place-items: center;
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--c);
    color: var(--white);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .logo-card__word {
    min-width: 0;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.9vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .logo-card__body {
    display: grid;
    gap: 0.4rem;
    padding: 22px 22px 0;
  }
  .logo-card__body h3 {
    margin: 0;
    font-size: 1.2rem;
  }
  .logo-card__body p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .logo-card__foot {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding: 20px 22px 22px;
  }
  /* Services delivered, as small icons in the corner of the logo panel. */
  .logo-card__icons {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .logo-card__icons li {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--white);
    color: color-mix(in srgb, var(--c) 70%, var(--ink));
    box-shadow: 0 1px 2px rgb(13 15 20 / 0.06);
  }
  .logo-card__word--short {
    font-size: clamp(2.6rem, 4vw, 3.4rem);
    letter-spacing: -0.05em;
  }
  .logo-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-width: 0;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .logo-card:hover .logo-card__link {
    color: var(--signal-dark);
  }

  /* Closing call-to-action card. When it spans several columns it turns sideways. */
  .logo-card--cta {
    container-type: inline-size;
    border-style: dashed;
    border-color: color-mix(in srgb, var(--ink) 25%, transparent);
    background: transparent;
  }
  .logo-card--cta .logo-card__stage {
    background: transparent;
    border-bottom-style: dashed;
    border-bottom-color: color-mix(in srgb, var(--ink) 18%, transparent);
  }
  .logo-card--cta .logo-card__stage::after {
    background: var(--signal);
  }
  .logo-card__plus {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--signal);
    color: var(--white);
    transition: transform 0.35s var(--ease);
  }
  .logo-card--cta:hover .logo-card__plus {
    transform: rotate(45deg);
  }
  .logo-card--cta .logo-card__link {
    color: var(--signal-dark);
  }
  .logo-card__cta-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .logo-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
  }
  @container (min-width: 520px) {
    .logo-card__cta-inner {
      flex-direction: row;
    }
    .logo-card--cta .logo-card__stage {
      flex: 0 0 40%;
      aspect-ratio: auto;
      min-height: 220px;
      border-bottom: 0;
      border-right: 1px dashed color-mix(in srgb, var(--ink) 18%, transparent);
    }
    .logo-card--cta .logo-card__content {
      justify-content: center;
    }
    .logo-card--cta .logo-card__body {
      padding: 28px 32px 0;
    }
    .logo-card--cta .logo-card__body h3 {
      font-size: clamp(1.5rem, 2.4vw, 2rem);
    }
    .logo-card--cta .logo-card__foot {
      margin-top: 0;
      padding: 20px 32px 28px;
    }
  }
</style>
