---
/**
 * Primary = warm action (one per view, ideally). Secondary = outlined.
 * Ghost = text link with arrow. Renders <a> when href is set, otherwise <button>.
 */
import Icon from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  arrow?: boolean;
  external?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'md', arrow = variant !== 'secondary', external, type = 'button', class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const linkProps = href ? { href, ...(external ? { target: '_blank', rel: 'noopener' } : {}) } : { type };
---

<Tag class:list={['btn', `btn--${variant}`, `btn--${size}`, className]} {...linkProps} {...rest}>
  <span class="btn__label"><slot /></span>
  {arrow && <Icon name={external ? 'arrow-up-right' : 'arrow-right'} size={size === 'sm' ? 16 : 18} class="btn__icon" />}
</Tag>

<style>
  .btn {
    --pad-x: 1.35rem;
    --h: 52px;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: var(--h);
    padding: 0 var(--pad-x);
    border-radius: var(--radius);
    border: 1px solid transparent;
    font-weight: 600;
    font-size: 0.9875rem;
    letter-spacing: -0.01em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    isolation: isolate;
    overflow: hidden;
    transition:
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .btn--sm {
    --h: 42px;
    --pad-x: 1rem;
    font-size: 0.9rem;
  }
  .btn--lg {
    --h: 60px;
    --pad-x: 1.75rem;
    font-size: 1.0625rem;
  }
  .btn__icon {
    transition: transform var(--dur) var(--ease);
  }
  .btn:hover .btn__icon {
    transform: translateX(3px);
  }
  .btn[target='_blank']:hover .btn__icon {
    transform: translate(2px, -2px);
  }
  .btn:active {
    transform: translateY(1px);
  }

  .btn--primary {
    background: var(--action);
    color: var(--on-action);
  }
  /* Energy gradient wipes in on hover */
  .btn--primary::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--grad-energy);
    opacity: 0;
    transition: opacity 350ms var(--ease);
  }
  .btn--primary:hover::before {
    opacity: 1;
  }
  .btn--primary:hover {
    color: #fff;
  }

  .btn--secondary {
    background: transparent;
    color: var(--text);
    border-color: var(--line-strong);
  }
  .btn--secondary:hover {
    border-color: var(--pearl-aqua);
    background: rgb(148 210 189 / 0.06);
  }

  .btn--ghost {
    --pad-x: 0;
    --h: 44px;
    background: none;
    color: var(--accent);
    border-radius: 0;
  }
  .btn--ghost .btn__label {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    padding-bottom: 2px;
    transition: background-size 350ms var(--ease);
  }
  .btn--ghost:hover .btn__label {
    background-size: 100% 1px;
  }
</style>
