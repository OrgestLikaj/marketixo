---
/**
 * Primary = warm action (one per view, ideally). Secondary = outlined.
 * Ghost = text link with arrow. Renders <a> when href is set, otherwise <button>.
 */
import Icon from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  arrow?: boolean;
  external?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'md', arrow = variant !== 'secondary', external, type = 'button', class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const linkProps = href ? { href, ...(external ? { target: '_blank', rel: 'noopener' } : {}) } : { type };
---

<Tag class:list={['btn', `btn--${variant}`, `btn--${size}`, className]} {...linkProps} {...rest}>
  <span class="btn__label"><slot /></span>
  {arrow && <Icon name={external ? 'arrow-up-right' : 'arrow-right'} size={size === 'sm' ? 16 : 18} class="btn__icon" />}
</Tag>

<style>
  .btn {
    --pad-x: 1.25rem;
    --h: 48px;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: var(--h);
    padding: 0 var(--pad-x);
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    font-weight: 500;
    font-size: 0.9875rem;
    letter-spacing: 0;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .btn--sm {
    --h: 40px;
    --pad-x: 1rem;
    font-size: 0.9375rem;
  }
  .btn--lg {
    --h: 52px;
    --pad-x: 1.5rem;
    font-size: 1rem;
  }
  .btn__icon {
    transition: transform var(--dur) var(--ease);
  }
  .btn:hover .btn__icon {
    transform: translateX(3px);
  }
  .btn[target='_blank']:hover .btn__icon {
    transform: translate(2px, -2px);
  }

  /* Primary: the one warm, square call to action. */
  .btn--primary {
    background: var(--action);
    color: var(--on-action);
  }
  .btn--primary:hover {
    background: var(--action-hover);
  }

  /* Secondary: solid navy on light, outlined white on navy. */
  .btn--secondary {
    background: var(--navy);
    color: #fff;
  }
  .btn--secondary:hover {
    background: var(--dark-teal);
  }
  :global(.on-dark) .btn--secondary {
    background: transparent;
    color: var(--text);
    border-color: var(--line-strong);
  }
  :global(.on-dark) .btn--secondary:hover {
    border-color: var(--text);
    background: rgb(255 255 255 / 0.06);
  }

  /* Ghost: text link with arrow. */
  .btn--ghost {
    --pad-x: 0;
    --h: 40px;
    background: none;
    color: var(--link);
    border-radius: 0;
  }
  .btn--ghost .btn__label {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    padding-bottom: 2px;
    transition: background-size 300ms var(--ease);
  }
  .btn--ghost:hover .btn__label {
    background-size: 100% 1px;
  }
</style>
