---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, whatsappLink } from '~/config/site';
import { t, url, type Lang } from '~/i18n/ui';
import { groupOrder, servicesByGroup, serviceUrl } from '~/data/services';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const year = new Date().getFullYear();
const socials = (Object.entries(site.social) as [string, string][]).filter(([, href]) => href);
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo inverted />
        <p>{s.footer.tagline}</p>
        <ul class="site-footer__contact">
          <li><a href={`mailto:${site.email}`}><Icon name="mail" size={18} />{site.email}</a></li>
          <li><a href={`tel:${site.phoneHref}`}><Icon name="phone" size={18} />{site.phone}</a></li>
          <li>
            <a href={whatsappLink(s.whatsappText)} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />WhatsApp</a>
          </li>
        </ul>
        {
          socials.length > 0 && (
            <ul class="site-footer__social">
              {socials.map(([name, href]) => (
                <li>
                  <a href={href} target="_blank" rel="noopener" aria-label={name}>
                    <Icon name={name} size={20} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        groupOrder.map((g) => (
          <div class="site-footer__col">
            <p class="site-footer__heading">{s.groups[g].name}</p>
            <ul>
              {servicesByGroup(g).map((svc) => (
                <li>
                  <a href={serviceUrl(svc, lang)}>{svc.copy[lang].title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="site-footer__col">
        <p class="site-footer__heading">{s.footer.company}</p>
        <ul>
          <li><a href={url('work', lang)}>{s.nav.work}</a></li>
          <li><a href={url('about', lang)}>{s.nav.about}</a></li>
          <li><a href={url('blog', lang)}>{s.nav.blog}</a></li>
          <li><a href={url('contact', lang)}>{s.nav.contact}</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {site.legalName}. {s.footer.rights}</p>
      <ul>
        <li><a href={url('privacy', lang)}>{s.footer.privacy}</a></li>
        <li><a href={url('imprint', lang)}>{s.footer.imprint}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--on-ink-muted);
    padding-block: clamp(56px, 8vw, 96px) 2rem;
    font-size: 0.9375rem;
  }
  .site-footer a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s;
  }
  .site-footer a:hover {
    color: var(--white);
  }
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .site-footer__top {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(2, 1fr);
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--line-ink);
  }
  .site-footer__brand {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .site-footer__brand p {
    margin: 0;
    max-width: 30ch;
    font-size: 1.0625rem;
    color: var(--on-ink);
  }
  .site-footer__contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .site-footer__social {
    display: flex !important;
    gap: 0.5rem !important;
  }
  .site-footer__social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-ink);
    border-radius: 50%;
  }
  .site-footer__heading {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-ink);
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.75rem;
    font-size: 0.875rem;
  }
  .site-footer__bottom p {
    margin: 0;
  }
  .site-footer__bottom ul {
    display: flex;
    gap: 1.5rem;
  }
  @media (min-width: 1000px) {
    .site-footer__top {
      grid-template-columns: 1.6fr repeat(4, 1fr);
    }
    .site-footer__brand {
      grid-column: auto;
    }
  }
</style>
