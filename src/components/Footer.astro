---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';
import { languageMeta, locales, useT } from '~/i18n';
import { url } from '~/i18n/routes';
import { serviceKeys } from '~/data/services';
import { site, socialLinks } from '~/config/site';
import { switchTarget, type PageEntry } from '~/lib/pages';

interface Props {
  page: Pick<PageEntry, 'lang' | 'alternates' | 'kind'>;
}
const { page } = Astro.props;
const lang = page.lang;
const t = useT(lang);
const serviceCopy = await getCollection('services', (e) => e.data.lang === lang);
const services = serviceKeys.map((key) => ({
  href: url.service(lang, key),
  title: serviceCopy.find((s) => s.data.key === key)?.data.shortTitle ?? key,
}));
const year = new Date().getFullYear();
const socials = socialLinks();
---

<footer class="ftr">
  <div class="container container--wide">
    <div class="ftr__top">
      <div class="ftr__brand">
        <a href={url.section(lang, 'home')} class="ftr__logo"><Logo size={38} /></a>
        <p class="ftr__tagline">{t.footer.tagline}</p>
        <div class="ftr__contact">
          {site.contact.email && (
            <a href={`mailto:${site.contact.email}`}>
              <Icon name="mail" size={18} /> {site.contact.email}
            </a>
          )}
          {site.contact.phone && (
            <a href={`tel:${site.contact.phoneHref}`}>
              <Icon name="phone" size={18} /> {site.contact.phone}
            </a>
          )}
        </div>
        {socials.length > 0 && (
          <ul class="ftr__social" role="list">
            {socials.map((s) => (
              <li>
                <a href={s.url} rel="noopener me" target="_blank" aria-label={`${s.network} ${t.common.opensNewTab}`}>
                  <Icon name={s.network} size={20} />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <nav class="ftr__cols" aria-label={t.footer.navLabel}>
        <div>
          <h2 class="ftr__h">{t.footer.company}</h2>
          <ul role="list">
            <li><a href={url.section(lang, 'about')}>{t.nav.about}</a></li>
            <li><a href={url.section(lang, 'work')}>{t.nav.work}</a></li>
            <li><a href={url.section(lang, 'contact')}>{t.nav.contact}</a></li>
          </ul>
        </div>
        <div class="ftr__services">
          <h2 class="ftr__h">{t.footer.services}</h2>
          <ul role="list">
            {services.map((s) => <li><a href={s.href}>{s.title}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="ftr__h">{t.footer.resources}</h2>
          <ul role="list">
            <li><a href={url.section(lang, 'insights')}>{t.nav.insights}</a></li>
            <li><a href={url.section(lang, 'faq')}>{t.nav.faq}</a></li>
          </ul>
          <h2 class="ftr__h ftr__h--gap">{t.footer.legal}</h2>
          <ul role="list">
            <li><a href={url.section(lang, 'privacy')}>{t.footer.privacy}</a></li>
            <li><a href={url.section(lang, 'cookies')}>{t.footer.cookies}</a></li>
            <li><a href={url.section(lang, 'legal')}>{t.footer.legalNotice}</a></li>
            <li><button type="button" class="ftr__btn" data-cookie-settings>{t.footer.cookieSettings}</button></li>
          </ul>
        </div>
        <div>
          <h2 class="ftr__h">{t.footer.languages}</h2>
          <ul role="list">
            {
              locales.map((l) => (
                <li>
                  <a
                    href={switchTarget(page, l).href}
                    hreflang={languageMeta[l].hreflang}
                    lang={l}
                    data-lang={l}
                    aria-current={l === lang ? 'true' : undefined}
                  >
                    {languageMeta[l].native}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>
    </div>

    <div class="ftr__word" aria-hidden="true">marketi<span>x</span>o</div>

    <div class="ftr__bottom">
      <p>© {year} {site.company.legalName || site.name}. {t.footer.rights}</p>
      <a href="#main" class="ftr__top-link">
        {t.footer.backToTop} <Icon name="arrow-right" size={14} class="ftr__up" />
      </a>
    </div>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    border-top: 1px solid var(--line);
    padding-top: clamp(64px, 8vw, 112px);
    background:
      radial-gradient(ellipse 60% 50% at 100% 100%, rgb(0 95 115 / 0.35), transparent 70%),
      var(--bg);
    overflow: hidden;
  }
  .ftr__top {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 3rem;
  }
  .ftr__logo {
    display: inline-flex;
    text-decoration: none;
  }
  .ftr__tagline {
    margin-top: 1.25rem;
    max-width: 30ch;
    font-size: var(--fs-lg);
    line-height: 1.4;
    color: var(--text-muted);
  }
  .ftr__contact {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .ftr__contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text);
  }
  .ftr__contact a:hover {
    color: var(--pearl-aqua);
  }
  .ftr__social {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .ftr__social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--text-muted);
    transition: all var(--dur) var(--ease);
  }
  .ftr__social a:hover {
    color: var(--text);
    border-color: var(--pearl-aqua);
  }
  .ftr__cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }
  .ftr__h {
    font-family: var(--font-code);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-subtle);
    margin-bottom: 1rem;
  }
  .ftr__h--gap {
    margin-top: 2rem;
  }
  .ftr__cols ul {
    display: grid;
    gap: 0.15rem;
  }
  .ftr__cols a,
  .ftr__btn {
    display: inline-block;
    padding-block: 0.35rem;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color var(--dur) var(--ease);
  }
  .ftr__btn {
    background: none;
    border: 0;
    padding-inline: 0;
    cursor: pointer;
    text-align: left;
  }
  .ftr__cols a:hover,
  .ftr__btn:hover,
  .ftr__cols a[aria-current] {
    color: var(--text);
  }
  .ftr__word {
    margin-top: clamp(48px, 7vw, 96px);
    font-size: clamp(4.5rem, 21vw, 22rem);
    font-weight: 650;
    letter-spacing: -0.065em;
    line-height: 0.75;
    text-align: center;
    background: linear-gradient(180deg, rgb(148 210 189 / 0.16), rgb(148 210 189 / 0.02) 85%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    user-select: none;
    translate: 0 0.06em;
  }
  .ftr__word span {
    background: linear-gradient(180deg, rgb(238 155 0 / 0.35), rgb(238 155 0 / 0.02) 85%);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .ftr__bottom {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
    color: var(--text-subtle);
  }
  .ftr__top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
    text-decoration: none;
  }
  .ftr__up {
    rotate: -90deg;
  }
  @media (max-width: 1023px) {
    .ftr__top {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 639px) {
    .ftr__cols {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1.5rem;
    }
    .ftr__bottom {
      flex-direction: column;
    }
  }
</style>
