export type IconName = keyof typeof paths;

interface Props {
  name: IconName | string;
  size?: number;
  label?: string;
  class?: string;
  /** Forwarded attributes (incl. the parent's scoped-style id). */
  [key: string]: unknown;
  strokeWidth?: number;
}
const { name, size = 24, label, class: className, strokeWidth = 1.5 , ...rest } = Astro.props;
const body = paths[name as IconName] ?? paths.spark;
---

<svg
  {...rest} class:list={['icon', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={body}
/>
