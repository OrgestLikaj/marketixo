---
/** A minimal browser window around a real screenshot. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  url?: string;
  sizes?: string;
  widths?: number[];
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'auto';
  class?: string;
  /** Forwarded attributes (incl. the parent's scoped-style id). */
  [key: string]: unknown;
  /** Crop the screenshot to a viewport-like aspect ratio. */
  aspect?: string;
}
const { src, alt, url, sizes = '(min-width: 1320px) 1200px, 92vw', widths = [480, 720, 960, 1280, 1600, 2000], loading = 'lazy', fetchpriority, class: className, aspect = '16 / 10' , ...rest } = Astro.props;
const host = url ? new URL(url).host.replace(/^www\./, '') : '';
---

<figure {...rest} class:list={['bf', className]}>
  <div class="bf__bar" aria-hidden="true">
    <span class="bf__dots"><i></i><i></i><i></i></span>
    {host && <span class="bf__url">{host}</span>}
  </div>
  <div class="bf__view" style={`aspect-ratio:${aspect}`}>
    <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} fetchpriority={fetchpriority} decoding="async" class="bf__img" layout="none" />
  </div>
</figure>

<style>
  .bf {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #0b2630;
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-lg);
  }
  .bf__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 34px;
    padding-inline: 0.85rem;
    background: #0b2630;
    border-bottom: 1px solid var(--line);
  }
  .bf__dots {
    display: flex;
    gap: 6px;
  }
  .bf__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgb(148 210 189 / 0.22);
  }
  .bf__url {
    flex: 1;
    max-width: 280px;
    margin-inline: auto;
    translate: -30px 0;
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    background: rgb(0 18 25 / 0.55);
    font-family: var(--font-code);
    font-size: 0.6875rem;
    color: var(--text-subtle);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bf__view {
    overflow: hidden;
    background: #fff;
  }
  .bf__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 1.2s var(--ease-out);
  }
  @media (max-width: 479px) {
    .bf__bar {
      height: 26px;
    }
    .bf__url {
      display: none;
    }
  }
</style>
