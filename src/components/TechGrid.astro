---
interface Props {
  areas: { area: string; items: string[] }[];
}
const { areas } = Astro.props;
---

<dl class="tg">
  {
    areas.map((a, i) => (
      <div class="tg__cell" data-reveal style={`--reveal-delay:${i % 5}`}>
        <dt class="tg__area">
          <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
          {a.area}
        </dt>
        {a.items.map((item) => (
          <dd class="tg__item">{item}</dd>
        ))}
      </div>
    ))
  }
</dl>

<style>
  .tg {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .tg__cell {
    padding: 1.5rem 1.25rem 1.75rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: background-color 400ms var(--ease);
  }
  .tg__cell:hover {
    background: rgb(148 210 189 / 0.04);
  }
  .tg__area {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1rem;
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.015em;
    min-width: 0;
    overflow-wrap: anywhere;
    hyphens: auto;
  }
  .tg__item {
    margin: 0;
    padding-block: 0.2rem;
    font-family: var(--font-code);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  @media (max-width: 1099px) {
    .tg {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 639px) {
    .tg {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tg__cell {
      padding: 1.25rem 1rem;
    }
  }
  @media (max-width: 379px) {
    .tg {
      grid-template-columns: 1fr;
    }
  }
</style>
