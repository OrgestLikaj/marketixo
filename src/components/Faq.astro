---
/**
 * Accessible FAQ on <details>/<summary> — works without JavaScript.
 * Pages add the matching FAQPage JSON-LD via lib/schema.ts.
 */
import Icon from './Icon.astro';

interface Props {
  items: { q: string; a: string }[];
  level?: 2 | 3;
}
const { items, level = 3 } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
---

<div class="faq">
  {
    items.map((item, i) => (
      <details class="faq__item" data-reveal style={`--reveal-delay:${Math.min(i, 4)}`}>
        <summary class="faq__q">
          <H class="faq__h">{item.q}</H>
          <span class="faq__icon" aria-hidden="true">
            <Icon name="plus" size={20} />
          </span>
        </summary>
        <div class="faq__a">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--line);
  }
  .faq__item {
    border-bottom: 1px solid var(--line);
  }
  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.4rem;
    cursor: pointer;
    list-style: none;
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__h {
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.3125rem);
    font-weight: 550;
    letter-spacing: -0.015em;
    line-height: 1.35;
    transition: color var(--dur) var(--ease);
  }
  .faq__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--accent);
    transition:
      transform 300ms var(--ease),
      background-color 300ms var(--ease);
  }
  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    background: rgb(148 210 189 / 0.08);
  }
  .faq__q:hover .faq__h {
    color: var(--accent);
  }
  .faq__a {
    max-width: 72ch;
    padding: 0 3.5rem 1.6rem 0;
    color: var(--text-muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    .faq__item[open] .faq__a {
      animation: faq-in 400ms var(--ease-out);
    }
  }
  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
</style>
