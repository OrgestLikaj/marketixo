---
interface Props {
  title: string;
  items: { q: string; a: string }[];
}
const { title, items } = Astro.props;
---

<div class="faq">
  <h2 class="faq__title">{title}</h2>
  <div class="faq__list">
    {
      items.map((item, i) => (
        <details class="faq__item" open={i === 0}>
          <summary>
            <span>{item.q}</span>
            <span class="faq__plus" aria-hidden="true" />
          </summary>
          <p>{item.a}</p>
        </details>
      ))
    }
  </div>
</div>

<style>
  .faq {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .faq {
      grid-template-columns: 1fr 1.6fr;
      gap: 4rem;
    }
  }
  .faq__title {
    margin: 0;
  }
  .faq__list {
    border-top: 1px solid var(--line);
  }
  .faq__item {
    border-bottom: 1px solid var(--line);
  }
  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.4rem 0;
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__plus {
    position: relative;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--line);
    transition: transform 0.25s var(--ease), background-color 0.2s;
  }
  .faq__plus::before,
  .faq__plus::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 12px;
    height: 1.75px;
    background: currentColor;
    translate: -50% -50%;
  }
  .faq__plus::after {
    rotate: 90deg;
  }
  .faq__item[open] .faq__plus {
    transform: rotate(45deg);
    background: var(--signal);
    border-color: var(--signal);
    color: var(--white);
  }
  .faq__item p {
    margin: 0 0 1.5rem;
    max-width: 60ch;
    color: var(--muted);
  }
</style>
