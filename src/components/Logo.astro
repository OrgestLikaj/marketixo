---
/**
 * Marketixo logo. The mark keeps the original idea — an "x" whose rising stroke
 * turns into an arrow (build → grow) — redrawn on the ink/teal gradient.
 */
import { site } from '~/config/site';

interface Props {
  markOnly?: boolean;
  size?: number;
  class?: string;
  /** Forwarded attributes (incl. the parent's scoped-style id). */
  [key: string]: unknown;
}
const { markOnly = false, size = 34, class: className , ...rest } = Astro.props;
// Unique per instance: the logo appears several times per page (header, menu, footer).
const gid = `mx-logo-${Math.random().toString(36).slice(2, 8)}`;
---

<span {...rest} class:list={['logo', className]}>
  <svg class="logo__mark" viewBox="0 0 40 40" width={size} height={size} aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2="40" y2="40" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#005f73"></stop>
        <stop offset="1" stop-color="#0a9396"></stop>
      </linearGradient>
    </defs>
    <rect width="40" height="40" rx="9" fill={`url(#${gid})`}></rect>
    <path d="M12.5 12.5 27.5 27.5" stroke="#eaf3f0" stroke-width="4" stroke-linecap="round"></path>
    <path d="M12.5 27.5 26.6 13.4" stroke="#ee9b00" stroke-width="4" stroke-linecap="round"></path>
    <path d="M19.6 12.4h8v8" fill="none" stroke="#ee9b00" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  {!markOnly && (
    <span class="logo__word" aria-hidden="true">marketi<span class="logo__x">x</span>o</span>
  )}
  <span class="sr-only">{site.name}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
  }
  .logo__mark {
    flex: none;
  }
  .logo__word {
    font-weight: 650;
    font-size: 1.5rem;
    letter-spacing: -0.045em;
    line-height: 1;
    translate: 0 -0.04em;
  }
  .logo__x {
    color: var(--golden-orange);
  }
</style>
