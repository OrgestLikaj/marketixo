---
/**
 * Page section. `tone` switches the colour context: light (white, default),
 * oat (warm light band) or dark (navy band). Spacing comes from tokens.
 */
interface Props {
  tone?: 'light' | 'oat' | 'dark';
  size?: 'default' | 'sm';
  line?: boolean;
  flushTop?: boolean;
  id?: string;
  class?: string;
  /** Forwarded attributes (incl. the parent's scoped-style id). */
  [key: string]: unknown;
  labelledby?: string;
}
const { tone = 'light', size = 'default', line, flushTop, id, class: className, labelledby , ...rest } = Astro.props;
---

<section
  id={id}
  aria-labelledby={labelledby}
  {...rest} class:list={[
    'section',
    { 'section--sm': size === 'sm', 'section--line': line, 'section--flush-top': flushTop, 'on-surface': tone === 'oat', 'on-dark': tone === 'dark' },
    className,
  ]}
>
  <slot />
</section>
