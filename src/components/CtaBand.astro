---
import Button from './Button.astro';
import { site } from '~/config/site';
import { useT, type Lang } from '~/i18n';
import { url } from '~/i18n/routes';

interface Props {
  lang: Lang;
  heading?: string;
  accent?: string;
  text?: string;
}
const { lang, heading, accent, text } = Astro.props;
const t = useT(lang);
const h = heading ?? t.home.cta.heading;
const a = heading ? accent : (accent ?? t.home.cta.headingAccent);
const body = text ?? t.home.cta.text;
---

<section class="cta on-dark" aria-labelledby="cta-title">
  <div class="blueprint" aria-hidden="true"></div>
  <div class="container cta__inner">
    <h2 id="cta-title" class="cta__title" data-reveal>
      {h}
      {a && <span class="cta__accent">{a}</span>}
    </h2>
    <div class="cta__side" data-reveal style="--reveal-delay:2">
      <p class="lead">{body}</p>
      <div class="cta__actions">
        <Button href={url.section(lang, 'contact')} size="lg">{t.common.letsTalk}</Button>
        {
          site.contact.bookingUrl ? (
            <Button href={site.contact.bookingUrl} variant="secondary" size="lg" external>
              {t.common.bookConsultation}
            </Button>
          ) : (
            <Button href={url.section(lang, 'work')} variant="secondary" size="lg">
              {t.common.viewWork}
            </Button>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    padding-block: var(--section);
    overflow: hidden;
    isolation: isolate;
  }
  .cta .blueprint {
    left: 55%;
  }
  .cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    padding: clamp(2rem, 5vw, 4.5rem);
    background: var(--surface-1);
  }
  .cta__title {
    font-size: clamp(2.25rem, 1.5rem + 3vw, 4rem);
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
  }
  .cta__accent {
    display: block;
    color: var(--accent);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  @media (max-width: 899px) {
    .cta__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
