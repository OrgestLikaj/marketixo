---
/** Renders real testimonials only — nothing at all while the list is empty. */
import { testimonials } from '~/data/testimonials';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
  project?: string;
}
const { lang, project } = Astro.props;
const items = testimonials.filter((t) => !project || t.project === project);
---

{
  items.length > 0 && (
    <div class="tm">
      {items.map((item) => (
        <figure class="tm__item" data-reveal>
          <blockquote class="tm__quote">
            <p>{item.quote[lang] ?? item.quote.en}</p>
          </blockquote>
          <figcaption class="tm__by">
            <strong>{item.name}</strong>
            <span>
              {item.role}, {item.company}
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  )
}

<style>
  .tm {
    display: grid;
    gap: 3rem;
  }
  .tm__quote {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem);
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .tm__quote p::before {
    content: '\201C';
    color: var(--golden-orange);
  }
  .tm__quote p::after {
    content: '\201D';
    color: var(--golden-orange);
  }
  .tm__by {
    display: grid;
    margin-top: 1.25rem;
    color: var(--text-muted);
  }
  .tm__by strong {
    color: var(--text);
  }
</style>
