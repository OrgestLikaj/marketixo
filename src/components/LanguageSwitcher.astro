---
/**
 * Flag links (🇬🇧 🇩🇪 🇮🇹 🇦🇱) to the equivalent page in each language. Flags are SVG
 * images (src/assets/flags/) — emoji flags don't render on Windows.
 * Clicking stores the choice in a first-party cookie (mx_lang) so the root URL
 * and future visits open in the same language.
 */
import { languageMeta, locales, useT, type Lang } from '~/i18n';
import { switchTarget, type PageEntry } from '~/lib/pages';
import en from '~/assets/flags/en.svg?url';
import de from '~/assets/flags/de.svg?url';
import it from '~/assets/flags/it.svg?url';
import sq from '~/assets/flags/sq.svg?url';

const flags: Record<Lang, string> = { en, de, it, sq };

interface Props {
  page: Pick<PageEntry, 'lang' | 'alternates' | 'kind'>;
  variant?: 'inline' | 'stacked';
}
const { page, variant = 'inline' } = Astro.props;
const t = useT(page.lang);
const items = locales.map((l: Lang) => ({ lang: l, ...switchTarget(page, l), meta: languageMeta[l] }));
---

<nav class:list={['lang', `lang--${variant}`]} aria-label={t.nav.language}>
  <ul role="list">
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            hreflang={item.meta.hreflang}
            lang={item.lang}
            data-lang={item.lang}
            aria-current={item.lang === page.lang ? 'true' : undefined}
            title={item.meta.native}
          >
            <img class="lang__flag" src={flags[item.lang]} alt="" width="20" height="15" />
            {variant === 'stacked' ? <span class="lang__native">{item.meta.native}</span> : <span class="sr-only">{item.meta.native}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-lang]');
    // Secure only over HTTPS (always the case in production; local previews run on http).
    const secure = location.protocol === 'https:' ? '; Secure' : '';
    if (link) document.cookie = `mx_lang=${link.dataset.lang}; path=/; max-age=31536000; SameSite=Lax${secure}`;
  });
</script>

<style>
  .lang ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lang a {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--text-subtle);
    transition: color var(--dur) var(--ease);
  }
  .lang a:hover,
  .lang a[aria-current] {
    color: var(--text);
  }
  .lang__flag {
    display: block;
    flex: none;
    width: 20px;
    height: 15px;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.18);
    opacity: 0.55;
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .lang a:hover .lang__flag,
  .lang a:focus-visible .lang__flag,
  .lang a[aria-current] .lang__flag {
    opacity: 1;
  }

  /* Inline: a row of flags; the current language is underlined */
  .lang--inline ul {
    gap: 0.15rem;
  }
  .lang--inline a {
    position: relative;
    justify-content: center;
    min-width: 34px;
    min-height: 44px;
  }
  .lang--inline a:hover .lang__flag {
    transform: translateY(-1px);
  }
  .lang--inline a[aria-current]::after {
    content: '';
    position: absolute;
    left: 7px;
    right: 7px;
    bottom: 8px;
    height: 2px;
    border-radius: 1px;
    background: var(--golden-orange);
  }

  /* Stacked: large tap targets for the mobile menu — flag + language name */
  .lang--stacked ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }
  .lang--stacked a {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    min-height: 52px;
  }
  .lang--stacked a[aria-current] {
    border-color: var(--pearl-aqua);
    background: rgb(148 210 189 / 0.06);
  }
  .lang--stacked .lang__flag {
    width: 24px;
    height: 18px;
    opacity: 1;
  }
</style>
