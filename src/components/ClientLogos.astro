---
import { allClients, otherClients, type Client } from '~/data/work';
import { logoFor } from '~/lib/assets';
import type { Lang } from '~/i18n/ui';

/**
 * Client logos.
 * - 'marquee': every client in one slowly scrolling row (home page hero). Pauses on hover and
 *   wraps into a static grid for visitors who prefer reduced motion.
 * - 'wall':    a grid of the clients that don't have their own project card (Work page).
 */
interface Props {
  lang: Lang;
  variant?: 'marquee' | 'wall';
}
const { lang, variant = 'marquee' } = Astro.props;
const list: Client[] = variant === 'wall' ? otherClients : allClients;
const clients = list.map((c) => ({ ...c, src: logoFor(c.key, c.logo) }));
const title = {
  marquee: { en: 'Brands we’ve worked with', de: 'Marken, mit denen wir arbeiten' },
  wall: { en: 'More brands we’ve worked with', de: 'Weitere Marken, mit denen wir arbeiten' },
}[variant][lang];
---

{
  clients.length > 0 && (
    <div class:list={['clients', `clients--${variant}`]}>
      <p class="clients__title">{title}</p>
      {variant === 'marquee' ? (
        <div class="clients__viewport">
          <div class="clients__track">
            {[0, 1].map((copy) => (
              <ul class="clients__row" aria-hidden={copy === 1 ? 'true' : undefined}>
                {clients.map((c) => (
                  <li title={c.client}>
                    {c.src ? (
                      <img src={c.src} alt={copy === 0 ? c.client : ''} loading="lazy" decoding="async" />
                    ) : (
                      <span class="clients__word">{c.client}</span>
                    )}
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      ) : (
        <ul class="clients__wall">
          {clients.map((c) => {
            const inner = c.src ? (
              <img src={c.src} alt={c.client} loading="lazy" decoding="async" />
            ) : (
              <span class="clients__word">{c.client}</span>
            );
            return (
              <li title={c.client}>
                {c.url ? (
                  <a href={c.url} target="_blank" rel="noopener">
                    {inner}
                  </a>
                ) : (
                  inner
                )}
              </li>
            );
          })}
        </ul>
      )}
    </div>
  )
}

<style>
  .clients {
    display: grid;
    gap: 1.5rem;
  }
  .clients__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .clients__word {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    white-space: nowrap;
    color: var(--ink);
  }

  /* Scrolling row */
  .clients__viewport {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }
  .clients__track {
    display: flex;
    width: max-content;
    animation: clients-scroll 60s linear infinite;
  }
  .clients__viewport:hover .clients__track {
    animation-play-state: paused;
  }
  .clients__row {
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4rem);
    padding-right: clamp(2.5rem, 5vw, 4rem);
    list-style: none;
    margin: 0;
  }
  .clients__row li {
    display: flex;
    align-items: center;
    height: 56px;
  }
  .clients__row img {
    height: 44px;
    width: auto;
    max-width: 180px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.65;
    mix-blend-mode: multiply;
    transition:
      filter 0.25s,
      opacity 0.25s;
  }
  .clients__row li:hover img {
    filter: none;
    opacity: 1;
  }
  @keyframes clients-scroll {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .clients__viewport {
      mask-image: none;
    }
    .clients__track {
      width: auto;
      animation: none;
    }
    .clients__row {
      flex-wrap: wrap;
      gap: 1.25rem 2.5rem;
      padding-right: 0;
    }
    .clients__row[aria-hidden] {
      display: none;
    }
  }

  /* Logo wall */
  .clients__wall {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(8px, 1.4vw, 16px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .clients__wall li,
  .clients__wall a {
    display: grid;
    place-items: center;
  }
  .clients__wall li {
    position: relative;
    aspect-ratio: 16 / 9;
    max-width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    transition: border-color 0.2s;
  }
  .clients__wall li:hover {
    border-color: var(--ink);
  }
  .clients__wall a {
    position: absolute;
    inset: 0;
  }
  /* The logo fits a fixed box inside the tile: wide logos fill its width, square ones its height. */
  .clients__wall img {
    position: absolute;
    top: 14%;
    left: 14%;
    width: 72%;
    height: 72%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
</style>
