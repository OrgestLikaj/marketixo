---
/**
 * Client logo wall, grouped by client type (src/assets/clients/<key>.webp; list and groups in
 * src/data/projects.ts → clientLogos / clientGroups).
 * Logos are shown in greyscale and take their own colours on hover; clients with a
 * case study link to it.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { clientGroups, clientLogos } from '~/data/projects';
import { useT, type Lang } from '~/i18n';
import { url } from '~/i18n/routes';

interface Props {
  lang: Lang;
  /** Show the heading row (eyebrow + heading). */
  heading?: boolean;
}
const { lang, heading = true } = Astro.props;
const t = useT(lang);
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/clients/*.{webp,png,svg}', { eager: true });
const logoFor = (key: string) => Object.entries(files).find(([p]) => p.split('/').pop()!.replace(/\.\w+$/, '') === key)?.[1].default;
const items = clientLogos.map((c) => ({ ...c, img: logoFor(c.key) })).filter((c) => c.img);
// Equal visual weight: every logo gets the same area (w × h), whatever its shape, so wide
// wordmarks and square badges look the same size. Capped so very wide/tall marks still fit.
const AREA = 5800;
const MAX_W = 160;
const MAX_H = 76;
const logoWidth = (img: ImageMetadata) => {
  const ratio = img.width / img.height;
  let w = Math.sqrt(AREA * ratio);
  if (w > MAX_W) w = MAX_W;
  if (w / ratio > MAX_H) w = MAX_H * ratio;
  return Math.round(w);
};
const groups = clientGroups
  .map((g) => ({ key: g, label: t.home.clients.groups[g], items: items.filter((c) => c.group === g) }))
  .filter((g) => g.items.length > 0);
---

<section class="cl on-paper" aria-labelledby={heading ? 'clients-title' : undefined} aria-label={heading ? undefined : t.home.clients.eyebrow}>
  <div class="container container--wide">
    {
      heading && (
        <div class="cl__head" data-reveal>
          <p class="eyebrow">{t.home.clients.eyebrow}</p>
          <h2 id="clients-title" class="cl__title">
            {t.home.clients.heading}
          </h2>
        </div>
      )
    }
    <div class="cl__groups">
      {
        groups.map((g) => (
          <div class="cl__group">
            <h3 class="cl__glabel" id={`clients-${g.key}`} data-reveal>
              {g.label}
              <span class="cl__count">{String(g.items.length).padStart(2, '0')}</span>
            </h3>
            <ul class="cl__grid" role="list" aria-labelledby={`clients-${g.key}`}>
              {g.items.map((c, i) => (
                <li
                  class:list={['cl__cell', { 'cl__cell--dark': c.dark }]}
                  data-reveal
                  style={`--reveal-delay:${i % 5};--logo-w:${logoWidth(c.img!)}px`}
                >
                  {c.project ? (
                    <a href={url.project(lang, c.project)} class="cl__link">
                      <Image src={c.img!} alt={c.client} widths={[160, 320]} sizes="160px" class="cl__logo" layout="none" />
                      <span class="cl__more" aria-hidden="true">
                        {t.home.clients.caseStudy} <Icon name="arrow-right" size={12} />
                      </span>
                    </a>
                  ) : (
                    <span class="cl__link cl__link--static">
                      <Image src={c.img!} alt={c.client} widths={[160, 320]} sizes="160px" class="cl__logo" layout="none" />
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cl {
    padding-block: clamp(56px, 7vw, 104px);
  }
  .cl__head {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 1rem 3rem;
    align-items: baseline;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .cl__title {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem);
    letter-spacing: -0.035em;
  }
  .cl__groups {
    display: grid;
    border-top: 1px solid var(--line-strong);
  }
  /* One row per group: label on the left, that group's logos on the right */
  .cl__group {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 1rem 3rem;
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--line-strong);
  }
  .cl__glabel {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    align-self: start;
    padding-top: 0.5rem;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.3125rem);
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .cl__count {
    font-family: var(--font-code);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--dark-teal);
  }
  .cl__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  }
  /* Each cell draws its own border; overlapping by 1px keeps lines single on ragged rows */
  .cl__cell {
    border: 1px solid var(--line);
    margin: 0 -1px -1px 0;
  }
  .cl__cell--dark {
    background: var(--ink-black);
  }
  .cl__cell--dark .cl__more {
    color: var(--pearl-aqua);
  }
  .cl__cell--dark a.cl__link:hover {
    background: var(--surface-2);
  }
  .cl__link {
    position: relative;
    display: grid;
    place-items: center;
    height: clamp(96px, 9vw, 128px);
    padding: 1.25rem 1rem;
    text-decoration: none;
    transition: background-color 400ms var(--ease);
  }
  .cl__logo {
    width: min(var(--logo-w, 140px), 100%);
    height: auto;
    object-fit: contain;
    filter: grayscale(1) contrast(1.1);
    opacity: 0.62;
    transition:
      filter 400ms var(--ease),
      opacity 400ms var(--ease),
      transform 400ms var(--ease);
  }
  .cl__link:focus-visible .cl__logo {
    filter: none;
    opacity: 1;
  }
  /* Desktop (real hover + mouse) only: white tile, logo in colour, slight lift */
  @media (hover: hover) and (pointer: fine) {
    .cl__link:hover {
      background: #fff;
    }
    .cl__link:hover .cl__logo {
      filter: none;
      opacity: 1;
      transform: translateY(-6px);
    }
  }
  .cl__more {
    position: absolute;
    bottom: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-code);
    font-size: 0.6875rem;
    color: var(--dark-teal);
    opacity: 0;
    transform: translateY(4px);
    transition: all 400ms var(--ease);
  }
  .cl__link:focus-visible .cl__more {
    opacity: 1;
    transform: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .cl__link:hover .cl__more {
      opacity: 1;
      transform: none;
    }
  }
  .cl__link:focus-visible {
    outline-offset: -3px;
  }
  /* Touch screens have no hover: show logos in colour. */
  @media (hover: none) {
    .cl__logo {
      filter: none;
      opacity: 0.9;
    }
  }
  @media (max-width: 1023px) {
    .cl__group {
      grid-template-columns: 1fr;
    }
    .cl__glabel {
      justify-content: flex-start;
      padding-top: 0;
    }
  }
  @media (max-width: 767px) {
    .cl__head {
      grid-template-columns: 1fr;
    }
    .cl__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 479px) {
    .cl__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cl__link {
      padding: 1rem;
    }
  }
</style>
