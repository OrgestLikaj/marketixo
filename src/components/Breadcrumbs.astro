---
/** Visible breadcrumb trail. The matching BreadcrumbList JSON-LD is built by the page. */
import { useT, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
  items: { name: string; path: string }[];
  class?: string;
  /** Forwarded attributes (incl. the parent's scoped-style id). */
  [key: string]: unknown;
}
const { lang, items, class: className , ...rest } = Astro.props;
const t = useT(lang);
---

<nav {...rest} class:list={['crumbs', className]} aria-label={t.nav.breadcrumb}>
  <ol role="list">
    {
      items.map((item, i) => (
        <li>
          {i < items.length - 1 ? <a href={item.path}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    font-family: var(--font-code);
    font-size: var(--fs-xs);
    letter-spacing: 0.03em;
    color: var(--text-subtle);
  }
  .crumbs li + li::before {
    content: '/';
    padding-inline: 0.6em;
    opacity: 0.5;
  }
  .crumbs a {
    text-decoration: none;
    color: var(--text-muted);
  }
  .crumbs a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .crumbs [aria-current] {
    color: var(--text);
  }
</style>
