---
import { site } from '~/config/site';
import { navKeys, path, t, type Lang, type RouteKey } from '~/i18n/ui';

interface Props {
  lang: Lang;
  page: RouteKey;
}

const { lang, page } = Astro.props;
const s = t(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div>
        <p class="site-footer__name">{site.name}</p>
        <p class="muted">{s.basedIn}</p>
      </div>
      <ul class="site-footer__links">
        {
          navKeys.map((key) => (
            <li>
              <a class="ul" href={path(key, lang)} aria-current={page === key ? 'page' : undefined}>
                {s.nav[key]}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="site-footer__links">
        <li><a class="ul" href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>
          <a class="ul" href={site.linkedin} rel="me noopener" target="_blank">
            LinkedIn<span class="visually-hidden"> {s.opensNewTab}</span>
          </a>
        </li>
      </ul>
    </div>
    <div class="site-footer__bottom">
      <p>© {year} {site.name}. {s.rights}</p>
      <nav aria-label={s.footerNav}>
        <a class="ul" href={path('imprint', lang)} aria-current={page === 'imprint' ? 'page' : undefined}>{s.nav.imprint}</a>
        <a class="ul" href={path('privacy', lang)} aria-current={page === 'privacy' ? 'page' : undefined}>{s.nav.privacy}</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: calc(var(--section) * 0.6);
    padding-block: 3.5rem 2rem;
    border-top: 1px solid var(--ink);
    font-size: var(--fs-small);
  }

  .site-footer__top {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 720px) {
    .site-footer__top {
      grid-template-columns: 2fr 1fr 1.4fr;
    }
  }

  .site-footer__name {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .site-footer__links {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    align-content: start;
  }

  .site-footer__links a {
    word-break: break-word;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: var(--fs-xs);
  }

  .site-footer__bottom nav {
    display: flex;
    gap: 1.25rem;
  }
</style>
