---
import { site } from '~/config/site';
import { localeMeta, navKeys, path, routes, t, type Lang, type RouteKey } from '~/i18n/ui';

interface Props {
  lang: Lang;
  page: RouteKey;
}

const { lang, page } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'de' ? 'en' : 'de';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="wordmark" href={path('home', lang)} aria-current={page === 'home' ? 'page' : undefined}>
      {site.name}
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="menu-toggle__label" data-open-label={s.menu} data-close-label={s.close}>{s.menu}</span>
      <span class="menu-toggle__icon" aria-hidden="true"><span></span><span></span></span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label={s.mainNav} data-menu>
      <ul class="site-nav__list">
        {
          navKeys.map((key, i) => (
            <li style={`--i:${i}`}>
              <a class="ul" href={path(key, lang)} aria-current={page === key ? 'page' : undefined}>
                {s.nav[key]}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        class="lang-switch"
        href={routes[page][other]}
        hreflang={other}
        lang={localeMeta[other].htmlLang}
        title={s.switchTo}
      >
        <span class="visually-hidden">{s.switchTo}: </span>
        <span aria-hidden="true" class:list={{ active: lang === 'de' }}>DE</span>
        <span aria-hidden="true" class="sep">/</span>
        <span aria-hidden="true" class:list={{ active: lang === 'en' }}>EN</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const label = toggle?.querySelector<HTMLElement>('.menu-toggle__label');
  const setOpen = (open: boolean) => {
    if (!toggle || !label) return;
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('menu-open', open);
    label.textContent = (open ? label.dataset.closeLabel : label.dataset.openLabel) ?? '';
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.documentElement.classList.contains('menu-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
  matchMedia('(min-width: 880px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(10px);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid var(--rule);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    min-height: 72px;
  }

  .wordmark {
    position: relative;
    z-index: 2;
    font-family: var(--serif);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
  .wordmark:hover {
    color: var(--ink);
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 2rem;
  }

  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__list a {
    font-size: var(--fs-small);
    font-weight: 500;
    padding-block: 0.25rem;
  }
  .site-nav__list a[aria-current='page'] {
    color: var(--accent);
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 40px;
    padding-inline: 0.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--muted);
  }
  .lang-switch .active {
    color: var(--ink);
  }
  .lang-switch:hover {
    border-color: var(--ink);
  }
  .lang-switch .sep {
    opacity: 0.5;
  }

  .menu-toggle {
    display: none;
  }

  /* Mobile: with JavaScript the nav becomes a full-screen menu; without it the links simply wrap. */
  @media (max-width: 879px) {
    :global(.js) .menu-toggle {
      position: relative;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 44px;
      padding: 0 0.25rem 0 0.75rem;
      border: 0;
      background: none;
      color: var(--ink);
      font: inherit;
      font-size: var(--fs-small);
      font-weight: 600;
      cursor: pointer;
    }
    .menu-toggle__icon {
      position: relative;
      display: grid;
      gap: 6px;
      width: 22px;
    }
    .menu-toggle__icon span {
      display: block;
      height: 1.5px;
      background: currentColor;
      transition: transform 0.25s var(--ease);
    }
    :global(.menu-open) .menu-toggle__icon span:first-child {
      transform: translateY(3.75px) rotate(45deg);
    }
    :global(.menu-open) .menu-toggle__icon span:last-child {
      transform: translateY(-3.75px) rotate(-45deg);
    }

    :global(.js) .site-nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 2.5rem;
      padding: 96px var(--gutter) 48px;
      background: var(--paper);
      visibility: hidden;
      opacity: 0;
      transition:
        opacity 0.25s var(--ease),
        visibility 0s linear 0.25s;
    }
    :global(.menu-open) .site-nav {
      visibility: visible !important;
      opacity: 1 !important;
      transition: opacity 0.25s var(--ease) !important;
    }
    :global(.menu-open) body {
      overflow: hidden;
    }
    :global(.js) .site-nav__list {
      flex-direction: column;
      gap: 0.5rem;
    }
    :global(.js) .site-nav__list a {
      font-family: var(--serif);
      font-size: 2.25rem;
      font-weight: 500;
    }
    :global(.js) .site-nav__list li {
      opacity: 0;
      transform: translateY(8px);
      transition:
        opacity 0.3s var(--ease),
        transform 0.3s var(--ease);
      transition-delay: calc(var(--i) * 40ms);
    }
    :global(.menu-open) .site-nav__list li {
      opacity: 1;
      transform: none;
    }
    :global(html:not(.js)) .site-nav {
      width: 100%;
      padding-bottom: 0.75rem;
    }
  }
</style>
