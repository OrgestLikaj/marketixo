# Copy to .env and fill in. All PUBLIC_* values end up in the HTML — never put secrets here.
# Server-side secrets (mail credentials, etc.) belong in mx-config.php on the server, see DEPLOYMENT.md.

# Production domain, no trailing slash
PUBLIC_SITE_URL=https://marketixo.com

# true on staging: noindex on every page + robots.txt disallow
NOINDEX=false

# Analytics — only loaded after cookie consent. Leave empty to disable.
PUBLIC_GA4_ID=
PUBLIC_GTM_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_GSC_VERIFICATION=
